+use chematic_ff::{OOP_SP2_TYPES, mmff94_energy::MMFF94_OOP, mmff94_oop};
+
+#[test]
+fn oop_equivalence_precedes_wildcard_for_every_outer_atom_order() {
+    // RDKit 2026.03.6: benzamide-like carbonyl and conjugated iminium CH.
+    for (center, outer, expected) in [(3, [7, 10, 37], 0.116), (3, [2, 5, 54], 0.081)] {
+        let [a, b, c] = outer;
+        for [i, k, l] in [
+            [a, b, c],
+            [a, c, b],
+            [b, a, c],
+            [b, c, a],
+            [c, a, b],
+            [c, b, a],
+        ] {
+            assert_eq!(mmff94_oop(center, i, k, l), Some(expected));
+        }
+    }
+}
+
+#[test]
+fn oop_eligible_centers_include_all_parameterized_types() {
+    let mut expected: Vec<_> = MMFF94_OOP.iter().map(|row| row.1).collect();
+    expected.sort_unstable();
+    expected.dedup();
+    // Current main also retains eligible centers without a table row.
+    // Coverage must include every parameterized center, without dropping those.
+    for center in expected {
+        assert!(
+            OOP_SP2_TYPES.binary_search(&center).is_ok(),
+            "missing center {center}"
+        );
+    }
+    // Pyridine N-oxide and cationic conjugated nitrogen were omitted.
+    assert!(OOP_SP2_TYPES.binary_search(&69).is_ok());
+    assert!(OOP_SP2_TYPES.binary_search(&55).is_ok());
+}
+
+#[test]
+fn unknown_outer_types_cannot_be_hidden_by_a_wildcard_hit() {
+    assert_eq!(mmff94_oop(3, 250, 5, 7), None);
+    // Literal wildcard queries remain available for table inspection.
+    assert_eq!(mmff94_oop(3, 0, 0, 0), Some(0.13));
+}
diff --git a/crates/chematic-ff/tests/mmff94_optimizer_recovery.rs b/crates/chematic-ff/tests/mmff94_optimizer_recovery.rs
new file mode 100644
index 00000000..e5cf6326
--- /dev/null
+++ b/crates/chematic-ff/tests/mmff94_optimizer_recovery.rs
@@ -0,0 +1,47 @@
+use chematic_ff::Mmff94EnergyModel;
+use chematic_ff::mmff94_energy::mmff94_bond_energy;
+
+#[test]
+fn constrained_recovery_on_a_near_equilibrium_bond_preserves_energy_descent() {
+    let mol = chematic_smiles::parse("CC").unwrap();
+    let model = Mmff94EnergyModel::new(&mol).unwrap();
+    let r0 = mmff94_bond_energy(0, 1, 1).unwrap().r0;
+    let initial = vec![[0.0, 0.0, 0.0], [r0 + 1e-6, 0.0, 0.0]];
+    let gradient = model.bounded_analytic_gradient(&initial);
+    let direction: Vec<[f64; 3]> = gradient.iter().map(|g| [-g[0], -g[1], -g[2]]).collect();
+    // Exclude every trial on the initial quasi-Newton line search, forcing
+    // the public optimizer to use its distinct recovery step. This models
+    // a caller geometry boundary, without exposing optimizer internals.
+    let mut excluded = Vec::new();
+    let mut alpha = 1.0;
+    for _ in 0..40 {
+        let trial: Vec<[f64; 3]> = initial
+            .iter()
+            .zip(&direction)
+            .map(|(c, p)| {
+                [
+                    c[0] + alpha * p[0],
+                    c[1] + alpha * p[1],
+                    c[2] + alpha * p[2],
+                ]
+            })
+            .collect();
+        excluded.push(trial);
+        alpha *= 0.5;
+    }
+    let accept =
+        |candidate: &[[f64; 3]]| !excluded.iter().any(|point| point.as_slice() == candidate);
+    let before = model.energy(&initial);
+    let mut coords = initial.clone();
+    let result = model
+        .minimize_lbfgs_bounded_analytic_with_constraint(&mut coords, 1, accept)
+        .unwrap();
+    assert_ne!(coords, initial, "an admissible recovery step exists");
+    assert!(accept(&coords));
+    assert!(
+        result.energy < before,
+        "recovery must descend: {before} -> {}",
+        result.energy
+    );
+    assert_eq!(result.energy, model.energy(&coords));
+}
