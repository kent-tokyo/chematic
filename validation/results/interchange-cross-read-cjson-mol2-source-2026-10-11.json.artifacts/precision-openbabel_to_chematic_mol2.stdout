{"schema":"chematic.conversion-report.v1","input_format":"cjson","output_format":"mol2","policy":"allow_loss","status":"completed_with_loss","source_record_index":0,"verification_scope":"candidate_elements_aromaticity_formal_charges_isotopes_bond_orders_coordinates_emitted_metadata","candidate_graph_verified":true,"output":"@<TRIPOS>MOLECULE\nacetamide\n4 3 0 0 0\nSMALL\nUSER_CHARGES\n\n@<TRIPOS>ATOM\n1 C1 -1.4175225513503917 -0 0.0000000123456789 C 1 LIG 0.7\n2 C2 1.5 0 0 C 1 LIG 0.25\n3 O3 2 1.2 0 O 1 LIG -0.7\n4 N4 2 -1.2 0 N 1 LIG -0.25\n@<TRIPOS>BOND\n1 1 2 1\n2 2 3 2\n3 2 4 1\n","observations":[{"field":"source_text","status":"dropped","stage":"write","reason":"CJSON layout, version declaration and array representation are not emitted in MOL2."},{"field":"opaque_fields","status":"dropped","stage":"projection","reason":"Unknown CJSON fields are omitted from MOL2; opaque references and chemistry are not interpreted."},{"field":"mol2_metadata","status":"inferred","stage":"write","reason":"MOL2 uses generated sequential IDs, element-based atom names/types and SMALL molecule type; charged columns use placeholder substructure 1 LIG. Hybridization and force-field typing are not perceived."},{"field":"stereochemistry","status":"unverified","stage":"projection","reason":"Coordinate-derived and opaque extension stereochemistry are not interpreted or verified."},{"field":"isotope_defaults","status":"inferred","stage":"projection","reason":"Absent CJSON isotopes default to unspecified isotope in the local graph projection."},{"field":"projected_graph","status":"preserved","stage":"candidate_verification","reason":"Candidate MOL2 reparsed; verification requires mapped counts, elements, aromatic flags, formal charges, isotopes and bond orders. Failed graph verification exposes no correspondence; source IDs are CJSON zero-based array indices."},{"field":"coordinates","status":"preserved","stage":"candidate_verification","reason":"Reparsed coordinates must agree bit for bit through verified atom correspondence, including signed zero and subnormals; original decimal spelling is outside this check."},{"field":"molecule_name","status":"preserved","stage":"candidate_verification","reason":"Reparsed MOL2 molecule name equals source properties.name verbatim; no trimming or placeholder substitution."},{"field":"partial_charges","status":"preserved","stage":"candidate_verification","reason":"Complete source partial charges must reparse bit for bit through verified atom correspondence. No calculation, rounding into formal charges or filling missing values."},{"field":"charge_method","status":"preserved","stage":"candidate_verification","reason":"Source dataset method label equals the reparsed MOL2 charge-method token; the declared method is not recomputed or independently validated."}],"candidate_atom_mapping":[{"source_id":0,"source_index":0,"candidate_index":0},{"source_id":1,"source_index":1,"candidate_index":1},{"source_id":2,"source_index":2,"candidate_index":2},{"source_id":3,"source_index":3,"candidate_index":3}],"candidate_bond_mapping":[{"source_id":0,"source_index":0,"candidate_index":0},{"source_id":1,"source_index":1,"candidate_index":1},{"source_id":2,"source_index":2,"candidate_index":2}]}
