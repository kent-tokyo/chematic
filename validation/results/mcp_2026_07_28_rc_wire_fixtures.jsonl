{"era": "legacy", "label": "legacy tools/list (20 tools, no cache envelope)", "request_raw": "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/list\",\"params\":{}}", "response": {"id": 2, "jsonrpc": "2.0", "result": {"tools": [{"description": "Parse a SMILES string and return basic molecular information (atom count, bond count, molecular weight).", "inputSchema": {"additionalProperties": false, "properties": {"smiles": {"description": "SMILES string to parse", "maxLength": 100000, "minLength": 1, "type": "string"}}, "required": ["smiles"], "type": "object"}, "name": "parse_smiles", "outputSchema": {"additionalProperties": false, "properties": {"atoms": {"minimum": 0, "type": "integer"}, "bonds": {"minimum": 0, "type": "integer"}, "mol_weight": {"minimum": 0, "type": "number"}, "smiles": {"type": "string"}, "valid": {"type": "boolean"}}, "required": ["valid", "atoms", "bonds", "mol_weight", "smiles"], "type": "object"}}, {"description": "Calculate molecular properties: MW, exact mass, LogP (Crippen), TPSA, HBD, HBA, rotatable bonds, heavy atom count, and QED drug-likeness.", "inputSchema": {"additionalProperties": false, "properties": {"smiles": {"description": "SMILES string", "maxLength": 100000, "minLength": 1, "type": "string"}}, "required": ["smiles"], "type": "object"}, "name": "calc_properties", "outputSchema": {"additionalProperties": false, "properties": {"exact_mass": {"minimum": 0, "type": "number"}, "hba": {"minimum": 0, "type": "integer"}, "hbd": {"minimum": 0, "type": "integer"}, "heavy_atom_count": {"minimum": 0, "type": "integer"}, "logp": {"type": "number"}, "mw": {"minimum": 0, "type": "number"}, "qed": {"maximum": 1, "minimum": 0, "type": "number"}, "rotatable_bonds": {"minimum": 0, "type": "integer"}, "tpsa": {"minimum": 0, "type": "number"}}, "required": ["mw", "exact_mass", "logp", "tpsa", "hbd", "hba", "rotatable_bonds", "heavy_atom_count", "qed"], "type": "object"}}, {"description": "Compute the ECFP4 (Morgan radius-2) circular fingerprint as a 2048-bit hex string, plus popcount.", "inputSchema": {"additionalProperties": false, "properties": {"smiles": {"description": "SMILES string", "maxLength": 100000, "minLength": 1, "type": "string"}}, "required": ["smiles"], "type": "object"}, "name": "ecfp4", "outputSchema": {"additionalProperties": false, "properties": {"fingerprint": {"description": "512-char lowercase hex string (256 bytes = 2048 bits)", "maxLength": 512, "minLength": 512, "type": "string"}, "popcount": {"maximum": 2048, "minimum": 0, "type": "integer"}}, "required": ["fingerprint", "popcount"], "type": "object"}}, {"description": "Compute the Tanimoto (Jaccard) similarity between two molecules using ECFP4 fingerprints.", "inputSchema": {"additionalProperties": false, "properties": {"smiles1": {"description": "First molecule SMILES", "maxLength": 100000, "minLength": 1, "type": "string"}, "smiles2": {"description": "Second molecule SMILES", "maxLength": 100000, "minLength": 1, "type": "string"}}, "required": ["smiles1", "smiles2"], "type": "object"}, "name": "tanimoto", "outputSchema": {"additionalProperties": false, "properties": {"similarity": {"maximum": 1, "minimum": 0, "type": "number"}, "similarity_percent": {"maximum": 100, "minimum": 0, "type": "number"}}, "required": ["similarity", "similarity_percent"], "type": "object"}}, {"description": "Perform SMARTS substructure search and return whether the pattern matches, match count, and atom index maps.", "inputSchema": {"additionalProperties": false, "properties": {"smarts": {"description": "SMARTS pattern", "maxLength": 100000, "minLength": 1, "type": "string"}, "smiles": {"description": "Molecule SMILES to search in", "maxLength": 100000, "minLength": 1, "type": "string"}}, "required": ["smarts", "smiles"], "type": "object"}, "name": "smarts_match", "outputSchema": {"additionalProperties": false, "properties": {"atom_maps": {"items": {"items": {"minimum": 0, "type": "integer"}, "type": "array"}, "type": "array"}, "match_count": {"minimum": 0, "type": "integer"}, "matches": {"type": "boolean"}}, "required": ["matches", "match_count", "atom_maps"], "type": "object"}}, {"description": "Return the canonical SMILES representation of a molecule.", "inputSchema": {"additionalProperties": false, "properties": {"smiles": {"description": "Input SMILES string", "maxLength": 100000, "minLength": 1, "type": "string"}}, "required": ["smiles"], "type": "object"}, "name": "canonical_smiles", "outputSchema": {"additionalProperties": false, "properties": {"canonical": {"type": "string"}}, "required": ["canonical"], "type": "object"}}, {"description": "Find the maximum common substructure (MCS) across a list of molecules. Returns the MCS as a canonical SMILES string.", "inputSchema": {"additionalProperties": false, "properties": {"smiles_list": {"description": "List of SMILES strings (2–20 molecules)", "items": {"maxLength": 100000, "minLength": 1, "type": "string"}, "maxItems": 20, "minItems": 2, "type": "array"}}, "required": ["smiles_list"], "type": "object"}, "name": "find_mcs", "outputSchema": {"additionalProperties": false, "properties": {"atom_count": {"minimum": 0, "type": "integer"}, "bond_count": {"minimum": 0, "type": "integer"}, "mcs": {"type": ["string", "null"]}}, "required": ["mcs", "atom_count", "bond_count"], "type": "object"}}, {"description": "Generate 3D coordinates for a molecule using rule-based placement and DREIDING force-field minimization. Returns XYZ format.", "inputSchema": {"additionalProperties": false, "properties": {"smiles": {"description": "SMILES string", "maxLength": 100000, "minLength": 1, "type": "string"}}, "required": ["smiles"], "type": "object"}, "name": "generate_3d", "outputSchema": {"additionalProperties": false, "properties": {"atom_count": {"minimum": 0, "type": "integer"}, "xyz": {"type": "string"}}, "required": ["xyz", "atom_count"], "type": "object"}}, {"description": "Check whether a molecule contains Pan-Assay Interference Compounds (PAINS) structural alerts. PAINS compounds often produce false positives in high-throughput screening.", "inputSchema": {"additionalProperties": false, "properties": {"smiles": {"description": "SMILES string", "maxLength": 100000, "minLength": 1, "type": "string"}}, "required": ["smiles"], "type": "object"}, "name": "pains_check", "outputSchema": {"additionalProperties": false, "properties": {"alert_count": {"minimum": 0, "type": "integer"}, "alerts": {"items": {"type": "string"}, "type": "array"}, "passes": {"type": "boolean"}}, "required": ["passes", "alert_count", "alerts"], "type": "object"}}, {"description": "Check whether a molecule contains Brenk structural alerts (unwanted functional groups associated with toxicity, metabolic instability, or undesirable reactivity).", "inputSchema": {"additionalProperties": false, "properties": {"smiles": {"description": "SMILES string", "maxLength": 100000, "minLength": 1, "type": "string"}}, "required": ["smiles"], "type": "object"}, "name": "brenk_check", "outputSchema": {"additionalProperties": false, "properties": {"alert_count": {"minimum": 0, "type": "integer"}, "alerts": {"items": {"type": "string"}, "type": "array"}, "passes": {"type": "boolean"}}, "required": ["passes", "alert_count", "alerts"], "type": "object"}}, {"description": "Estimate synthetic accessibility (SA Score, Ertl & Schuffenhauer 2009). Returns a score from 1 (easy to synthesize) to 10 (very difficult). Drug-like molecules typically score 2–4.", "inputSchema": {"additionalProperties": false, "properties": {"smiles": {"description": "SMILES string", "maxLength": 100000, "minLength": 1, "type": "string"}}, "required": ["smiles"], "type": "object"}, "name": "sa_score", "outputSchema": {"additionalProperties": false, "properties": {"easy_to_synthesize": {"type": "boolean"}, "note": {"type": "string"}, "sa_score": {"maximum": 10, "minimum": 1, "type": "number"}}, "required": ["sa_score", "easy_to_synthesize", "note"], "type": "object"}}, {"description": "Compute a full ADMET (Absorption