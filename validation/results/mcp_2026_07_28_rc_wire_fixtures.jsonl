erties": {"bbb_penetrant": {"type": "boolean"}, "gi_absorbed": {"type": "boolean"}, "logp": {"type": "number"}, "method": {"type": "string"}, "thresholds": {"additionalProperties": false, "properties": {"bbb_yolk": {"type": "string"}, "gi_white": {"type": "string"}}, "required": ["gi_white", "bbb_yolk"], "type": "object"}, "tpsa": {"minimum": 0, "type": "number"}}, "required": ["gi_absorbed", "bbb_penetrant", "logp", "tpsa", "method", "thresholds"], "type": "object"}}, {"description": "Check Lipinski's Rule of Five for oral drug-likeness (MW ≤ 500, LogP ≤ 5, HBD ≤ 5, HBA ≤ 10). Returns whether the molecule passes and individual property values.", "inputSchema": {"additionalProperties": false, "properties": {"smiles": {"description": "SMILES string", "maxLength": 100000, "minLength": 1, "type": "string"}}, "required": ["smiles"], "type": "object"}, "name": "lipinski_check", "outputSchema": {"additionalProperties": false, "properties": {"hba": {"minimum": 0, "type": "integer"}, "hbd": {"minimum": 0, "type": "integer"}, "logp": {"type": "number"}, "mw": {"minimum": 0, "type": "number"}, "passes": {"type": "boolean"}, "rules": {"additionalProperties": false, "properties": {"hba_le_10": {"type": "boolean"}, "hbd_le_5": {"type": "boolean"}, "logp_le_5": {"type": "boolean"}, "mw_le_500": {"type": "boolean"}}, "required": ["mw_le_500", "logp_le_5", "hbd_le_5", "hba_le_10"], "type": "object"}}, "required": ["passes", "mw", "logp", "hbd", "hba", "rules"], "type": "object"}}, {"description": "Convert a chemical name (IUPAC, trivial, or trade name) to an isomeric SMILES string via the PubChem REST API. Requires internet access. Examples: 'aspirin', 'caffeine', 'ibuprofen', '2-propanol'.", "inputSchema": {"additionalProperties": false, "properties": {"name": {"description": "Chemical name (IUPAC, common, or trade name)", "maxLength": 500, "minLength": 1, "type": "string"}}, "required": ["name"], "type": "object"}, "name": "name_to_smiles", "outputSchema": {"additionalProperties": false, "properties": {"name": {"type": "string"}, "smiles": {"type": "string"}, "source": {"type": "string"}}, "required": ["name", "smiles", "source"], "type": "object"}}, {"description": "One-step retrosynthetic disconnection via BRICS (Breaking of Retrosynthetically Interesting Chemical Substructures, Dien 2008). Identifies all BRICS-breakable bonds, cuts each one individually, and returns the resulting fragment pairs ranked by their maximum SA Score (1=easy to synthesize, 10=hard). Lower max-SA means both building blocks are easier to make. Useful for identifying practical synthetic disconnections for drug-like molecules.", "inputSchema": {"additionalProperties": false, "properties": {"smiles": {"description": "SMILES string of the target molecule", "maxLength": 100000, "minLength": 1, "type": "string"}}, "required": ["smiles"], "type": "object"}, "name": "retrosynthesis", "outputSchema": {"additionalProperties": false, "properties": {"disconnections": {"items": {"additionalProperties": false, "properties": {"fragment_sa_scores": {"items": {"type": "number"}, "maxItems": 2, "minItems": 2, "type": "array"}, "fragments": {"items": {"type": "string"}, "maxItems": 2, "minItems": 2, "type": "array"}, "max_fragment_sa": {"type": "number"}}, "required": ["fragments", "fragment_sa_scores", "max_fragment_sa"], "type": "object"}, "type": "array"}, "note": {"type": "string"}, "target": {"type": "string"}, "target_sa_score": {"type": "number"}, "total_brics_bonds": {"minimum": 0, "type": "integer"}}, "required": ["target", "target_sa_score", "disconnections", "total_brics_bonds", "note"], "type": "object"}}, {"description": "Convert a SMILES string to MolJSON — a JSON-based molecular representation designed for LLM compatibility. MolJSON makes atoms, bonds, and connectivity explicit without domain-specific parsing rules.", "inputSchema": {"additionalProperties": false, "properties": {"smiles": {"description": "SMILES string to convert", "maxLength": 100000, "minLength": 1, "type": "string"}}, "required": ["smiles"], "type": "object"}, "name": "smiles_to_moljson", "outputSchema": {"description": "MolJSON, serialized as a JSON string (the tool's own output IS a JSON document, so the MCP structuredContent value is a string containing it, not an already-parsed object).", "type": "string"}}, {"description": "Convert a MolJSON string to canonical SMILES.", "inputSchema": {"additionalProperties": false, "properties": {"json": {"description": "MolJSON string to convert", "maxLength": 1000000, "minLength": 1, "type": "string"}}, "required": ["json"], "type": "object"}, "name": "moljson_to_smiles", "outputSchema": {"additionalProperties": false, "properties": {"canonical_smiles": {"type": "string"}}, "required": ["canonical_smiles"], "type": "object"}}, {"description": "Convert SMILES to the best molecular text representation for an LLM task. Based on arXiv 2026: CML/MolJSON outperform SMILES on structural reasoning; InChI is best for identification.", "inputSchema": {"additionalProperties": false, "properties": {"smiles": {"description": "SMILES string", "maxLength": 100000, "minLength": 1, "type": "string"}, "task": {"description": "LLM task type — omit to use default (canonical_smiles)", "enum": ["structural_reasoning", "shortest_path", "identification", "property_prediction", "generation", "editing", "default"], "type": "string"}}, "required": ["smiles"], "type": "object"}, "name": "representation_router", "outputSchema": {"additionalProperties": false, "properties": {"format": {"enum": ["moljson", "inchi", "cml", "canonical_smiles"], "type": "string"}, "representation": {"type": "string"}, "task": {"type": "string"}}, "required": ["task", "format", "representation"], "type": "object"}}, {"description": "Assemble a rich molecular context for LLM/RAG use. Returns identifiers, physicochemical properties, drug-likeness flags, ADMET profile, structural alerts, and MolJSON representation in a single JSON object.", "inputSchema": {"additionalProperties": false, "properties": {"format": {"description": "Output format: json (default), markdown (for LLM prompts), prompt (compact one-liner)", "enum": ["json", "markdown", "prompt"], "type": "string"}, "smiles": {"description": "SMILES string", "maxLength": 100000, "minLength": 1, "type": "string"}}, "required": ["smiles"], "type": "object"}, "name": "molecule_context_pack", "outputSchema": {"description": "Shape depends on the `format` argument: `markdown`/`prompt` return a short text summary; the default `json` format returns the full structured context object.", "oneOf": [{"additionalProperties": false, "properties": {"context": {"type": "string"}, "format": {"const": "markdown"}}, "required": ["format", "context"], "type": "object"}, {"additionalProperties": false, "properties": {"context": {"type": "string"}, "format": {"const": "prompt"}}, "required": ["format", "context"], "type": "object"}, {"additionalProperties": false, "properties": {"drug_likeness": {"additionalProperties": false, "properties": {"brenk_alerts": {"items": {"type": "string"}, "type": "array"}, "brenk_passes": {"type": "boolean"}, "lipinski_passes": {"type": "boolean"}, "pains_alerts": {"items": {"type": "string"}, "type": "array"}, "pains_passes": {"type": "boolean"}}, "required": ["lipinski_passes", "pains_passes", "brenk_passes", "pains_alerts", "brenk_alerts"], "type": "object"}, "identifiers": {"additionalProperties": false, "properties": {"exact_mass": {"type": "number"}, "inchi": {"type": "string"}, "mw": {"type": "number"}, "smiles": {"type": "string"}}, "required": ["smiles", "inchi", "mw", "exact_mass"], "type": "object"}, "properties": {"additionalProperties": false, "properties": {"hba": {"type": "integer"}, "hbd": {"type": "integer"}, "heavy_atoms": {"type": "integer"}, "logp": {"type": "number"}, "qed": {"type": "number"}, "rotatable_bonds": {"type": "integer"}, "sa_score": {"type": "number"}, "tpsa": {"type": "number"}}, "required": ["logp", "tpsa", "hbd", "hba", "rotata