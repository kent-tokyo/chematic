  </bondArray>
</molecule>
<molecule xmlns="http://www.xml-cml.org/schema" id="m2">
  <atomArray>
    <atom id="a1" elementType="N" formalCharge="1" hydrogenCount="4"/>
  </atomArray>
  <bondArray>
  </bondArray>
</molecule>
<molecule xmlns="http://www.xml-cml.org/schema" id="m3">
