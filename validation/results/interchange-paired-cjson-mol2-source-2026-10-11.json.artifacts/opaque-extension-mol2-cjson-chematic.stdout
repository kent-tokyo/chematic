{"schema":"chematic.conversion-report.v1","input_format":"mol2","output_format":"cjson","policy":"allow_loss","status":"completed_with_loss","source_record_index":0,"verification_scope":"candidate_elements_aromaticity_projected_charges_bond_orders_coordinates_emitted_metadata","candidate_graph_verified":true,"output":"{\"atoms\":{\"coords\":{\"3d\":[0.123456789,0.0,0.0,1.5,0.0,0.0,2.0,1.2,0.0,2.0,-1.2,0.0]},\"elements\":{\"number\":[6,6,8,7]}},\"bonds\":{\"connections\":{\"index\":[0,1,1,2,1,3]},\"order\":[1,2,1]},\"chemicalJson\":1,\"partialCharges\":{\"USER_CHARGES\":[0.7,0.25,-0.7,-0.25]},\"properties\":{\"name\":\"acetamide\"}}","observations":[{"field":"source_text","status":"dropped","stage":"write","reason":"Candidate output omits MOL2 layout, comments, header flags and any unparsed optional columns."},{"field":"molecule_metadata","status":"dropped","stage":"write","reason":"Molecule type and other header flags are not emitted. Parsed name and any complete declared partial-charge dataset are checked separately."},{"field":"atom_identity","status":"dropped","stage":"write","reason":"Source atom IDs and names are omitted; candidate correspondence is reported separately."},{"field":"atom_types","status":"dropped","stage":"projection","reason":"Source MOL2 atom types are reduced to the bounded graph projection; the original typing model is not emitted."},{"field":"substructures","status":"dropped","stage":"projection","reason":"Source atom substructure ownership and names are not emitted."},{"field":"opaque_sections","status":"dropped","stage":"projection","reason":"Additional MOL2 sections are not interpreted and are not emitted."},{"field":"bond_records","status":"dropped","stage":"projection","reason":"Source bond IDs and MOL2 tokens such as am, du and nc are not retained as source metadata."},{"field":"formal_charge_interpretation","status":"unverified","stage":"projection","reason":"Only N.4 implies +1; other atom-type and extension formal-charge rules are not interpreted. Preserving the projected charge is not verification of source chemistry."},{"field":"stereochemistry","status":"unverified","stage":"projection","reason":"Coordinate-derived and extension stereochemistry are not interpreted or verified."},{"field":"projected_graph","status":"preserved","stage":"candidate_verification","reason":"Candidate output reparsed; explicit atom counts, mapped elements/aromaticity/projected formal charges and mapped bond orders agree. Source chemical interpretation and inferred hydrogens are outside this check."},{"field":"coordinates","status":"preserved","stage":"candidate_verification","reason":"Reparsed candidate coordinates agree bit for bit with source f64 x/y/z values through verified atom correspondence, including signed zero. Original decimal spelling and physical dimensionality are outside this check."},{"field":"molecule_name","status":"preserved","stage":"candidate_verification","reason":"Reparsed properties.name equals the parsed (trimmed) source molecule name; original header whitespace is accounted for by source_text loss."},{"field":"partial_charges","status":"preserved","stage":"candidate_verification","reason":"Partial-charge preservation requires complete source values, reparsed bitwise equality and verified atom correspondence; no rounding into formal charges or filling missing values."},{"field":"charge_method","status":"preserved","stage":"candidate_verification","reason":"Source charge-method label retained verbatim as the partialCharges dataset key; the declared method is not recomputed or independently validated."},{"field":"projected_formal_charges","status":"preserved","stage":"candidate_verification","reason":"CJSON formal charges are checked as part of mapped graph verification. This does not validate MOL2 charge interpretation beyond N.4; partial-charge preservation is checked separately."}],"candidate_atom_mapping":[{"source_id":1,"source_index":0,"candidate_index":0},{"source_id":2,"source_index":1,"candidate_index":1},{"source_id":3,"source_index":2,"candidate_index":2},{"source_id":4,"source_index":3,"candidate_index":3}],"candidate_bond_mapping":[{"source_id":1,"source_index":0,"candidate_index":0},{"source_id":2,"source_index":1,"candidate_index":1},{"source_id":3,"source_index":2,"candidate_index":2}]}
