+    before=m.smiles
+    with pytest.raises(ValueError,match="stereo group 0"):
+        m.enumerate_stereo_group_alternatives()
+    assert m.smiles==before
+
+
+def test_symmetry_equivalent_masks_are_not_collapsed():
