+++ b/crates/chematic-fp/src/rdkit_layered/config/validation.rs
@@ -0,0 +1,118 @@
+use super::*;
+pub(super) fn validate(mol: &Molecule, c: &RdkitLayeredConfig) -> Result<(), RdkitLayeredError> {
+    if mol.atom_count() > 512 || mol.bond_count() > 1024 {
+        return Err(error("graph_limit", "maximum 512 atoms and 1024 bonds"));
+    }
+    if c.min_path == 0 || c.min_path > c.max_path || c.max_path > 12 {
+        return Err(error(
+            "path_range",
+            "require 1 <= min_path <= max_path <= 12",
+        ));
+    }
+    if c.fp_size == 0 || c.fp_size > 65536 {
+        return Err(error("fp_size", "fp_size must be 1..=65536"));
+    }
+    if c.max_visits == 0 || c.max_visits > 10_000_000 || c.max_paths == 0 || c.max_paths > 1_000_000
+    {
+        return Err(error("resource_limit", "invalid visits/path cap"));
+    }
+    if c.from_atoms.len() > 4096
+        || c.from_atoms
+            .iter()
+            .any(|a| a.0 as usize >= mol.atom_count())
+    {
+        return Err(error("root_index", "invalid root list or atom index"));
+    }
+    // RDKit 2026.09.1's unrooted linear branch passes atom paths as bond indices;
+    // the public wheel segfaults on CC/CCO. Never reproduce that invalid access.
+    if !c.branched_paths && c.from_atoms.is_empty() {
+        return Err(error(
+            "unrooted_linear_unsupported",
+            "branched_paths=false requires explicit from_atoms",
+        ));
+    }
+    if let Some(counts) = &c.atom_counts
+        && (counts.len() < mol.atom_count() || counts.len() > 65536)
+    {
+        return Err(error(
+            "atom_counts",
+            "counter list must cover atoms and contain <=65536 entries",
+        ));
+    }
+    validate_mask(c)?;
+    let mut edges = std::collections::BTreeSet::new();
+    for (_, b) in mol.bonds() {
+        if b.atom1 == b.atom2 || !edges.insert((b.atom1.min(b.atom2), b.atom1.max(b.atom2))) {
+            return Err(error(
+                "unsupported_graph",
+                "loops and parallel edges are unsupported",
+            ));
+        }
+        if !matches!(
+            b.order,
+            BondOrder::Single
+                | BondOrder::Up
+                | BondOrder::Down
+                | BondOrder::Double
+                | BondOrder::Triple
+                | BondOrder::Quadruple
+                | BondOrder::Aromatic
+        ) {
+            return Err(error(
+                "unsupported_bond",
+                "query, zero and dative bonds are unsupported",
+            ));
+        }
+    }
+    Ok(())
+}
+pub(super) fn same_indices(source: &Molecule, view: &Molecule) -> Result<(), RdkitLayeredError> {
+    let same = source.atom_count() == view.atom_count()
+        && source.bond_count() == view.bond_count()
+        && source.atoms().zip(view.atoms()).all(|((_, a), (_, b))| {
+            a.element == b.element && a.isotope == b.isotope && a.wildcard == b.wildcard
+        })
+        && source
+            .bonds()
+            .zip(view.bonds())
+            .all(|((_, a), (_, b))| a.atom1 == b.atom1 && a.atom2 == b.atom2);
+    if !same {
+        return Err(error(
+            "index_changing_view",
+            "sanitized view changes atom/bond correspondence",
+        ));
+    }
+    // A sanitization hook may introduce unsupported bond types.
+    if view.bonds().any(|(_, b)| {
+        matches!(
+            b.order,
+            BondOrder::Dative
+                | BondOrder::Zero
+                | BondOrder::QueryAny
+                | BondOrder::QuerySingleOrDouble
+                | BondOrder::QuerySingleOrAromatic
+                | BondOrder::QueryDoubleOrAromatic
+        )
+    }) {
+        return Err(error(
+            "unsupported_bond",
+            "sanitized view introduces unsupported bonds",
+        ));
+    }
+    Ok(())
+}
+
+fn validate_mask(c: &RdkitLayeredConfig) -> Result<(), RdkitLayeredError> {
+    if let Some(mask) = &c.set_only_bits {
+        if mask.len() != c.fp_size.div_ceil(8) {
+            return Err(error(
+                "mask_size",
+                "packed mask length does not match fp_size",
+            ));
+        }
+        if !c.fp_size.is_multiple_of(8) && mask.last().is_some_and(|v| *v >> (c.fp_size % 8) != 0) {
+            return Err(error("mask_padding", "unused high mask bits must be zero"));
+        }
+    }
+    Ok(())
+}
diff --git a/crates/chematic-fp/src/rdkit_layered/features.rs b/crates/chematic-fp/src/rdkit_layered/features.rs
new file mode 100644
index 0000000..7419abd
--- /dev/null
+++ b/crates/chematic-fp/src/rdkit_layered/features.rs
@@ -0,0 +1,136 @@
+//! Shared feature hashing, retaining the existing six-layer bit contract.
+use super::*;
+
+pub(super) struct Prepared<'a> {
+    mol: &'a Molecule,
+    aromaticity: Option<AromaticityModel>,
+    anums: Vec<u32>,
+    atom_aromatic: Vec<bool>,
+    ring_info: RingInfo,
+}
+pub(super) struct Hashes {
+    pub seeds: [Option<u32>; NUM_LAYERS],
+    pub atoms: Vec<usize>,
+}
+impl<'a> Prepared<'a> {
+    pub fn new(mol: &'a Molecule, trust_view: bool) -> Self {
+        let has_literal_aromatic_bond =
+            trust_view || mol.bonds().any(|(_, b)| b.order == BondOrder::Aromatic);
+        let aromaticity = if has_literal_aromatic_bond {
+            None
+        } else {
+            Some(assign_aromaticity_ex(mol, AromaticityAlgorithm::RdkitLike))
+        };
+        let anums = (0..mol.atom_count())
+            .map(|i| crate::rdkit_atomic_num(mol, AtomIdx(i as u32)))
+            .collect();
+        let atom_aromatic = (0..mol.atom_count())
+            .map(|i| is_atom_aromatic(mol, aromaticity.as_ref(), AtomIdx(i as u32)))
+            .collect();
+        Self {
+            mol,
+            aromaticity,
+            anums,
+            atom_aromatic,
+            ring_info: compute_ring_info(mol),
+        }
+    }
+    pub fn hashes(&self, path: &[u32]) -> Hashes {
+        let (degrees, atoms, bond_nbrs) = path_info(self.mol, path);
+        let mut layers: [Vec<u32>; NUM_LAYERS] = Default::default();
+        for (i, &bidx) in path.iter().enumerate() {
+            let bond = self.mol.bond(BondIdx(bidx));
+            let a = bond.atom1.0;
+            let b = bond.atom2.0;
+            let d1 = degrees[&a];
+            let d2 = degrees[&b];
+            let n = bond_nbrs[i];
+            layers[0].push(topology(d1, d2, n));
+            let code = if is_bond_aromatic(self.mol, self.aromaticity.as_ref(), BondIdx(bidx)) {
+                1
+            } else {
+                layer2_bond_type_code(bond.order)
+            };
+            layers[1].push(bond_type(d1, d2, n, code));
+            layers[2].push(atom_type(
+                self.anums[a as usize],
+                self.anums[b as usize],
+                d1,
+                d2,
+                n,
+            ));
+            if self.ring_info.bond_in_ring[bidx as usize] {
+                layers[3].push(1);
+            }
+            layers[4].push(self.ring_info.bond_min_ring_size[bidx as usize] % 8);
+            layers[5].push(aromaticity(
+                self.atom_aromatic[a as usize],
+                self.atom_aromatic[b as usize],
+                n,
+            ));
+        }
+        let mut seeds = [None; NUM_LAYERS];
+        for (i, layer) in layers.iter_mut().enumerate() {
+            if layer.is_empty() {
+                continue;
+            }
+            layer.sort_unstable();
+            layer.push(atoms.len() as u32);
+            layer.push((i + 1) as u32);
+            seeds[i] = Some(layer.iter().fold(0, |h, &v| hash_combine(h, v)));
+        }
+        Hashes { seeds, atoms }
+    }
+}
+type PathInfo = (FxHashMap<u32, u32>, Vec<usize>, Vec<u32>);
+fn path_info(mol: &Molecule, path: &[u32]) -> PathInfo {
+    let mut degrees = FxHashMap::default();
+    let mut atoms = std::collections::BTreeSet::new();
+    for &idx in path {
+        let b = mol.bond(BondIdx(idx));
+        *degrees.entry(b.atom1.0).or_insert(0) += 1;
+        *degrees.entry(b.atom2.0).or_insert(0) += 1;
+        atoms.insert(b.atom1.0 as usize);
+        atoms.insert(b.atom2.0 as usize);
+    }
+    let mut nbrs = vec![0; path.len()];
+    for i in 0..path.len() {
+        let a = mol.bond(BondIdx(path[i]));
+        for j in i + 1..path.len() {
+            let b = mol.bond(BondIdx(path[j]));
+            if a.atom1 == b.atom1 || a.atom1 == b.atom2 || a.atom2 == b.atom1 || a.atom2 == b.atom2
+            {
+                nbrs[i] += 1;
+                nbrs[j] += 1;
+            }
+        }
+    }
+    (degrees, atoms.into_iter().collect(), nbrs)
+}
+fn topology(mut a: u32, mut b: u32, n: u32) -> u32 {
+    if a < b {
+        std::mem::swap(&mut a, &mut b);
+    }
+    (n % 8) | ((a % 8) << 3) | ((b % 8) << 6)
+}
+fn bond_type(mut a: u32, mut b: u32, n: u32, code: u32) -> u32 {
+    if a < b {
+        std::mem::swap(&mut a, &mut b);
+    }
+    (code % 8) | ((n % 8) << 3) | ((a % 8) << 6) | ((b % 8) << 9)
+}
+fn atom_type(a: u32, b: u32, mut da: u32, mut db: u32, n: u32) -> u32 {
+    let mut a = a % 128;
+    let mut b = b % 128;
+    if a < b || (a == b && da < db) {
+        std::mem::swap(&mut a, &mut b);
+        std::mem::swap(&mut da, &mut db);
+    }
+    a | (b << 7) | ((da % 8) << 14) | ((db % 8) << 17) | ((n % 8) << 20)
+}
+fn aromaticity(mut a: bool, mut b: bool, n: u32) -> u32 {
+    if !a && b {
+        std::mem::swap(&mut a, &mut b);
+    }
+    (a as u32) | ((b as u32) << 1) | ((n % 8) << 5)
+}
