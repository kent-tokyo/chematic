--- /dev/null
+++ b/crates/chematic-smarts/src/parser/rings.rs
@@ -0,0 +1,56 @@
+//! Preserve lexical neighbour order while resolving ring closures.
+use super::*;
+
+impl Parser<'_> {
+    // -- ring closures -------------------------------------------------------
+
+    /// Handle a ring closure: either close an existing open ring or open a new one.
+    pub(super) fn handle_ring_closure(
+        &mut self,
+        mol: &mut QueryMolecule,
+        current: usize,
+        ring_num: u8,
+        ring_bond: Option<BondQuery>,
+        open_rings: &mut HashMap<u8, (usize, Option<BondQuery>, usize)>,
+    ) -> Result<(), SmartsError> {
+        if let Some((open_atom, open_bond, open_position)) = open_rings.remove(&ring_num) {
+            // Resolve the bond type.
+            let bond = match (open_bond, ring_bond) {
+                (Some(a), Some(b)) if a == b => a,
+                (Some(_), Some(_)) => {
+                    // Conflicting ring bond specifications — use Any as a fallback.
+                    BondQuery::Any
+                }
+                (Some(b), None) | (None, Some(b)) => b,
+                (None, None) => BondQuery::Any,
+            };
+            mol.add_bond(open_atom, current, bond);
+            // `add_bond` appends at both endpoints. At the closing endpoint
+            // that is the lexical position of the ring digit. At the opening
+            // endpoint the digit was seen earlier, so move only that adjacency
+            // entry back to the recorded position. Graph semantics do not
+            // change; this preserves the order needed for stereo parity.
+            let open_adj = &mut mol.adj[open_atom];
+            // safe: add_bond appended the new adjacency entry.
+            let entry = open_adj
+                .pop()
+                .expect("the just-added ring bond has an adjacency entry");
+            let pending_before = open_rings
+                .values()
+                .filter(|&&(atom, _, position)| atom == open_atom && position < open_position)
+                .count();
+            let position = open_position.saturating_sub(pending_before);
+            open_adj.insert(position.min(open_adj.len()), entry);
+        } else {
+            let pending = open_rings
+                .values()
+                .filter(|&&(atom, _, _)| atom == current)
+                .count();
+            open_rings.insert(
+                ring_num,
+                (current, ring_bond, mol.adj[current].len() + pending),
+            );
+        }
+        Ok(())
+    }
+}
diff --git a/crates/chematic-smarts/tests/merge_query_hydrogens.rs b/crates/chematic-smarts/tests/merge_query_hydrogens.rs
new file mode 100644
index 00000000..602fa782
--- /dev/null
+++ b/crates/chematic-smarts/tests/merge_query_hydrogens.rs
@@ -0,0 +1,183 @@
+use chematic_smarts::{
+    MatchConfig, QueryHydrogenError, find_matches_with_config, merge_query_hydrogens, parse_smarts,
+};
+use chematic_smiles::parse;
+
+fn matches(pattern: &str, target: &str, chirality: bool) -> bool {
+    let query = merge_query_hydrogens(&parse_smarts(pattern).unwrap()).unwrap();
+    !find_matches_with_config(
+        &query,
+        &parse(target).unwrap(),
+        &MatchConfig {
+            use_chirality: chirality,
+            ..Default::default()
+        },
+    )
+    .is_empty()
+}
+
+#[test]
+fn issue9675_matches_intended_enantiomer_after_h_folding() {
+    let q = "[C@@]([H])(C)(N)C(=O)O";
+    assert!(matches(q, "C[C@H](N)C(=O)O", true));
+    assert!(!matches(q, "C[C@@H](N)C(=O)O", true));
+    assert!(matches(q, "C[C@@H](N)C(=O)O", false));
+}
+
+#[test]
+fn virtual_h_parity_tracks_every_neighbor_position() {
+    let equivalent = [
+        "[H][C@@](C)(N)C(=O)O",
+        "[C@@]([H])(C)(N)C(=O)O",
+        "[C@](C)([H])(N)C(=O)O",
+        "[C@@](C)(N)([H])C(=O)O",
+        "[C@](C)(N)(C(=O)O)[H]",
+        "C[C@]([H])(N)C(=O)O",
+        "C[C@@](N)([H])C(=O)O",
+    ];
+    for q in equivalent {
+        assert!(matches(q, "C[C@H](N)C(=O)O", true), "{q}");
+        assert!(!matches(q, "C[C@@H](N)C(=O)O", true), "{q}");
+    }
+}
+
+#[test]
+fn explicit_h_targets_keep_same_stereo_result() {
+    for target in [
+        "[H][C@@](C)(N)C(=O)O",
+        "C[C@]([H])(N)C(=O)O",
+        "[2H][C@@](C)(N)C(=O)O",
+    ] {
+        assert!(matches("[C@@]([H])(C)(N)C(=O)O", target, true), "{target}");
+    }
+    assert!(!matches(
+        "[C@@]([H])(C)(N)C(=O)O",
+        "[H][C@](C)(N)C(=O)O",
+        true
+    ));
+}
+
+#[test]
+fn h_count_is_minimum_not_exact() {
+    for target in ["C", "CC", "CCC", "[CH2]", "[CH3]"] {
+        assert!(matches("C([H])[H]", target, false), "{target}");
+    }
+    for target in ["[C]", "[CH]", "C(F)(F)(F)F"] {
+        assert!(!matches("C([H])[H]", target, false), "{target}");
+    }
+    assert!(!matches("[CH0][H]", "C", false));
+}
+
+#[test]
+fn isotopic_mapped_charged_and_complex_h_are_retained() {
+    for q in [
+        "[2H]C", "[H:7]C", "[H+]C", "[#1;D1]C", "[H]~C", "[H]=C", "[H][H]", "[H][H+]", "[H]",
+    ] {
+        let original = parse_smarts(q).unwrap();
+        assert_eq!(merge_query_hydrogens(&original).unwrap(), original, "{q}");
+    }
+    assert_eq!(
+        merge_query_hydrogens(&parse_smarts("[#1]C").unwrap())
+            .unwrap()
+            .atom_count(),
+        1
+    );
+}
+
+#[test]
+fn output_is_idempotent_and_input_is_immutable() {
+    let input = parse_smarts("[H][C@](C)(N)C(=O)O").unwrap();
+    let copy = input.clone();
+    let output = merge_query_hydrogens(&input).unwrap();
+    assert_eq!(input, copy);
+    assert_eq!(output.atom_count(), input.atom_count() - 1);
+    assert_eq!(merge_query_hydrogens(&output).unwrap(), output);
+}
+
+#[test]
+fn unsafe_partial_frames_recursive_queries_and_bad_graphs_fail() {
+    for q in ["[C@]([H])(N)C", "[C@]([H])([H])(N)C"] {
+        assert!(matches!(
+            merge_query_hydrogens(&parse_smarts(q).unwrap()),
+            Err(QueryHydrogenError::UnsupportedStereo { .. })
+        ));
+    }
+    assert_eq!(
+        merge_query_hydrogens(&parse_smarts("[$(C[H])]").unwrap()),
+        Err(QueryHydrogenError::RecursiveQuery)
+    );
+    let mut q = parse_smarts("C[H]").unwrap();
+    q.adj[0][0].1 = 99;
+    assert_eq!(
+        merge_query_hydrogens(&q),
+        Err(QueryHydrogenError::InvalidGraph)
+    );
+}
+
+#[test]
+fn ring_openings_reserve_order_for_both_closure_orders() {
+    for (q, same, opposite) in [
+        (
+            "[C@]12([H])CC(C)CC1NC2",
+            "[C@H]12CC(C)CC1NC2",
+            "[C@@H]12CC(C)CC1NC2",
+        ),
+        (
+            "[C@]12([H])CC(C)CC2NC1",
+            "[C@H]12CC(C)CC2NC1",
+            "[C@@H]12CC(C)CC2NC1",
+        ),
+        (
+            "[C@]1([H])2CC(C)CC1NC2",
+            "[C@@H]12CC(C)CC1NC2",
+            "[C@H]12CC(C)CC1NC2",
+        ),
+    ] {
+        assert!(matches(q, same, true), "{q}");
+        assert!(!matches(q, opposite, true), "{q}");
+    }
+}
+
+#[test]
+fn limits_are_checked_before_cloning_invalid_public_queries() {
+    use chematic_smarts::{AtomPrimitive, AtomQuery, BondQuery, QueryMolecule};
+    let mut graph = QueryMolecule::new();
+    for _ in 0..1025 {
+        graph.add_atom(AtomQuery::Primitive(AtomPrimitive::Wildcard));
+    }
+    assert_eq!(
+        merge_query_hydrogens(&graph),
+        Err(QueryHydrogenError::ResourceLimit)
+    );
+    let mut expr = AtomQuery::Primitive(AtomPrimitive::Wildcard);
+    for _ in 0..33 {
+        expr = AtomQuery::Not(Box::new(expr));
+    }
+    let mut graph = QueryMolecule::new();
+    graph.add_atom(expr);
+    assert_eq!(
+        merge_query_hydrogens(&graph),
+        Err(QueryHydrogenError::ResourceLimit)
+    );
+    let mut graph = parse_smarts("CC").unwrap();
+    let mut expr = BondQuery::Any;
+    for _ in 0..33 {
+        expr = BondQuery::Not(Box::new(expr));
+    }
+    graph.bonds[0].query = expr;
+    assert_eq!(
+        merge_query_hydrogens(&graph),
+        Err(QueryHydrogenError::ResourceLimit)
+    );
+}
+
+#[test]
+fn surviving_atom_maps_and_non_h_bond_queries_are_preserved() {
+    let input = parse_smarts("[C:9]([H])~[N:2]").unwrap();
+    let output = merge_query_hydrogens(&input).unwrap();
+    assert_eq!(
+        output.atoms.iter().map(|a| a.atom_map).collect::<Vec<_>>(),
+        [Some(9), Some(2)]
+    );
+    assert_eq!(output.bonds[0].query, input.bonds[1].query);
+}
