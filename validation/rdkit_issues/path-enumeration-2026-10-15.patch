diff --git a/crates/chematic-smiles/src/rdkit/path_enumeration.rs b/crates/chematic-smiles/src/rdkit/path_enumeration.rs
new file mode 100644
index 0000000..7cf8830
--- /dev/null
+++ b/crates/chematic-smiles/src/rdkit/path_enumeration.rs
@@ -0,0 +1,117 @@
+//! Ordered paths following RDKit Release_2026_09_1 Subgraphs.cpp.
+//! Copyright (C) 2003-2026 Greg Landrum and other RDKit contributors.
+//! BSD-3-Clause; see THIRD_PARTY_NOTICES.md. Uses the existing sanitized model.
+use super::{RdkitSmilesError, graph_queries, mol::Mol};
+use chematic_core::Molecule;
+mod search;
+
+/// Options for RDKit's FindAllPathsOfLengthN, in sanitized model numbering.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct RdkitPathParams {
+    /// True: length and output indices count bonds; false: they count atoms.
+    pub use_bonds: bool,
+    pub use_hs: bool,
+    /// None starts at every atom. Out-of-range roots return no paths.
+    pub rooted_at_atom: Option<usize>,
+    /// Retains only geodesics; upstream considers graph Hs regardless of use_hs.
+    pub only_shortest_paths: bool,
+}
+impl Default for RdkitPathParams {
+    fn default() -> Self {
+        Self {
+            use_bonds: true,
+            use_hs: false,
+            rooted_at_atom: None,
+            only_shortest_paths: false,
+        }
+    }
+}
+
+/// Independent work/storage caps. Exhaustion returns an error, never partial paths.
+#[derive(Debug, Clone, Copy)]
+pub struct RdkitPathLimits {
+    /// Neighbor extensions examined, including rejected repeats/shortcuts.
+    pub max_visits: usize,
+    /// Prefix count in either breadth-first frontier, before deduplication.
+    pub max_frontier: usize,
+    /// Number of unique returned paths.
+    pub max_results: usize,
+    /// Total indices in either frontier, or in the returned paths, separately.
+    pub max_path_indices: usize,
+}
+impl Default for RdkitPathLimits {
+    fn default() -> Self {
+        Self {
+            max_visits: 1_000_000,
+            max_frontier: 100_000,
+            max_results: 100_000,
+            max_path_indices: 1_000_000,
+        }
+    }
+}
+
+fn unsupported(detail: impl Into<String>) -> RdkitSmilesError {
+    RdkitSmilesError::Unsupported(detail.into())
+}
+fn reserve<T>(v: &mut Vec<T>, count: usize) -> Result<(), RdkitSmilesError> {
+    v.try_reserve(count)
+        .map_err(|e| unsupported(format!("path allocation failed: {e}")))
+}
+type Neighbors = Vec<Vec<(usize, usize)>>;
+
+/// FindAllPathsOfLengthN with ordered atom-index expansion and bond-set dedup.
+/// Unlike branched subgraphs, prefixes are linear. The last step can close a
+/// ring to any earlier atom except the immediately previous one. Both zero
+/// lengths return empty; atom length one includes isolated/graph-H atoms.
+pub fn rdkit_paths_of_length(
+    mol: &Molecule,
+    length: u32,
+    params: &RdkitPathParams,
+) -> Result<Vec<Vec<usize>>, RdkitSmilesError> {
+    rdkit_paths_of_length_with_limits(mol, length, params, &RdkitPathLimits::default())
+}
+
+/// Same sanitized model and <=1024 input atoms /16384 bonds as graph queries.
+/// Very large lengths return empty once impossible, without looping to length.
+pub fn rdkit_paths_of_length_with_limits(
+    mol: &Molecule,
+    length: u32,
+    params: &RdkitPathParams,
+    limits: &RdkitPathLimits,
+) -> Result<Vec<Vec<usize>>, RdkitSmilesError> {
+    let model = graph_queries::prepare(mol)?;
+    let n = model.atoms.len();
+    if length == 0 || params.rooted_at_atom.is_some_and(|root| root >= n) {
+        return Ok(Vec::new());
+    }
+    // Compare before adding one so even a 32-bit target cannot overflow usize.
+    if u64::from(length) > n as u64 + u64::from(!params.use_bonds) {
+        return Ok(Vec::new());
+    }
+    let target = length as usize + usize::from(params.use_bonds);
+    // With shortest-path selection RDKit builds adjacency from the unfiltered
+    // distance matrix, which includes graph Hs even when useHs is false.
+    let neighbors = neighbors(&model, params.use_hs || params.only_shortest_paths)?;
+    search::enumerate(&neighbors, target, params, limits)
+}
+
+fn neighbors(model: &Mol, use_hs: bool) -> Result<Neighbors, RdkitSmilesError> {
+    let mut result = Vec::new();
+    reserve(&mut result, model.atoms.len())?;
+    result.resize_with(model.atoms.len(), Vec::new);
+    for (index, bond) in model.bonds.iter().enumerate() {
+        if use_hs || (model.atoms[bond.begin].anum != 1 && model.atoms[bond.end].anum != 1) {
+            reserve(&mut result[bond.begin], 1)?;
+            result[bond.begin].push((bond.end, index));
+            reserve(&mut result[bond.end], 1)?;
+            result[bond.end].push((bond.begin, index));
+        }
+    }
+    for row in &mut result {
+        row.sort_unstable();
+        // The upstream adjacency matrix has one edge per atom pair and bond
+        // lookup selects the first bond. Keep that same first-index relation.
+        row.dedup_by_key(|(atom, _)| *atom);
+    }
+    Ok(result)
+}
diff --git a/crates/chematic-smiles/src/rdkit/path_enumeration/search.rs b/crates/chematic-smiles/src/rdkit/path_enumeration/search.rs
new file mode 100644
index 0000000..5e40ad7
--- /dev/null
+++ b/crates/chematic-smiles/src/rdkit/path_enumeration/search.rs
@@ -0,0 +1,159 @@
+use super::{Neighbors, RdkitPathLimits, RdkitPathParams, RdkitSmilesError, reserve, unsupported};
+use std::collections::HashSet;
+
+fn limit(detail: &str) -> RdkitSmilesError {
+    unsupported(format!("path enumeration resource limit: {detail}"))
+}
+
+fn append(
+    frontier: &mut Vec<Vec<usize>>,
+    indices: &mut usize,
+    prefix: &[usize],
+    atom: usize,
+    limits: &RdkitPathLimits,
+) -> Result<(), RdkitSmilesError> {
+    let len = prefix.len() + 1;
+    if frontier.len() >= limits.max_frontier {
+        return Err(limit("frontier count exceeded"));
+    }
+    let total = indices
+        .checked_add(len)
+        .ok_or_else(|| limit("frontier indices overflow"))?;
+    if total > limits.max_path_indices {
+        return Err(limit("frontier indices exceeded"));
+    }
+    let mut path = Vec::new();
+    reserve(&mut path, len)?;
+    path.extend_from_slice(prefix);
+    path.push(atom);
+    reserve(frontier, 1)?;
+    frontier.push(path);
+    *indices = total;
+    Ok(())
+}
+
+pub(super) fn enumerate(
+    neighbors: &Neighbors,
+    target: usize,
+    params: &RdkitPathParams,
+    limits: &RdkitPathLimits,
+) -> Result<Vec<Vec<usize>>, RdkitSmilesError> {
+    let mut frontier = Vec::new();
+    let mut indices = 0;
+    let n = neighbors.len();
+    for atom in 0..n {
+        if params.rooted_at_atom.is_none_or(|root| root == atom) {
+            append(&mut frontier, &mut indices, &[], atom, limits)?;
+        }
+    }
+    let distances = if params.only_shortest_paths {
+        Some(distances(neighbors)?)
+    } else {
+        None
+    };
+    let mut visits = 0;
+    for size in 1..target {
+        if frontier.is_empty() {
+            break;
+        }
+        let mut next = Vec::new();
+        indices = 0;
+        for path in &frontier {
+            for &(atom, _) in &neighbors[path[size - 1]] {
+                if visits >= limits.max_visits {
+                    return Err(limit("visit count exceeded"));
+                }
+                visits += 1;
+                if distances
+                    .as_ref()
+                    .is_some_and(|d| usize::from(d[path[0] * n + atom]) < size)
+                {
+                    continue;
+                }
+                let repeat = path.contains(&atom);
+                let closure = target > 2 && size == target - 1 && atom != path[size - 2];
+                if !repeat || closure {
+                    append(&mut next, &mut indices, path, atom, limits)?;
+                }
+            }
+        }
+        frontier = next;
+    }
+    deduplicate(frontier, neighbors, params.use_bonds, limits)
+}
+
+// Unweighted all-pairs BFS is equivalent to RDKit's default distance matrix.
+// Storage is bounded by the already checked 1024-atom model and allocated fallibly.
+fn distances(neighbors: &Neighbors) -> Result<Vec<u16>, RdkitSmilesError> {
+    let n = neighbors.len();
+    let mut out = Vec::new();
+    reserve(&mut out, n * n)?;
+    out.resize(n * n, u16::MAX);
+    let mut queue = Vec::new();
+    reserve(&mut queue, n)?;
+    for root in 0..n {
+        queue.clear();
+        queue.push(root);
+        out[root * n + root] = 0;
+        let mut cursor = 0;
+        while cursor < queue.len() {
+            let atom = queue[cursor];
+            cursor += 1;
+            for &(other, _) in &neighbors[atom] {
+                if out[root * n + other] == u16::MAX {
+                    out[root * n + other] = out[root * n + atom] + 1;
+                    queue.push(other);
+                }
+            }
+        }
+    }
+    Ok(out)
+}
+
+fn deduplicate(
+    frontier: Vec<Vec<usize>>,
+    neighbors: &Neighbors,
+    use_bonds: bool,
+    limits: &RdkitPathLimits,
+) -> Result<Vec<Vec<usize>>, RdkitSmilesError> {
+    let mut result = Vec::new();
+    let mut seen = HashSet::new();
+    let mut indices = 0usize;
+    for path in frontier {
+        let mut bonds = Vec::new();
+        reserve(&mut bonds, path.len().saturating_sub(1))?;
+        for pair in path.windows(2) {
+            let edge = neighbors[pair[0]]
+                .binary_search_by_key(&pair[1], |(atom, _)| *atom)
+                .map_err(|_| unsupported("path edge missing from sanitized model"))?;
+            bonds.push(neighbors[pair[0]][edge].1);
+        }
+        let mut key = Vec::new();
+        reserve(&mut key, bonds.len())?;
+        key.extend_from_slice(&bonds);
+        key.sort_unstable();
+        // Single-atom paths are individually retained, including isolated Hs.
+        if !key.is_empty() {
+            if seen.contains(&key) {
+                continue;
+            }
+            seen.try_reserve(1)
+                .map_err(|e| unsupported(format!("path dedup allocation failed: {e}")))?;
+            seen.insert(key);
+        }
+        let output = if use_bonds { bonds } else { path };
+        let total = indices
+            .checked_add(output.len())
+            .ok_or_else(|| limit("result indices overflow"))?;
+        if result.len() >= limits.max_results {
+            return Err(limit("result count exceeded"));
+        }
+        if total > limits.max_path_indices {
+            return Err(limit("result indices exceeded"));
+        }
+        reserve(&mut result, 1)?;
+        result.push(output);
+        indices = total;
+    }
+    Ok(result)
+}
