diff --git a/crates/chematic-chem/src/meso_stereo_group.rs b/crates/chematic-chem/src/meso_stereo_group.rs
new file mode 100644
index 0000000..ed82f24
--- /dev/null
+++ b/crates/chematic-chem/src/meso_stereo_group.rs
@@ -0,0 +1,195 @@
+//! Conservative proof-backed reduction of a relative stereo group's full alternative.
+//! Exact colored graph mappings, not canonical-string equality, justify promotion.
+use crate::{StereoGroupAlternativesError, enumerate_stereo_group_alternatives};
+use chematic_core::{AtomIdx, BondIdx, Molecule, StereoGroup, StereoGroupKind};
+mod graph;
+mod search;
+
+pub const MAX_MESO_GROUP_ATOMS: usize = 64;
+pub const MAX_MESO_GROUP_BONDS: usize = 128;
+pub const MAX_MESO_GROUP_VISITS: u64 = 10_000_000;
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum MesoStereoGroupError {
+    GroupIndex { index: usize, groups: usize },
+    AbsoluteGroup,
+    GraphLimit,
+    InvalidVisitLimit,
+    BudgetExceeded { visits: u64, limit: u64 },
+    Alternatives(StereoGroupAlternativesError),
+    UnsupportedAtom(AtomIdx),
+    IncompleteFrame(AtomIdx),
+    UnspecifiedTetrahedralAtom(AtomIdx),
+    UnsupportedBond(BondIdx),
+    UnsupportedDirections,
+}
+impl core::fmt::Display for MesoStereoGroupError {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        match self {
+            Self::GroupIndex { index, groups } => {
+                write!(f, "group index {index} is outside {groups} groups")
+            }
+            Self::AbsoluteGroup => write!(f, "ABS is already absolute"),
+            Self::GraphLimit => write!(
+                f,
+                "meso-group proof supports at most 64 atoms and 128 bonds"
+            ),
+            Self::InvalidVisitLimit => write!(f, "max_visits must be between 1 and 10000000"),
+            Self::BudgetExceeded { visits, limit } => write!(
+                f,
+                "meso-group proof exhausted {visits} candidate visits (limit {limit}); no reduction returned"
+            ),
+            Self::Alternatives(e) => e.fmt(f),
+            Self::UnsupportedAtom(a) => write!(
+                f,
+                "atom {} has unsupported wildcard/axial/non-tetrahedral stereo",
+                a.0
+            ),
+            Self::IncompleteFrame(a) => write!(
+                f,
+                "atom {} requires a complete unique four-ligand frame",
+                a.0
+            ),
+            Self::UnspecifiedTetrahedralAtom(a) => write!(
+                f,
+                "atom {} has an unspecified locally tetrahedral configuration",
+                a.0
+            ),
+            Self::UnsupportedBond(b) => write!(
+                f,
+                "bond {} has unsupported query/dative/zero order, a loop or parallel edge",
+                b.0
+            ),
+            Self::UnsupportedDirections => write!(
+                f,
+                "unsupported, conflicting or unaccounted geometric directions"
+            ),
+        }
+    }
+}
+impl std::error::Error for MesoStereoGroupError {}
+
+/// A checked mapping from the lower-mask configuration to its full alternative.
+pub struct MesoStereoWitness {
+    pub mask: usize,
+    /// Source atom index -> target atom index; preserves groups and source labels.
+    pub atom_permutation: Vec<AtomIdx>,
+}
+pub struct MesoStereoGroupReduction {
+    pub molecule: Molecule,
+    /// True only after every other-group assignment has a checked witness.
+    pub reduced: bool,
+    pub checked_pairs: usize,
+    pub search_visits: u64,
+    pub witnesses: Vec<MesoStereoWitness>,
+}
+
+fn promote(mol: &Molecule, selected: usize) -> Molecule {
+    let mut groups: Vec<(StereoGroup, Vec<BondIdx>)> = mol
+        .stereo_groups()
+        .iter()
+        .enumerate()
+        .map(|(i, g)| {
+            (
+                g.clone(),
+                mol.stereo_group_bond_indices(i)
+                    .unwrap_or_default()
+                    .to_vec(),
+            )
+        })
+        .collect();
+    if let Some(abs) = groups
+        .iter()
+        .position(|(g, _)| g.kind == StereoGroupKind::Absolute)
+    {
+        let (relative, bonds) = groups[selected].clone();
+        groups[abs].0.atom_indices.extend(relative.atom_indices);
+        groups[abs].1.extend(bonds);
+        groups.remove(selected);
+    } else {
+        groups[selected].0.kind = StereoGroupKind::Absolute;
+    }
+    // Existing structural validation established disjoint membership. The only
+    // change merges the selected members into the unique ABS collection.
+    let mut result = mol.clone();
+    result.set_stereo_groups_with_bonds(groups);
+    for (idx, atom) in mol.atoms() {
+        if atom.cip_code.is_some() {
+            result.set_cip_code(idx, None);
+        }
+    }
+    result
+}
+
+/// Promote one AND/OR group to ABS only when its full alternative is equivalent
+/// under a configuration-preserving graph mapping for every assignment of all
+/// other relative groups. Group membership, atom maps and atom tags are colors:
+/// a proof cannot erase their distinctions or exchange independent groups.
+///
+/// Returns an unchanged cold-cache copy when no mapping is found for a pair;
+/// this is conservative retention, not a general "non-meso" classification.
+/// Budget exhaustion is an error, never a negative result or partial promotion.
+/// No drawing, indexed graph or tetrahedral/geometric configuration is changed.
+pub fn reduce_meso_stereo_group(
+    mol: &Molecule,
+    index: usize,
+    max_visits: u64,
+) -> Result<MesoStereoGroupReduction, MesoStereoGroupError> {
+    if !(1..=MAX_MESO_GROUP_VISITS).contains(&max_visits) {
+        return Err(MesoStereoGroupError::InvalidVisitLimit);
+    }
+    if mol.atom_count() > MAX_MESO_GROUP_ATOMS || mol.bond_count() > MAX_MESO_GROUP_BONDS {
+        return Err(MesoStereoGroupError::GraphLimit);
+    }
+    let group = mol
+        .stereo_groups()
+        .get(index)
+        .ok_or(MesoStereoGroupError::GroupIndex {
+            index,
+            groups: mol.stereo_groups().len(),
+        })?;
+    if group.kind == StereoGroupKind::Absolute {
+        return Err(MesoStereoGroupError::AbsoluteGroup);
+    }
+    let alternatives =
+        enumerate_stereo_group_alternatives(mol, 64).map_err(MesoStereoGroupError::Alternatives)?;
+    let bit = alternatives
+        .relative_group_indices
+        .iter()
+        .position(|&i| i == index)
+        .expect("validated relative group");
+    let mut budget = search::Budget {
+        visits: 0,
+        limit: max_visits,
+    };
+    let mut witnesses = Vec::new();
+    let mut checked_pairs = 0;
+    for mask in 0..alternatives.molecules.len() {
+        if mask & (1 << bit) != 0 {
+            continue;
+        }
+        let a = graph::Graph::new(&alternatives.molecules[mask])?;
+        let b = graph::Graph::new(&alternatives.molecules[mask | (1 << bit)])?;
+        checked_pairs += 1;
+        let Some(mapping) = search::find_mapping(&a, &b, &mut budget)? else {
+            return Ok(MesoStereoGroupReduction {
+                molecule: alternatives.molecules[0].clone(),
+                reduced: false,
+                checked_pairs,
+                search_visits: budget.visits,
+                witnesses,
+            });
+        };
+        witnesses.push(MesoStereoWitness {
+            mask,
+            atom_permutation: mapping.into_iter().map(|i| AtomIdx(i as u32)).collect(),
+        });
+    }
+    Ok(MesoStereoGroupReduction {
+        molecule: promote(mol, index),
+        reduced: true,
+        checked_pairs,
+        search_visits: budget.visits,
+        witnesses,
+    })
+}
diff --git a/crates/chematic-chem/src/meso_stereo_group/graph.rs b/crates/chematic-chem/src/meso_stereo_group/graph.rs
new file mode 100644
index 0000000..927b7d4
--- /dev/null
+++ b/crates/chematic-chem/src/meso_stereo_group/graph.rs
@@ -0,0 +1,167 @@
+use super::MesoStereoGroupError as Error;
+use chematic_core::ez_markers::{EzFact, read_ez_facts};
+use chematic_core::{AtomIdx, BondIdx, BondOrder, Chirality, Molecule, STEREO_H_SENTINEL};
+
+#[derive(Clone, PartialEq, Eq)]
+pub(super) struct Color {
+    element: u8,
+    isotope: Option<u16>,
+    charge: i8,
+    hydrogen: u8,
+    aromatic: bool,
+    atom_map: Option<u16>,
+    tag: Option<u16>,
+    group: Option<usize>,
+    tetra: bool,
+    degree: usize,
+}
+#[derive(Clone, Copy)]
+pub(super) struct Edge {
+    pub index: BondIdx,
+    order: u8,
+    group: Option<usize>,
+    geometric: bool,
+}
+impl Edge {
+    pub fn signature(self) -> (u8, Option<usize>, bool) {
+        (self.order, self.group, self.geometric)
+    }
+}
+pub(super) struct Graph<'a> {
+    pub mol: &'a Molecule,
+    pub colors: Vec<Color>,
+    pub adj: Vec<Vec<Option<Edge>>>,
+    pub frames: Vec<Option<[u32; 4]>>,
+    pub facts: Vec<EzFact>,
+    pub fact_by_bond: Vec<Option<usize>>,
+}
+fn frame(mol: &Molecule, idx: AtomIdx) -> Result<Option<[u32; 4]>, Error> {
+    let a = mol.atom(idx);
+    if a.wildcard
+        || mol.r_group_label(idx).is_some()
+        || a.chirality.nontetrahedral().is_some()
+        || mol.is_allene_stereo(idx)
+    {
+        return Err(Error::UnsupportedAtom(idx));
+    }
+    let h = chematic_core::implicit_hcount(mol, idx);
+    if a.chirality == Chirality::None {
+        if !a.aromatic
+            && h <= 1
+            && mol.degree(idx) + h as usize == 4
+            && mol.neighbors(idx).all(|(_, b)| {
+                matches!(
+                    mol.bond(b).order,
+                    BondOrder::Single | BondOrder::Up | BondOrder::Down
+                )
+            })
+        {
+            return Err(Error::UnspecifiedTetrahedralAtom(idx));
+        }
+        return Ok(None);
+    }
+    let stored = mol.stereo_neighbor_order(idx).unwrap_or_default();
+    let mut expected: Vec<u32> = mol.neighbors(idx).map(|(a, _)| a.0).collect();
+    expected.extend(std::iter::repeat_n(STEREO_H_SENTINEL, h as usize));
+    let mut sorted = stored.to_vec();
+    sorted.sort_unstable();
+    expected.sort_unstable();
+    if expected.len() != 4 || sorted != expected || sorted.windows(2).any(|v| v[0] == v[1]) {
+        return Err(Error::IncompleteFrame(idx));
+    }
+    Ok(Some(stored.try_into().expect("four slots validated")))
+}
+fn order(order: BondOrder, index: BondIdx) -> Result<u8, Error> {
+    match order {
+        BondOrder::Single | BondOrder::Up | BondOrder::Down => Ok(1),
+        BondOrder::Double => Ok(2),
+        BondOrder::Triple => Ok(3),
+        BondOrder::Aromatic => Ok(4),
+        _ => Err(Error::UnsupportedBond(index)),
+    }
+}
+fn geometry(mol: &Molecule) -> Result<Vec<EzFact>, Error> {
+    if mol.has_bond_directions() {
+        return Err(Error::UnsupportedDirections);
+    }
+    let Some((facts, false)) = read_ez_facts(mol) else {
+        return Err(Error::UnsupportedDirections);
+    };
+    // No marker may be ignored as a lone wedge or incomplete E/Z declaration.
+    for (_, bond) in mol.bonds() {
+        if !matches!(bond.order, BondOrder::Up | BondOrder::Down) {
+            continue;
+        }
+        let accounted = facts.iter().any(|f| {
+            f.ends
+                .iter()
+                .any(|e| bond.atom1 == e.atom || bond.atom2 == e.atom)
+        });
+        if !accounted {
+            return Err(Error::UnsupportedDirections);
+        }
+    }
+    Ok(facts)
+}
+impl<'a> Graph<'a> {
+    pub fn new(mol: &'a Molecule) -> Result<Self, Error> {
+        let facts = geometry(mol)?;
+        let n = mol.atom_count();
+        let mut atom_groups = vec![None; n];
+        let mut bond_groups = vec![None; mol.bond_count()];
+        for (i, g) in mol.stereo_groups().iter().enumerate() {
+            for a in &g.atom_indices {
+                atom_groups[a.0 as usize] = Some(i);
+            }
+            for b in mol.stereo_group_bond_indices(i).unwrap_or_default() {
+                bond_groups[b.0 as usize] = Some(i);
+            }
+        }
+        let mut fact_by_bond = vec![None; mol.bond_count()];
+        for (i, f) in facts.iter().enumerate() {
+            fact_by_bond[f.double.0 as usize] = Some(i);
+        }
+        let mut colors = Vec::new();
+        let mut frames = Vec::new();
+        for (idx, a) in mol.atoms() {
+            let f = frame(mol, idx)?;
+            colors.push(Color {
+                element: a.element.atomic_number(),
+                isotope: a.isotope,
+                charge: a.charge,
+                hydrogen: chematic_core::implicit_hcount(mol, idx),
+                aromatic: a.aromatic,
+                atom_map: a.atom_map,
+                tag: mol.atom_tag(idx).map(|v| v.get()),
+                group: atom_groups[idx.0 as usize],
+                tetra: f.is_some(),
+                degree: mol.degree(idx),
+            });
+            frames.push(f);
+        }
+        let mut adj = vec![vec![None; n]; n];
+        for (idx, bond) in mol.bonds() {
+            let a = bond.atom1.0 as usize;
+            let b = bond.atom2.0 as usize;
+            if a == b || adj[a][b].is_some() {
+                return Err(Error::UnsupportedBond(idx));
+            }
+            let edge = Edge {
+                index: idx,
+                order: order(bond.order, idx)?,
+                group: bond_groups[idx.0 as usize],
+                geometric: fact_by_bond[idx.0 as usize].is_some(),
+            };
+            adj[a][b] = Some(edge);
+            adj[b][a] = Some(edge);
+        }
+        Ok(Self {
+            mol,
+            colors,
+            adj,
+            frames,
+            facts,
+            fact_by_bond,
+        })
+    }
+}
diff --git a/crates/chematic-chem/src/meso_stereo_group/search.rs b/crates/chematic-chem/src/meso_stereo_group/search.rs
new file mode 100644
index 0000000..a9262ac
--- /dev/null
+++ b/crates/chematic-chem/src/meso_stereo_group/search.rs
@@ -0,0 +1,186 @@
+use super::MesoStereoGroupError as Error;
+use super::graph::Graph;
+use chematic_core::{AtomIdx, STEREO_H_SENTINEL};
+
+pub(super) struct Budget {
+    pub visits: u64,
+    pub limit: u64,
+}
+impl Budget {
+    fn probe(&mut self) -> Result<(), Error> {
+        if self.visits == self.limit {
+            return Err(Error::BudgetExceeded {
+                visits: self.visits,
+                limit: self.limit,
+            });
+        }
+        self.visits += 1;
+        Ok(())
+    }
+}
+fn mapped(index: u32, map: &[usize]) -> Option<u32> {
+    if index == STEREO_H_SENTINEL {
+        Some(index)
+    } else {
+        map.get(index as usize)
+            .copied()
+            .filter(|&v| v != usize::MAX)
+            .map(|v| v as u32)
+    }
+}
+fn even(from: &[u32; 4], to: &[u32; 4]) -> bool {
+    let mut positions = [0; 4];
+    for i in 0..4 {
+        positions[i] = to
+            .iter()
+            .position(|&v| v == from[i])
+            .expect("mapped full frame has the same ligands");
+    }
+    let inversions = (0..4)
+        .map(|i| (i + 1..4).filter(|&j| positions[i] > positions[j]).count())
+        .sum::<usize>();
+    inversions.is_multiple_of(2)
+}
+fn tetrahedral(a: &Graph<'_>, b: &Graph<'_>, map: &[usize]) -> bool {
+    for (source, frame) in a.frames.iter().enumerate() {
+        let Some(frame) = frame else {
+            continue;
+        };
+        let target = map[source];
+        if target == usize::MAX {
+            continue;
+        }
+        let Some(values) = frame
+            .iter()
+            .map(|&i| mapped(i, map))
+            .collect::<Option<Vec<_>>>()
+        else {
+            continue;
+        };
+        let from: [u32; 4] = values.try_into().expect("four slots");
+        let to = b.frames[target].expect("tetrahedral presence is an atom color");
+        // Every frame slot is a validated neighbor or the unique H sentinel.
+        // Adjacency and H colors make this a full permutation, not raw @/@@.
+        let same = a.mol.atom(AtomIdx(source as u32)).chirality
+            == b.mol.atom(AtomIdx(target as u32)).chirality;
+        if same != even(&from, &to) {
+            return false;
+        }
+    }
+    true
+}
+fn geometric(a: &Graph<'_>, b: &Graph<'_>, map: &[usize]) -> bool {
+    for fact in &a.facts {
+        let mut mapped_ends = Vec::new();
+        for end in &fact.ends {
+            let outer = a
+                .mol
+                .bond(end.reference)
+                .other(end.atom)
+                .expect("reference is incident");
+            let (Some(center), Some(outer)) = (mapped(end.atom.0, map), mapped(outer.0, map))
+            else {
+                break;
+            };
+            mapped_ends.push((center as usize, outer as usize));
+        }
+        if mapped_ends.len() != 2 {
+            continue;
+        }
+        let edge = b.adj[mapped_ends[0].0][mapped_ends[1].0].expect("mapped double bond");
+        let target = &b.facts
+            [b.fact_by_bond[edge.index.0 as usize].expect("geometric presence is an edge color")];
+        let mut parity = target.ends[0].up ^ target.ends[1].up;
+        for (center, outer) in mapped_ends {
+            let end = target
+                .ends
+                .iter()
+                .find(|e| e.atom.0 as usize == center)
+                .expect("matching double endpoint");
+            let reference = b
+                .mol
+                .bond(end.reference)
+                .other(end.atom)
+                .expect("reference is incident");
+            // Choosing the other explicit substituent reverses the reference
+            // side; reversing both cancels. Endpoint order itself is irrelevant.
+            parity ^= outer != reference.0 as usize;
+        }
+        if parity != (fact.ends[0].up ^ fact.ends[1].up) {
+            return false;
+        }
+    }
+    true
+}
+fn compatible(a: &Graph<'_>, b: &Graph<'_>, map: &[usize], source: usize, target: usize) -> bool {
+    if a.colors[source] != b.colors[target] {
+        return false;
+    }
+    for (s, &t) in map.iter().enumerate() {
+        if t == usize::MAX {
+            continue;
+        }
+        if a.adj[source][s].map(|e| e.signature()) != b.adj[target][t].map(|e| e.signature()) {
+            return false;
+        }
+    }
+    true
+}
+fn search(
+    a: &Graph<'_>,
+    b: &Graph<'_>,
+    map: &mut [usize],
+    used: &mut [bool],
+    budget: &mut Budget,
+) -> Result<bool, Error> {
+    let mut choice = None;
+    let mut candidates = Vec::new();
+    for source in 0..map.len() {
+        if map[source] != usize::MAX {
+            continue;
+        }
+        let mut possible = Vec::new();
+        for (target, &taken) in used.iter().enumerate() {
+            if taken {
+                continue;
+            }
+            budget.probe()?;
+            if compatible(a, b, map, source, target) {
+                possible.push(target);
+            }
+        }
+        if possible.is_empty() {
+            return Ok(false);
+        }
+        if choice.is_none() || possible.len() < candidates.len() {
+            choice = Some(source);
+            candidates = possible;
+        }
+    }
+    let Some(source) = choice else {
+        return Ok(true);
+    };
+    for target in candidates {
+        map[source] = target;
+        used[target] = true;
+        if tetrahedral(a, b, map) && geometric(a, b, map) && search(a, b, map, used, budget)? {
+            return Ok(true);
+        }
+        map[source] = usize::MAX;
+        used[target] = false;
+    }
+    Ok(false)
+}
+pub(super) fn find_mapping(
+    a: &Graph<'_>,
+    b: &Graph<'_>,
+    budget: &mut Budget,
+) -> Result<Option<Vec<usize>>, Error> {
+    let mut map = vec![usize::MAX; a.colors.len()];
+    let mut used = vec![false; map.len()];
+    if search(a, b, &mut map, &mut used, budget)? {
+        Ok(Some(map))
+    } else {
+        Ok(None)
+    }
+}
