        "linkages": [
          {"id": "dl1", "kind": "phosphodiester", "three_prime_residue_id": "d1", "five_prime_residue_id": "d2", "three_prime_atom_ref": "d1-3", "five_prime_atom_ref": "d2-5", "annotations": {}}
        ],
        "annotations": {"source": "contract fixture"}
      },
      "command": {"kind": "set_annotation", "target": {"kind": "residue", "id": "d2"}, "key": "selected", "value": true},
      "edited_path": ["strands", 0, "residues", 1, "annotations", "selected"],
      "edited_value": true
    },
    {
