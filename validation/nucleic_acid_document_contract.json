        "schema": "chematic.nucleic-acid.v1",
        "atom_ids": ["d1-5", "d1-3", "d2-5", "d2-3"],
        "strands": [{
          "id": "dna-1",
          "kind": "dna",
          "residues": [
            {"id": "d1", "base": "A", "sugar": "deoxyribose", "atom_refs": ["d1-5", "d1-3"], "three_prime_linkage": "dl1", "annotations": {"position": 1}},
            {"id": "d2", "base": "T", "sugar": "deoxyribose", "atom_refs": ["d2-5", "d2-3"], "five_prime_linkage": "dl1", "annotations": {"position": 2}}
          ],
          "annotations": {"name": "AT"}
