diff --git a/crates/chematic-py/src/io/dataset.rs b/crates/chematic-py/src/io/dataset.rs
new file mode 100644
index 0000000..5a5b0d8
--- /dev/null
+++ b/crates/chematic-py/src/io/dataset.rs
@@ -0,0 +1,119 @@
+use super::*;
+
+/// Indexed random access to a seekable SDF file.
+///
+/// Construction scans only record boundaries and title lines. Molecular
+/// graphs and SD fields are parsed lazily when a record is requested, so a
+/// large file does not need to be materialized as Python objects.
+#[pyclass(name = "SdfDataset", frozen)]
+pub struct PySdfDataset {
+    inner: Arc<chematic_mol::SdfDataset>,
+}
+
+#[pymethods]
+impl PySdfDataset {
+    #[new]
+    fn new(path: &str) -> PyResult<Self> {
+        Self::open(path)
+    }
+
+    #[staticmethod]
+    fn open(path: &str) -> PyResult<Self> {
+        chematic_mol::SdfDataset::open(path)
+            .map(|inner| Self {
+                inner: Arc::new(inner),
+            })
+            .map_err(sdf_dataset_error)
+    }
+
+    fn __len__(&self) -> usize {
+        self.inner.len()
+    }
+
+    fn __getitem__<'py>(
+        &self,
+        py: Python<'py>,
+        key: &Bound<'py, PyAny>,
+    ) -> PyResult<Bound<'py, PyAny>> {
+        if key.is_instance_of::<pyo3::types::PyInt>()
+            && !key.is_instance_of::<pyo3::types::PyBool>()
+        {
+            let index = super::dataset_selector::scalar_index(key, self.inner.len())?;
+            return Py::new(py, self.get(index as isize)?).map(|v| v.into_bound(py).into_any());
+        }
+        Py::new(py, self.select(py, key, "raise", 64 << 20)?).map(|v| v.into_bound(py).into_any())
+    }
+
+    /// Ordered selection; slices, integer lists/tuples or full-length bool masks.
+    /// Malformed records retain their positions with errors="keep".
+    #[pyo3(signature=(key,*,errors="keep",max_bytes=67108864))]
+    fn select(
+        &self,
+        py: Python<'_>,
+        key: &Bound<'_, PyAny>,
+        errors: &str,
+        #[pyo3(from_py_with=super::dataset_selector::positive_integer)] max_bytes: usize,
+    ) -> PyResult<super::dataset_batch::PySdfSelectionBatch> {
+        let raise = super::dataset_selector::error_policy(errors)?;
+        let indices = super::dataset_selector::indices(key, self.inner.len(), 10_000)?;
+        super::dataset_batch::read_batch(py, &self.inner, &indices, raise, max_bytes)
+    }
+
+    /// Pull source-ordered batches while keeping rejected record positions.
+    /// The iterator owns the indexed file handle and survives this wrapper.
+    #[pyo3(signature=(size=1024,*,errors="keep",max_bytes=67108864))]
+    fn batches(
+        &self,
+        #[pyo3(from_py_with=super::dataset_selector::positive_integer)] size: usize,
+        errors: &str,
+        #[pyo3(from_py_with=super::dataset_selector::positive_integer)] max_bytes: usize,
+    ) -> PyResult<super::dataset_batch::PySdfDatasetBatches> {
+        super::dataset_batch::PySdfDatasetBatches::new(
+            Arc::clone(&self.inner),
+            size,
+            errors,
+            max_bytes,
+        )
+    }
+
+    /// Parse one record. Negative indices follow normal Python semantics.
+    fn get(&self, index: isize) -> PyResult<PySdfRecord> {
+        let index = dataset_index(index, self.inner.len())?;
+        self.inner
+            .get(index)
+            .map_err(sdf_dataset_error)?
+            .map(py_sdf_record)
+            .ok_or_else(|| pyo3::exceptions::PyIndexError::new_err("SDF record index out of range"))
+    }
+
+    /// Read one raw record without the terminating ``$$$$`` line.
+    fn raw_record(&self, index: isize) -> PyResult<String> {
+        let index = dataset_index(index, self.inner.len())?;
+        self.inner
+            .record_text(index)
+            .map_err(sdf_dataset_error)?
+            .ok_or_else(|| pyo3::exceptions::PyIndexError::new_err("SDF record index out of range"))
+    }
+
+    /// Return byte-range metadata without parsing the molecular graph.
+    fn metadata(&self, index: isize) -> PyResult<PySdfRecordMetadata> {
+        let index = dataset_index(index, self.inner.len())?;
+        self.inner
+            .metadata(index)
+            .map(PySdfRecordMetadata::from)
+            .ok_or_else(|| pyo3::exceptions::PyIndexError::new_err("SDF record index out of range"))
+    }
+
+    /// Parse a half-open record range. The stop endpoint is clamped to
+    /// ``len(dataset)``; malformed records raise ``ChematicInputError``.
+    #[pyo3(signature = (start, stop=None))]
+    fn read_range(&self, start: usize, stop: Option<usize>) -> PyResult<Vec<PySdfRecord>> {
+        let stop = stop.unwrap_or(self.inner.len());
+        self.inner
+            .read_range(start, stop)
+            .map_err(sdf_dataset_error)?
+            .into_iter()
+            .map(|record| record.map(py_sdf_record).map_err(sdf_dataset_error))
+            .collect()
+    }
+}
diff --git a/crates/chematic-py/src/io/dataset_batch.rs b/crates/chematic-py/src/io/dataset_batch.rs
new file mode 100644
index 0000000..fcec7ba
--- /dev/null
+++ b/crates/chematic-py/src/io/dataset_batch.rs
@@ -0,0 +1,184 @@
+use super::*;
+
+struct Failure {
+    position: usize,
+    index: usize,
+    code: &'static str,
+    message: String,
+}
+
+/// Selected source positions, including placeholders and diagnostics for failures.
+#[pyclass(name = "SdfSelectionBatch", frozen)]
+pub(super) struct PySdfSelectionBatch {
+    indices: Vec<usize>,
+    records: Vec<Option<Py<PySdfRecord>>>,
+    failures: Vec<Failure>,
+}
+#[pymethods]
+impl PySdfSelectionBatch {
+    fn __len__(&self) -> usize {
+        self.records.len()
+    }
+    fn source_indices(&self) -> Vec<usize> {
+        self.indices.clone()
+    }
+    fn valid_mask(&self) -> Vec<bool> {
+        self.records.iter().map(Option::is_some).collect()
+    }
+    fn records(&self, py: Python<'_>) -> Vec<Option<Py<PySdfRecord>>> {
+        self.records
+            .iter()
+            .map(|r| r.as_ref().map(|r| r.clone_ref(py)))
+            .collect()
+    }
+    fn __getitem__(&self, py: Python<'_>, index: isize) -> PyResult<Option<Py<PySdfRecord>>> {
+        let index = dataset_index(index, self.records.len())?;
+        Ok(self.records[index].as_ref().map(|r| r.clone_ref(py)))
+    }
+    fn to_smiles_list(&self, py: Python<'_>) -> Vec<Option<String>> {
+        self.records
+            .iter()
+            .map(|r| r.as_ref().map(|r| r.borrow(py).smiles()))
+            .collect()
+    }
+    fn errors<'py>(&self, py: Python<'py>) -> PyResult<Vec<Bound<'py, PyDict>>> {
+        self.failures
+            .iter()
+            .map(|e| {
+                let d = PyDict::new(py);
+                d.set_item("position", e.position)?;
+                d.set_item("source_index", e.index)?;
+                d.set_item("code", e.code)?;
+                d.set_item("message", &e.message)?;
+                Ok(d)
+            })
+            .collect()
+    }
+}
+
+fn selection_error(error: chematic_mol::SdfSelectionError) -> PyErr {
+    use chematic_mol::SdfSelectionError;
+    match error {
+        SdfSelectionError::Index { .. } => {
+            pyo3::exceptions::PyIndexError::new_err(error.to_string())
+        }
+        SdfSelectionError::ResourceLimit {
+            resource,
+            actual,
+            limit,
+        } => sdf_dataset_error(chematic_mol::MolParseError::ResourceLimit {
+            resource,
+            actual,
+            limit,
+        }),
+        SdfSelectionError::Read(error) => sdf_dataset_error(error),
+    }
+}
+pub(super) fn read_batch(
+    py: Python<'_>,
+    dataset: &chematic_mol::SdfDataset,
+    indices: &[usize],
+    raise: bool,
+    max_bytes: usize,
+) -> PyResult<PySdfSelectionBatch> {
+    let limits = chematic_mol::SdfSelectionLimits {
+        max_records: 10_000,
+        max_total_record_bytes: max_bytes,
+    };
+    let batch = dataset
+        .read_indices_with_limits(indices, &limits)
+        .map_err(selection_error)?;
+    let mut records = Vec::with_capacity(batch.len());
+    let mut failures = Vec::new();
+    for (position, record) in batch.records.into_iter().enumerate() {
+        match record {
+            Ok(record) => records.push(Some(Py::new(py, py_sdf_record(record))?)),
+            Err(error) => {
+                if raise {
+                    return Err(sdf_dataset_error(error));
+                }
+                let code = if matches!(error, chematic_mol::MolParseError::ResourceLimit { .. }) {
+                    "resource_limit"
+                } else {
+                    "malformed"
+                };
+                failures.push(Failure {
+                    position,
+                    index: indices[position],
+                    code,
+                    message: error.to_string(),
+                });
+                records.push(None);
+            }
+        }
+    }
+    Ok(PySdfSelectionBatch {
+        indices: batch.indices,
+        records,
+        failures,
+    })
+}
+
+/// Lazy indexed-file batches; source indices are created only for the next chunk.
+#[pyclass(name = "SdfDatasetBatches")]
+pub(super) struct PySdfDatasetBatches {
+    dataset: Arc<chematic_mol::SdfDataset>,
+    next: usize,
+    size: usize,
+    raise: bool,
+    max_bytes: usize,
+}
+impl PySdfDatasetBatches {
+    pub(super) fn new(
+        dataset: Arc<chematic_mol::SdfDataset>,
+        size: usize,
+        errors: &str,
+        max_bytes: usize,
+    ) -> PyResult<Self> {
+        if size == 0 || size > 10_000 {
+            return Err(pyo3::exceptions::PyValueError::new_err(
+                "size must be 1..=10000",
+            ));
+        }
+        let raise = super::dataset_selector::error_policy(errors)?;
+        Ok(Self {
+            dataset,
+            next: 0,
+            size,
+            raise,
+            max_bytes,
+        })
+    }
+}
+#[pymethods]
+impl PySdfDatasetBatches {
+    fn __iter__(slf: PyRef<'_, Self>) -> PyRef<'_, Self> {
+        slf
+    }
+    fn __len__(&self) -> usize {
+        (self.dataset.len() - self.next).div_ceil(self.size)
+    }
+    fn cancel(&mut self) {
+        self.next = self.dataset.len();
+    }
+    fn __next__(&mut self, py: Python<'_>) -> PyResult<Option<PySdfSelectionBatch>> {
+        if self.next >= self.dataset.len() {
+            return Ok(None);
+        }
+        let end = self.next.saturating_add(self.size).min(self.dataset.len());
+        let indices: Vec<_> = (self.next..end).collect();
+        self.next = end;
+        match read_batch(py, &self.dataset, &indices, self.raise, self.max_bytes) {
+            Ok(batch) => Ok(Some(batch)),
+            Err(error) => {
+                self.cancel();
+                Err(error)
+            }
+        }
+    }
+}
+pub(super) fn register(m: &Bound<'_, PyModule>) -> PyResult<()> {
+    m.add_class::<PySdfSelectionBatch>()?;
+    m.add_class::<PySdfDatasetBatches>()?;
+    Ok(())
+}
diff --git a/crates/chematic-py/src/io/dataset_selector.rs b/crates/chematic-py/src/io/dataset_selector.rs
new file mode 100644
index 0000000..8991a72
--- /dev/null
+++ b/crates/chematic-py/src/io/dataset_selector.rs
@@ -0,0 +1,105 @@
+use pyo3::exceptions::{PyIndexError, PyTypeError, PyValueError};
+use pyo3::prelude::*;
+use pyo3::types::{PyBool, PyInt, PyList, PySlice, PyTuple};
+
+pub(super) fn positive_integer(value: &Bound<'_, PyAny>) -> PyResult<usize> {
+    if value.is_instance_of::<PyBool>() || !value.is_instance_of::<PyInt>() {
+        return Err(PyTypeError::new_err("expected an integer, excluding bool"));
+    }
+    value
+        .extract::<usize>()
+        .ok()
+        .filter(|v| *v > 0)
+        .ok_or_else(|| PyValueError::new_err("expected a positive integer fitting usize"))
+}
+pub(super) fn scalar_index(value: &Bound<'_, PyAny>, len: usize) -> PyResult<usize> {
+    if value.is_instance_of::<PyBool>() || !value.is_instance_of::<PyInt>() {
+        return Err(PyTypeError::new_err(
+            "record index must be an integer, excluding bool",
+        ));
+    }
+    let index = value
+        .extract::<isize>()
+        .map_err(|_| PyIndexError::new_err("SDF record index out of range"))?;
+    super::dataset_index(index, len)
+}
+pub(super) fn error_policy(errors: &str) -> PyResult<bool> {
+    match errors {
+        "keep" => Ok(false),
+        "raise" => Ok(true),
+        _ => Err(PyValueError::new_err("errors must be keep or raise")),
+    }
+}
+fn limit_error(actual: usize, limit: usize) -> PyErr {
+    super::sdf_dataset_error(chematic_mol::MolParseError::ResourceLimit {
+        resource: "selected records",
+        actual,
+        limit,
+    })
+}
+pub(super) fn indices(key: &Bound<'_, PyAny>, len: usize, limit: usize) -> PyResult<Vec<usize>> {
+    if let Ok(slice) = key.cast::<PySlice>() {
+        let len = isize::try_from(len)
+            .map_err(|_| PyIndexError::new_err("dataset too large for Python indexing"))?;
+        let s = slice.indices(len)?;
+        let count = s.slicelength;
+        if count > limit {
+            return Err(limit_error(count, limit));
+        }
+        let mut out = Vec::with_capacity(count);
+        let mut current = s.start;
+        for k in 0..count {
+            out.push(current as usize);
+            if k + 1 < count {
+                current = current
+                    .checked_add(s.step)
+                    .ok_or_else(|| PyIndexError::new_err("slice overflow"))?;
+            }
+        }
+        return Ok(out);
+    }
+    if key.is_instance_of::<PyInt>() && !key.is_instance_of::<PyBool>() {
+        return Ok(vec![scalar_index(key, len)?]);
+    }
+    if !key.is_instance_of::<PyList>() && !key.is_instance_of::<PyTuple>() {
+        return Err(PyTypeError::new_err(
+            "selector must be an int, slice, list or tuple",
+        ));
+    }
+    let count = key.len()?;
+    if count == 0 {
+        return Ok(Vec::new());
+    }
+    if key.get_item(0)?.is_instance_of::<PyBool>() {
+        return mask_indices(key, len, limit);
+    }
+    if count > limit {
+        return Err(limit_error(count, limit));
+    }
+    key.try_iter()?
+        .map(|item| scalar_index(&item?, len))
+        .collect()
+}
+fn mask_indices(key: &Bound<'_, PyAny>, len: usize, limit: usize) -> PyResult<Vec<usize>> {
+    if key.len()? != len {
+        return Err(PyValueError::new_err(
+            "boolean mask length must match dataset",
+        ));
+    }
+    let mut out = Vec::new();
+    for (i, item) in key.try_iter()?.enumerate() {
+        let item = item?;
+        if !item.is_instance_of::<PyBool>() {
+            return Err(PyTypeError::new_err(
+                "boolean masks cannot contain integer indices",
+            ));
+        }
+        if item.extract::<bool>()? {
+            if out.len() >= limit {
+                return Err(limit_error(out.len() + 1, limit));
+            }
+            out.push(i);
+        }
+    }
+    Ok(out)
+}
