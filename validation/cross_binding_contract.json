    {"id": "acetic-acid", "smiles": "CC(=O)O", "canonical_smiles": "CC(O)=O", "heavy_atoms": 4}
  ],
  "descriptor_contract": {
    "schema_version": 1,
    "semantics": "Values are computed from the parsed molecular graph; floats are compared within the declared tolerance.",
    "fields": {
      "molecular_weight": {"unit": "Da", "source": "chematic_chem::molecular_weight", "tolerance": 0.000001},
      "tpsa": {"unit": "A2", "source": "Ertl 2000 implementation in chematic-chem", "tolerance": 0.000001},
      "hbd": {"unit": "count", "source": "chematic_chem::hbd_count", "tolerance": 0},
      "hba": {"unit": "count", "source": "chematic_chem::hba_count", "tolerance": 0},
      "heavy_atoms": {"unit": "count", "source": "molecular graph explicit atom count", "tolerance": 0}
    },
    "fixtures": [
      {"id": "ethanol", "smiles": "CCO", "molecular_weight": 46.069, "tpsa": 20.23, "hbd": 1, "hba": 1, "heavy_atoms": 3},
