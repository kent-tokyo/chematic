      {"id": "std-p1-holdout-05-phenethylamine-hf-neutral", "smiles": "c1ccc(cc1)CCN.F", "output_smiles": "c1c(CCN)cccc1"},
      {"id": "std-p1-holdout-06-caffeine-dihydrate", "smiles": "Cn1cnc2c1c(=O)n(C)c(=O)n2C.O.O", "output_smiles": "n2(C)c(=O)n(C)c1c(c2=O)n(cn1)C"},
      {"id": "std-p1-holdout-07-three-fragment-amine-acid-hcl", "smiles": "CN1CCC(CC1)Nc1ccccc1.OC(=O)c1ccccc1O.Cl", "output_smiles": "N(c2ccccc2)C1CCN(CC1)C"},
      {"id": "std-p1-holdout-08-13c-labeled-sugar-hydrate-generalization", "smiles": "OC[C@H]1O[C@@H]([13OH])[C@H](O)[C@@H](O)[C@@H]1O.O", "output_smiles": "[C@@H]1([C@@H](O[C@H](CO)[C@H]([C@@H]1O)O)[13OH])O"},
      {"id": "std-p1-holdout-09-ethane-decane-unambiguous-nontie", "smiles": "CC.CCCCCCCCCC", "output_smiles": "CCCCCCCCCC"},
      {"id": "std-p1-holdout-10-pentane-butane-close-nontie", "smiles": "CCCCC.CCCC", "output_smiles": "CCCCC"}
    ]
  },
  "fingerprint_contract": {
    "schema_version": 1,
    "semantics": "Byte arrays are bit-packed with the least-significant bit first; shape, configuration, and the four-fixture ECFP4/MACCS outputs are stable across bindings.",
    "operations": {
      "ecfp4": {
        "source": "chematic_fp::ecfp",
        "representation": "bit-packed bytes",
        "bits": 2048,
        "bytes": 256,
        "bit_order": "LSB-first",
        "sparse_counts": false,
        "configuration": {"radius": 2, "nbits": 2048, "use_chirality": false, "use_double_fold": false}
      },
      "maccs": {
        "source": "chematic_fp::maccs",
        "representation": "bit-packed bytes",
        "bits": 166,
        "bytes": 21,
        "bit_order": "LSB-first",
        "sparse_counts": false,
        "configuration": {"keys": 166}
      },
      "topo_path": {
        "source": "chematic_fp::topo_path",
        "representation": "bit-packed bytes",
        "bits": 2048,
        "bytes": 256,
        "bit_order": "LSB-first",
        "sparse_counts": false,
        "configuration": {"min_path": 1, "max_path": 7, "include_ring_closures": true}
      },
      "torsion": {
        "source": "chematic_fp::torsion_fp",
        "representation": "bit-packed bytes",
        "bits": 2048,
        "bytes": 256,
        "bit_order": "LSB-first",
        "sparse_counts": false,
        "configuration": {"path_atoms": 4}
      },
      "rdkit_torsion": {
        "source": "chematic_fp::rdkit_torsion_fp",
        "representation": "bit-packed bytes",
        "bits": 2048,
        "bytes": 256,
        "bit_order": "LSB-first",
        "sparse_counts": false,
        "configuration": {"path_atoms": 4, "bits_per_entry": 4}
      }
    },
    "fixtures": [
