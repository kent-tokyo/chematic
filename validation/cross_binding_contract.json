      {"id": "benzene", "smiles": "c1ccccc1", "maccs_hex": "000000000000000000000000000000000000000016", "ecfp4_bits": [974, 1024, 1154], "topo_path_bits": [9, 499, 1177, 1235, 1763], "torsion_bits": [1653], "rdkit_torsion_bits": [12, 13, 14]},
      {"id": "aspirin", "smiles": "CC(=O)Oc1ccccc1C(=O)O", "maccs_hex": "0000000000000000000000010000016480cca2d21e", "ecfp4_bits": [67, 231, 259, 371, 373, 429, 464, 470, 586, 742, 844, 870, 897, 960, 974, 984, 1024, 1080, 1153, 1395, 1479, 1530, 1584, 1589, 1701, 1710, 1935, 1982, 2011], "topo_path_bits": [4, 9, 12, 68, 134, 160, 187, 303, 314, 356, 362, 408, 416, 490, 499, 512, 539, 562, 565, 599, 662, 731, 750, 789, 813, 858, 890, 901, 944, 945, 969, 983, 1040, 1055, 1172, 1177, 1229, 1235, 1328, 1355, 1392, 1482, 1510, 1518, 1551, 1584, 1611, 1679, 1728, 1729, 1754, 1763, 2013, 2023], "torsion_bits": [357, 757, 1380, 1572, 1653, 1700, 1716, 1845], "rdkit_torsion_bits": [12, 28, 48, 49, 376, 377, 408, 852, 1072, 1172, 1600, 1636, 1656, 1712, 1716, 1868, 1872, 1964]},
      {"id": "caffeine", "smiles": "Cn1cnc2c1c(=O)n(c(=O)n2C)C", "maccs_hex": "000000003000000001d414d91323915380f138ea1f", "ecfp4_bits": [88, 154, 205, 450, 558, 560, 618, 628, 792, 816, 843, 844, 848, 974, 998, 1035, 1092, 1105, 1216, 1281, 1373, 1376, 1377, 1395, 1470, 1530, 1546, 1769, 1917], "topo_path_bits": [9, 13, 62, 73, 90, 91, 114, 185, 187, 195, 201, 309, 313, 340, 350, 380, 398, 463, 479, 586, 628, 643, 645, 681, 683, 697, 707, 712, 721, 797, 800, 815, 838, 956, 958, 970, 993, 996, 1019, 1124, 1150, 1155, 1160, 1202, 1225, 1235, 1259, 1314, 1328, 1362, 1383, 1518, 1553, 1570, 1572, 1582, 1586, 1611, 1622, 1626, 1666, 1685, 1731, 1759, 1769, 1776, 1812, 1857, 1889, 1896, 1921, 1926, 1989, 1990, 2005, 2007, 2043], "torsion_bits": [469, 868, 949, 969, 984, 1176, 1380, 1449, 1720, 1961], "rdkit_torsion_bits": [304, 328, 329, 330, 392, 393, 396, 432, 448, 449, 452, 456, 457, 460, 608, 684, 704, 736, 737, 876, 1016, 1017, 1536, 1537, 1644, 1648, 1649, 1656, 1660, 1661]}
