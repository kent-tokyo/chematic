    ]
  },
  "standardization_contract": {
    "schema_version": 1,
    "profile": {
      "largest_fragment_only": true,
      "neutralize_charges": true,
      "remove_explicit_h": true,
      "canonical_tautomer": true
    },
    "semantics": "The explicit largest-fragment profile is opt-in; default standardization preserves disconnected fragments.",
    "fixtures": [
      {"id": "std-p1-holdout-01-dopamine-sulfate-threshold", "smiles": "CC(N)Cc1ccc(O)c(O)c1.OS(=O)(=O)O", "output_smiles": "Oc1c(O)ccc(c1)CC(N)C"},
      {"id": "std-p1-holdout-02-phosphoric-acid-outranks-small-amine", "smiles": "NCCO.OP(=O)(O)O", "output_smiles": "P(O)(O)(O)=O"},
