{
  "schema_version": 1,
  "profile": "rdkit_rebaseline_execution_v1",
  "sealed_accuracy_cohort_reused": false,
  "difference_classes": [
    "chematic_regression",
    "oracle_change",
    "contract_difference",
    "unresolved"
  ],
  "required_operation_ids": [
    "provenance",
    "binding_contract",
    "smiles_parse_write",
    "cip",
    "smarts",
    "morgan",
    "browser_runtime"
  ],
  "lanes": [
    {
      "id": "python-2026.03.6-distributed",
      "channel": "python_native",
      "rdkit_version": "2026.03.6",
      "corpus": "validation/benchmark_corpora/rdkit-js-browser-10k-v1.smi",
      "commands": [
        {
          "id": "python-provenance",
          "covers": ["provenance"],
          "argv": [
            "${PYTHON}",
            "scripts/collect_rdkit_rebaseline_provenance.py",
            "--python",
            "--python-wrapper-backend",
            "${PYTHON_BACKEND}",
            "--python-backend-evidence",
            "${PYTHON_BACKEND_EVIDENCE}",
            "--python-artifact",
            "${PYTHON_ARTIFACT}",
            "--corpus",
            "validation/benchmark_corpora/rdkit-js-browser-10k-v1.smi",
            "--operation-config",
            "validation/rdkit_rebaseline_execution.json",
            "--output",
            "${OUTPUT_DIR}/python-provenance.json"
          ]
        },
        {
          "id": "python-binding-contract",
          "covers": ["binding_contract"],
          "argv": [
            "${PYTHON}",
            "scripts/probe_rdkit_python_contract.py",
            "--corpus",
            "validation/benchmark_corpora/rdkit-js-browser-10k-v1.smi",
            "--output",
            "${OUTPUT_DIR}/python-binding-contract.json",
            "--expected-rdkit",
            "2026.03.6",
            "--artifact",
            "${PYTHON_ARTIFACT}",
            "--rows",
            "10000",
            "--repetitions",
            "7"
          ]
        },
        {
          "id": "python-chemistry-all",
          "covers": ["smiles_parse_write", "cip", "smarts", "morgan"],
          "argv": [
            "${PYTHON}",
            "scripts/run_rdkit_python_chemistry_lane.py",
            "--corpus",
            "validation/benchmark_corpora/rdkit-js-browser-10k-v1.smi",
            "--queries",
            "validation/rdkit_rebaseline_smarts_queries.json",
            "--output",
            "${OUTPUT_DIR}/python-chemistry-summary.json",
            "--rows-output",
            "${OUTPUT_DIR}/python-chemistry-rows.jsonl",
            "--expected-rdkit",
            "2026.03.6"
          ]
        }
      ],
      "unavailable_operations": {
        "browser_runtime": "Python/native timing is kept separate from browser runtime."
      }
    },
    {
      "id": "npm-2026.3.6-browser",
      "channel": "npm_wasm",
      "rdkit_version": "2026.03.6",
      "corpus": "validation/benchmark_corpora/rdkit-js-browser-10k-v1.smi",
      "commands": [
        {
          "id": "npm-provenance",
          "covers": ["provenance"],
          "argv": [
            "${PYTHON}",
            "scripts/collect_rdkit_rebaseline_provenance.py",
            "--npm-package",
            "${RDKIT_NPM_PACKAGE}",
            "--npm-artifact",
            "${RDKIT_NPM_ARTIFACT}",
            "--npm-runtime-version",
            "${RDKIT_NPM_RUNTIME_VERSION}",
            "--corpus",
            "validation/benchmark_corpora/rdkit-js-browser-10k-v1.smi",
            "--operation-config",
            "validation/rdkit_rebaseline_execution.json",
            "--output",
            "${OUTPUT_DIR}/npm-provenance.json"
          ]
        },
        {
          "id": "npm-morgan-parity",
          "covers": ["morgan", "binding_contract"],
          "argv": [
            "${PYTHON}",
            "scripts/check_browser_rdkit_ecfp4_parity.py",
            "--rdkit-package",
            "${RDKIT_NPM_PACKAGE}",
            "--schematic-dir",
            "${SCHEMATIC_NPM_PACKAGE}",
            "--corpus",
            "validation/benchmark_corpora/rdkit-js-browser-10k-v1.smi",
            "--rows",
            "10000",
            "--engine",
            "${BROWSER_ENGINE}",
            "--output",
            "${OUTPUT_DIR}/npm-morgan-parity.json"
          ]
        },
        {
          "id": "npm-browser-runtime",
          "covers": ["browser_runtime", "smiles_parse_write"],
          "argv": [
            "${PYTHON}",
            "scripts/bench_browser_wasm_vs_rdkit_isolated.py",
            "--rdkit-package",
            "${RDKIT_NPM_PACKAGE}",
            "--schematic-dir",
            "${SCHEMATIC_NPM_PACKAGE}",
            "--corpus",
            "validation/benchmark_corpora/rdkit-js-browser-10k-v1.smi",
            "--rows",
            "10000",
            "--engine",
            "${BROWSER_ENGINE}",
            "--fresh-processes",
            "20",
            "--output",
            "${OUTPUT_DIR}/npm-browser-runtime.json"
          ]
        }
      ],
      "unavailable_operations": {
        "cip": "No version-pinned official MinimalLib CIP lane is defined yet.",
        "smarts": "SMARTS semantics require a separate packed-output contract before timing."
      }
    }
  ]
}
