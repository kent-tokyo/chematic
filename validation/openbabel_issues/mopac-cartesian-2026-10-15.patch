diff --git a/crates/chematic-mol/src/mopac.rs b/crates/chematic-mol/src/mopac.rs
new file mode 100644
index 0000000..b24b594
--- /dev/null
+++ b/crates/chematic-mol/src/mopac.rs
@@ -0,0 +1,196 @@
+//! Checked MOPAC Cartesian geometry from the public OpenMOPAC documentation.
+//! Independently implemented; no MOPAC/Open Babel implementation code is used.
+use chematic_core::Element;
+mod reader;
+mod writer;
+pub use reader::{parse_mopac_cartesian, parse_mopac_cartesian_with_limits};
+pub use writer::write_mopac_cartesian;
+
+#[derive(Debug, Clone, Copy)]
+pub struct MopacParseLimits {
+    pub max_input_bytes: usize,
+    pub max_line_len: usize,
+    pub max_atoms: usize,
+}
+impl Default for MopacParseLimits {
+    fn default() -> Self {
+        Self {
+            max_input_bytes: 64 << 20,
+            max_line_len: 16_384,
+            max_atoms: 1_000_000,
+        }
+    }
+}
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct MopacError {
+    pub line: usize,
+    pub detail: String,
+}
+impl core::fmt::Display for MopacError {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        write!(f, "MOPAC line {}: {}", self.line, self.detail)
+    }
+}
+impl std::error::Error for MopacError {}
+fn error(line: usize, detail: impl Into<String>) -> MopacError {
+    MopacError {
+        line,
+        detail: detail.into(),
+    }
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum MopacOptimizationFlag {
+    MiniReaction,
+    Reaction,
+    Fixed,
+    Optimize,
+    MiniOptimize,
+    TurningPoint,
+}
+impl MopacOptimizationFlag {
+    pub fn code(self) -> &'static str {
+        match self {
+            Self::MiniReaction => "-2",
+            Self::Reaction => "-1",
+            Self::Fixed => "0",
+            Self::Optimize => "1",
+            Self::MiniOptimize => "2",
+            Self::TurningPoint => "T",
+        }
+    }
+    pub fn from_code(code: &str) -> Option<Self> {
+        match code {
+            "-2" => Some(Self::MiniReaction),
+            "-1" => Some(Self::Reaction),
+            "0" | "+0" => Some(Self::Fixed),
+            "1" | "+1" => Some(Self::Optimize),
+            "2" | "+2" => Some(Self::MiniOptimize),
+            "T" => Some(Self::TurningPoint),
+            _ => None,
+        }
+    }
+}
+
+#[derive(Debug, Clone, PartialEq)]
+pub struct MopacCartesianRow {
+    pub position_angstrom: [f64; 3],
+    /// None retains an unflagged three-number row, without guessing defaults.
+    pub optimization_flags: Option<[MopacOptimizationFlag; 3]>,
+}
+#[derive(Debug, Clone, PartialEq)]
+pub struct MopacAtom {
+    pub element: Element,
+    pub label: Option<String>,
+    pub row: MopacCartesianRow,
+}
+#[derive(Debug, Clone, PartialEq)]
+pub struct MopacCartesianGeometry {
+    /// Raw keyword line; no charge, spin, Hamiltonian or optimizer is inferred.
+    pub keywords: String,
+    pub title: String,
+    pub comment: String,
+    pub atoms: Vec<MopacAtom>,
+    /// Zero to three Cartesian translation vectors in source order.
+    pub translation_vectors: Vec<MopacCartesianRow>,
+    pub source_text: String,
+}
+impl MopacCartesianGeometry {
+    pub fn periodicity(&self) -> usize {
+        self.translation_vectors.len()
+    }
+    pub fn validate(&self) -> Result<(), MopacError> {
+        for (i, text) in [&self.keywords, &self.title, &self.comment]
+            .iter()
+            .enumerate()
+        {
+            if text.len() > MopacParseLimits::default().max_line_len
+                || text.chars().any(|c| c.is_control() && c != '\t')
+            {
+                return Err(error(i + 1, "header must fit a single supported line"));
+            }
+        }
+        for token in self.keywords.split_whitespace() {
+            let key = token.split('=').next().unwrap_or("").to_ascii_uppercase();
+            if key == "A0" || matches!(key.as_str(), "+" | "++" | "&") {
+                return Err(error(
+                    1,
+                    "atomic-unit input and keyword continuations are unsupported",
+                ));
+            }
+        }
+        if self.atoms.is_empty() || self.atoms.len() > MopacParseLimits::default().max_atoms {
+            return Err(error(0, "atom count outside supported limits"));
+        }
+        for atom in &self.atoms {
+            if matches!(atom.element.atomic_number(), 85 | 87 | 99) {
+                return Err(error(
+                    0,
+                    "reserved MOPAC sparkle/dummy element encoding is unsupported",
+                ));
+            }
+            if let Some(label) = &atom.label {
+                validate_label(label)?;
+            }
+            validate_row(&atom.row)?;
+        }
+        for row in &self.translation_vectors {
+            validate_row(row)?;
+        }
+        validate_vectors(&self.translation_vectors)
+    }
+}
+fn validate_label(label: &str) -> Result<(), MopacError> {
+    if !label.is_ascii()
+        || label.len() > 38
+        || label
+            .chars()
+            .any(|c| c.is_control() || c == '(' || c == ')')
+    {
+        return Err(error(
+            0,
+            "atom label must be <=38 ASCII characters without parentheses or controls",
+        ));
+    }
+    Ok(())
+}
+fn validate_row(row: &MopacCartesianRow) -> Result<(), MopacError> {
+    if row.position_angstrom.iter().any(|v| !v.is_finite()) {
+        return Err(error(0, "non-finite Cartesian coordinate"));
+    }
+    Ok(())
+}
+fn validate_vectors(vectors: &[MopacCartesianRow]) -> Result<(), MopacError> {
+    if vectors.len() > 3 {
+        return Err(error(0, "at most three translation vectors are supported"));
+    }
+    let mut normalized = [[0.; 3]; 3];
+    for (row, out) in vectors.iter().zip(&mut normalized) {
+        let v = row.position_angstrom;
+        let norm = v[0].hypot(v[1]).hypot(v[2]);
+        if !norm.is_finite() || norm <= 0. {
+            return Err(error(
+                0,
+                "translation vector must have finite positive length",
+            ));
+        }
+        for (a, b) in out.iter_mut().zip(v) {
+            *a = b / norm;
+        }
+    }
+    let [a, b, c] = normalized;
+    let cross = [
+        a[1] * b[2] - a[2] * b[1],
+        a[2] * b[0] - a[0] * b[2],
+        a[0] * b[1] - a[1] * b[0],
+    ];
+    let valid = match vectors.len() {
+        2 => cross[0].hypot(cross[1]).hypot(cross[2]) > 1e-6,
+        3 => (cross[0] * c[0] + cross[1] * c[1] + cross[2] * c[2]).abs() > 1e-6,
+        _ => true,
+    };
+    if !valid {
+        return Err(error(0, "dependent or near-dependent translation vectors"));
+    }
+    Ok(())
+}
diff --git a/crates/chematic-mol/src/mopac/reader.rs b/crates/chematic-mol/src/mopac/reader.rs
new file mode 100644
index 0000000..42eabe4
--- /dev/null
+++ b/crates/chematic-mol/src/mopac/reader.rs
@@ -0,0 +1,151 @@
+use super::*;
+
+pub fn parse_mopac_cartesian(text: &str) -> Result<MopacCartesianGeometry, MopacError> {
+    parse_mopac_cartesian_with_limits(text, &MopacParseLimits::default())
+}
+pub fn parse_mopac_cartesian_with_limits(
+    text: &str,
+    limits: &MopacParseLimits,
+) -> Result<MopacCartesianGeometry, MopacError> {
+    if text.len() > limits.max_input_bytes {
+        return Err(error(0, "input byte limit exceeded"));
+    }
+    for (i, line) in text.lines().enumerate() {
+        if line.len() > limits.max_line_len {
+            return Err(error(i + 1, "line length limit exceeded"));
+        }
+    }
+    let mut lines = text.lines();
+    let mut header = Vec::new();
+    for line in 1..=3 {
+        header.push(
+            lines
+                .next()
+                .ok_or_else(|| error(line, "three header lines are required"))?
+                .to_string(),
+        );
+    }
+    let mut g = MopacCartesianGeometry {
+        keywords: header[0].clone(),
+        title: header[1].clone(),
+        comment: header[2].clone(),
+        atoms: Vec::new(),
+        translation_vectors: Vec::new(),
+        source_text: String::new(),
+    };
+    let mut ended = false;
+    for (i, line) in lines.enumerate() {
+        let number = i + 4;
+        if line.trim().is_empty() {
+            ended = true;
+            continue;
+        }
+        if ended {
+            return Err(error(
+                number,
+                "additional sections after geometry are unsupported",
+            ));
+        }
+        let (symbol, label, body) = identity(line, number)?;
+        let row = parse_row(body, number)?;
+        if symbol == "Tv" {
+            if label.is_some() || g.translation_vectors.len() >= 3 {
+                return Err(error(number, "expected up to three unlabeled Tv records"));
+            }
+            g.translation_vectors.push(row);
+        } else {
+            if !g.translation_vectors.is_empty() {
+                return Err(error(number, "atoms cannot follow a Tv record"));
+            }
+            if g.atoms.len() >= limits.max_atoms.min(MopacParseLimits::default().max_atoms) {
+                return Err(error(number, "atom limit exceeded"));
+            }
+            let element=element(symbol).ok_or_else(|| error(number,"expected canonical element/atomic number; isotopes and dummy/sparkle encodings unsupported"))?;
+            if let Some(s) = &label {
+                validate_label(s).map_err(|e| error(number, e.detail))?;
+            }
+            g.atoms.push(MopacAtom {
+                element,
+                label,
+                row,
+            });
+        }
+    }
+    g.validate()?;
+    g.source_text = text.to_string();
+    Ok(g)
+}
+
+fn element(symbol: &str) -> Option<Element> {
+    if symbol.bytes().all(|b| b.is_ascii_digit()) {
+        return symbol
+            .parse::<u8>()
+            .ok()
+            .and_then(Element::from_atomic_number);
+    }
+    Element::from_symbol(symbol).filter(|e| e.symbol() == symbol)
+}
+
+fn identity(raw: &str, line: usize) -> Result<(&str, Option<String>, &str), MopacError> {
+    let raw = raw.trim_start();
+    let boundary = raw
+        .find(|c: char| c.is_whitespace() || c == '(')
+        .unwrap_or(raw.len());
+    let symbol = &raw[..boundary];
+    let tail = &raw[boundary..];
+    if let Some(label_tail) = tail.strip_prefix('(') {
+        let end = label_tail
+            .find(')')
+            .ok_or_else(|| error(line, "unclosed atom label"))?;
+        let label = &label_tail[..end];
+        let body = &label_tail[end + 1..];
+        if !body.starts_with(char::is_whitespace) {
+            return Err(error(line, "whitespace required after atom label"));
+        }
+        Ok((symbol, Some(label.to_string()), body))
+    } else {
+        Ok((symbol, None, tail))
+    }
+}
+
+fn number(text: &str, line: usize) -> Result<f64, MopacError> {
+    let v = text
+        .replace(['D', 'd'], "e")
+        .parse::<f64>()
+        .map_err(|_| error(line, "invalid real number"))?;
+    if !v.is_finite() {
+        return Err(error(line, "non-finite real number"));
+    }
+    Ok(v)
+}
+fn parse_row(body: &str, line: usize) -> Result<MopacCartesianRow, MopacError> {
+    let f: Vec<_> = body.split_whitespace().collect();
+    if f.len() == 3 {
+        return Ok(MopacCartesianRow {
+            position_angstrom: [
+                number(f[0], line)?,
+                number(f[1], line)?,
+                number(f[2], line)?,
+            ],
+            optimization_flags: None,
+        });
+    }
+    if f.len() != 6 {
+        return Err(error(
+            line,
+            "expected x y z or x flag y flag z flag, without connectivity/extra fields",
+        ));
+    }
+    let flag = |code| {
+        MopacOptimizationFlag::from_code(code)
+            .ok_or_else(|| error(line, "unsupported optimization flag"))
+    };
+    Ok(MopacCartesianRow {
+        position_angstrom: [
+            number(f[0], line)?,
+            number(f[2], line)?,
+            number(f[4], line)?,
+        ],
+        optimization_flags: Some([flag(f[1])?, flag(f[3])?, flag(f[5])?]),
+    })
+}
diff --git a/crates/chematic-mol/src/mopac/writer.rs b/crates/chematic-mol/src/mopac/writer.rs
