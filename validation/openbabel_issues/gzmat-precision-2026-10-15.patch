@@ -0,0 +1,130 @@
+//! Checked Cartesian-to-Z-matrix conversion and Gaussian-style output.
+//!
+//! Geometry only: references are caller-selected, zero-based, distinct earlier
+//! atoms. They need not be chemically bonded. No topology or electronic-state
+//! perception, dummy atoms, reordering, or arbitrary torsions are introduced.
+use chematic_core::Element;
+
+mod geometry;
+mod writer;
+pub use geometry::zmatrix_to_cartesian;
+pub use writer::{GzmatWriteOptions, write_gzmat};
+
+/// Hard cap keeps conversion and output linear and bounded.
+pub const MAX_ZMATRIX_ATOMS: usize = 100_000;
+/// Minimum sine of a defined angle or reference-plane angle.
+pub const ZMATRIX_MIN_SINE: f64 = 1e-10;
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ZMatrixError {
+    /// Zero-based atom row; None denotes a document/options error.
+    pub atom: Option<usize>,
+    pub detail: String,
+}
+impl core::fmt::Display for ZMatrixError {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        write!(f, "Z-matrix {:?}: {}", self.atom, self.detail)
+    }
+}
+impl std::error::Error for ZMatrixError {}
+fn error(atom: Option<usize>, detail: impl Into<String>) -> ZMatrixError {
+    ZMatrixError {
+        atom,
+        detail: detail.into(),
+    }
+}
+
+/// One row of internal coordinates; angstrom distance, degree angle/torsion.
+/// The first min(row_index, 3) earlier atoms define these values in order.
+#[derive(Debug, Clone, PartialEq)]
+pub struct ZMatrixRow {
+    pub element: Element,
+    pub references: Vec<usize>,
+    pub values: Vec<f64>,
+}
+
+fn validate_references(row: usize, references: &[usize]) -> Result<(), ZMatrixError> {
+    if references.len() != row.min(3) {
+        return Err(error(Some(row), "expected min(row_index, 3) references"));
+    }
+    for (k, &reference) in references.iter().enumerate() {
+        if reference >= row || references[..k].contains(&reference) {
+            return Err(error(
+                Some(row),
+                "references must be distinct earlier atoms",
+            ));
+        }
+    }
+    Ok(())
+}
+
+/// Validate publicly mutable rows, including ranges and reference structure.
+pub fn validate_zmatrix(rows: &[ZMatrixRow]) -> Result<(), ZMatrixError> {
+    validate_count(rows.len())?;
+    for (i, row) in rows.iter().enumerate() {
+        validate_references(i, &row.references)?;
+        if row.values.len() != row.references.len() {
+            return Err(error(Some(i), "reference and value counts differ"));
+        }
+        validate_values(i, &row.values)?;
+    }
+    Ok(())
+}
+fn validate_count(count: usize) -> Result<(), ZMatrixError> {
+    if count == 0 || count > MAX_ZMATRIX_ATOMS {
+        return Err(error(None, "atom count must be 1..=100000"));
+    }
+    Ok(())
+}
+fn validate_values(i: usize, values: &[f64]) -> Result<(), ZMatrixError> {
+    if values.iter().any(|v| !v.is_finite()) {
+        return Err(error(Some(i), "non-finite internal coordinate"));
+    }
+    if values.first().is_some_and(|v| *v <= 0.0) {
+        return Err(error(Some(i), "distance must be positive"));
+    }
+    if values
+        .get(1)
+        .is_some_and(|v| *v <= 0.0 || *v >= 180.0 || v.to_radians().sin() <= ZMATRIX_MIN_SINE)
+    {
+        return Err(error(Some(i), "angle is linear or near-linear"));
+    }
+    if values.get(2).is_some_and(|v| !(-180.0..=180.0).contains(v)) {
+        return Err(error(Some(i), "torsion must be in [-180,180] degrees"));
+    }
+    Ok(())
+}
+
+/// Convert indexed Cartesian angstrom coordinates without choosing a frame.
+/// Undefined/near-linear planes fail instead of receiving an arbitrary torsion.
+/// At most three references per atom; all work and memory are O(atom count).
+pub fn cartesian_to_zmatrix(
+    elements: &[Element],
+    positions_angstrom: &[[f64; 3]],
+    references: &[Vec<usize>],
+) -> Result<Vec<ZMatrixRow>, ZMatrixError> {
+    validate_count(elements.len())?;
+    if elements.len() != positions_angstrom.len() || elements.len() != references.len() {
+        return Err(error(
+            None,
+            "element, position and reference row counts must match",
+        ));
+    }
+    for (i, p) in positions_angstrom.iter().enumerate() {
+        if p.iter().any(|v| !v.is_finite()) {
+            return Err(error(Some(i), "non-finite Cartesian coordinate"));
+        }
+        validate_references(i, &references[i])?;
+    }
+    let mut rows = Vec::with_capacity(elements.len());
+    for (i, &element) in elements.iter().enumerate() {
+        let values = geometry::internal_values(i, positions_angstrom, &references[i])?;
+        validate_values(i, &values)?;
+        rows.push(ZMatrixRow {
+            element,
+            references: references[i].clone(),
+            values,
+        });
+    }
+    Ok(rows)
+}
diff --git a/crates/chematic-mol/src/gzmat/geometry.rs b/crates/chematic-mol/src/gzmat/geometry.rs
new file mode 100644
index 0000000..3e03a8f
--- /dev/null
+++ b/crates/chematic-mol/src/gzmat/geometry.rs
@@ -0,0 +1,118 @@
+use super::{ZMATRIX_MIN_SINE, ZMatrixError, error};
+
+type V = [f64; 3];
+fn sub(a: V, b: V) -> V {
+    [a[0] - b[0], a[1] - b[1], a[2] - b[2]]
+}
+fn scale(a: V, s: f64) -> V {
+    [a[0] * s, a[1] * s, a[2] * s]
+}
+fn dot(a: V, b: V) -> f64 {
+    a[0] * b[0] + a[1] * b[1] + a[2] * b[2]
+}
+fn cross(a: V, b: V) -> V {
+    [
+        a[1] * b[2] - a[2] * b[1],
+        a[2] * b[0] - a[0] * b[2],
+        a[0] * b[1] - a[1] * b[0],
+    ]
+}
+fn norm(v: V) -> f64 {
+    v[0].hypot(v[1]).hypot(v[2])
+}
+fn direction(i: usize, a: V, b: V) -> Result<(V, f64), ZMatrixError> {
+    let delta = sub(a, b);
+    let length = norm(delta);
+    if !length.is_finite() || length <= 0.0 {
+        return Err(error(
+            Some(i),
+            "coincident reference or overflowing distance",
+        ));
+    }
+    // Divide componentwise: computing 1/length first can overflow for tiny values.
+    Ok((
+        [delta[0] / length, delta[1] / length, delta[2] / length],
+        length,
+    ))
+}
+
+pub(super) fn internal_values(i: usize, p: &[V], r: &[usize]) -> Result<Vec<f64>, ZMatrixError> {
+    if r.is_empty() {
+        return Ok(Vec::new());
+    }
+    let (u, distance) = direction(i, p[i], p[r[0]])?;
+    let mut values = vec![distance];
+    if r.len() == 1 {
+        return Ok(values);
+    }
+    let (axis, _) = direction(i, p[r[1]], p[r[0]])?;
+    let sine = norm(cross(u, axis));
+    if sine <= ZMATRIX_MIN_SINE {
+        return Err(error(Some(i), "angle is linear or near-linear"));
+    }
+    values.push(sine.atan2(dot(u, axis)).to_degrees());
+    if r.len() == 2 {
+        return Ok(values);
+    }
+    let (w, _) = direction(i, p[r[2]], p[r[1]])?;
+    if norm(cross(axis, w)) <= ZMATRIX_MIN_SINE {
+        return Err(error(Some(i), "reference plane is linear or near-linear"));
+    }
+    let v0 = sub(u, scale(axis, dot(u, axis)));
+    let v2 = sub(w, scale(axis, dot(w, axis)));
+    values.push(dot(cross(axis, v0), v2).atan2(dot(v0, v2)).to_degrees());
+    Ok(values)
+}
+
+/// Reconstruct a canonical Cartesian frame (angstroms), preserving handedness.
+/// Absolute translation and rotation are not part of an internal-coordinate set.
+pub fn zmatrix_to_cartesian(rows: &[super::ZMatrixRow]) -> Result<Vec<V>, ZMatrixError> {
+    super::validate_zmatrix(rows)?;
+    let mut positions = Vec::with_capacity(rows.len());
+    for (i, row) in rows.iter().enumerate() {
+        let position = place_row(i, row, &positions)?;
+        if position.iter().any(|v| !v.is_finite()) {
+            return Err(error(Some(i), "reconstructed coordinate overflows"));
+        }
+        positions.push(position);
+    }
+    Ok(positions)
+}
+fn place_row(i: usize, row: &super::ZMatrixRow, p: &[V]) -> Result<V, ZMatrixError> {
+    if i == 0 {
+        return Ok([0.0; 3]);
+    }
+    let a = p[row.references[0]];
+    let distance = row.values[0];
+    if i == 1 {
+        return Ok([a[0], a[1], a[2] + distance]);
+    }
+    let b = p[row.references[1]];
+    let (axis, _) = direction(i, b, a)?;
+    let perpendicular = if i == 2 {
+        let basis = if axis[0].abs() < 0.9 {
+            [1.0, 0.0, 0.0]
+        } else {
+            [0.0, 1.0, 0.0]
+        };
+        sub(basis, scale(axis, dot(basis, axis)))
+    } else {
+        let (w, _) = direction(i, p[row.references[2]], b)?;
+        sub(w, scale(axis, dot(w, axis)))
+    };
+    let length = norm(perpendicular);
+    if length <= ZMATRIX_MIN_SINE {
+        return Err(error(Some(i), "reference plane is linear or near-linear"));
+    }
+    let e2 = scale(perpendicular, 1.0 / length);
+    let e3 = cross(axis, e2);
+    let angle = row.values[1].to_radians();
+    let torsion = row.values.get(2).copied().unwrap_or(0.0).to_radians();
+    let mut result = [0.0; 3];
+    for k in 0..3 {
+        let unit =
+            angle.cos() * axis[k] + angle.sin() * (torsion.cos() * e2[k] - torsion.sin() * e3[k]);
+        result[k] = a[k] + distance * unit;
+    }
+    Ok(result)
+}
diff --git a/crates/chematic-mol/src/gzmat/writer.rs b/crates/chematic-mol/src/gzmat/writer.rs
new file mode 100644
index 0000000..88361d6
--- /dev/null
+++ b/crates/chematic-mol/src/gzmat/writer.rs
@@ -0,0 +1,132 @@
+use super::{ZMatrixError, ZMatrixRow, error, validate_values, validate_zmatrix};
+
+/// Explicit electronic state, single-line header fields and decimal precision.
+/// The route defaults to a template marker (#); supply calculation keywords
+/// before submitting a job. No method, charge or multiplicity is inferred.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct GzmatWriteOptions {
+    pub charge: i32,
+    pub multiplicity: u32,
+    /// 1..=17 significant decimal digits, in scientific notation.
+    /// 17 preserves the computed f64 internal values on parsing.
+    pub significant_digits: u8,
+    pub title: String,
+    pub route: String,
+}
+impl GzmatWriteOptions {
+    pub fn new(charge: i32, multiplicity: u32) -> Self {
+        Self {
+            charge,
+            multiplicity,
+            significant_digits: 17,
+            title: "chematic internal coordinates".into(),
+            route: "#".into(),
+        }
+    }
+    fn validate(&self) -> Result<(), ZMatrixError> {
+        if !(1..=17).contains(&self.significant_digits) {
+            return Err(error(None, "significant_digits must be 1..=17"));
+        }
+        if self.multiplicity == 0 {
+            return Err(error(None, "multiplicity must be positive"));
+        }
+        for value in [&self.title, &self.route] {
+            if value.trim().is_empty() || value.len() > 1024 || value.chars().any(char::is_control)
+            {
+                return Err(error(
+                    None,
+                    "header fields must be nonempty single lines of at most 1024 bytes",
+                ));
+            }
+        }
+        if !self.route.starts_with('#') {
+            return Err(error(None, "Gaussian route must start with #"));
+        }
+        Ok(())
+    }
+}
+
+fn formatted_values(i: usize, row: &ZMatrixRow, digits: u8) -> Result<Vec<String>, ZMatrixError> {
+    let values: Vec<String> = row
+        .values
+        .iter()
+        .map(|v| {
+            // Normalize negative zero without changing a nonzero signed torsion.
+            let v = if *v == 0.0 { 0.0 } else { *v };
+            format!("{:.*e}", usize::from(digits) - 1, v)
+        })
+        .collect();
+    let rounded: Vec<f64> = values
+        .iter()
+        .map(|s| {
+            s.parse::<f64>()
+                .map_err(|_| error(Some(i), "formatted value is invalid"))
+        })
+        .collect::<Result<_, _>>()?;
+    // A low-precision request must not silently turn a valid angle into 180.
+    validate_values(i, &rounded)?;
+    Ok(values)
+}
+
+fn rounded_values(rows: &[ZMatrixRow], digits: u8) -> Result<Vec<Vec<String>>, ZMatrixError> {
+    let formatted = rows
+        .iter()
+        .enumerate()
+        .map(|(i, row)| formatted_values(i, row, digits))
+        .collect::<Result<Vec<_>, _>>()?;
+    let rounded = rows
+        .iter()
+        .zip(&formatted)
+        .enumerate()
+        .map(|(i, (row, values))| {
+            let values = values
+                .iter()
+                .map(|v| {
+                    v.parse::<f64>()
+                        .map_err(|_| error(Some(i), "formatted value is invalid"))
+                })
+                .collect::<Result<_, _>>()?;
+            Ok(ZMatrixRow {
+                element: row.element,
+                references: row.references.clone(),
+                values,
+            })
+        })
+        .collect::<Result<Vec<_>, ZMatrixError>>()?;
+    // Also check that rounding did not collapse an earlier reference plane.
+    super::zmatrix_to_cartesian(&rounded)?;
+    Ok(formatted)
+}
+
+/// Emit a Gaussian-style Z-matrix with independent r/a/d variables per atom.
+/// Serializes references one-based; does not emit bonds, isotopes or periodicity.
+/// Rounding that destroys a defined coordinate is rejected.
+pub fn write_gzmat(
+    rows: &[ZMatrixRow],
+    options: &GzmatWriteOptions,
+) -> Result<String, ZMatrixError> {
+    options.validate()?;
+    validate_zmatrix(rows)?;
+    let formatted = rounded_values(rows, options.significant_digits)?;
+    let mut output = format!(
+        "{}\n\n{}\n\n{} {}\n",
+        options.route, options.title, options.charge, options.multiplicity
+    );
+    let mut variables = String::new();
+    for (i, row) in rows.iter().enumerate() {
+        let values = &formatted[i];
+        output.push_str(row.element.symbol());
+        for (k, (&reference, value)) in row.references.iter().zip(values).enumerate() {
+            let name = format!("{}{}", ['r', 'a', 'd'][k], i + 1);
+            output.push_str(&format!(" {} {}", reference + 1, name));
+            variables.push_str(&format!("{name}= {value}\n"));
+        }
+        output.push('\n');
+    }
+    if !variables.is_empty() {
+        output.push_str("Variables:\n");
+        output.push_str(&variables);
+    }
+    output.push('\n');
+    Ok(output)
+}
