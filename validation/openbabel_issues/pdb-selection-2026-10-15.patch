diff --git a/crates/chematic-mol/src/pdb_selection.rs b/crates/chematic-mol/src/pdb_selection.rs
new file mode 100644
index 0000000..f4f2f48
--- /dev/null
+++ b/crates/chematic-mol/src/pdb_selection.rs
@@ -0,0 +1,146 @@
+//! Identity-preserving single-model PDB coordinate selection (Open Babel #2481).
+//! Independently implemented from wwPDB 3.3; no residue or bond perception.
+use std::collections::HashMap;
+mod reader;
+mod writer;
+
+#[derive(Debug, Clone, Copy)]
+pub struct PdbSelectionLimits {
+    pub max_input_bytes: usize,
+    pub max_line_len: usize,
+    pub max_atoms: usize,
+    pub max_records: usize,
+}
+impl Default for PdbSelectionLimits {
+    fn default() -> Self {
+        Self {
+            max_input_bytes: 64 << 20,
+            max_line_len: 1024,
+            max_atoms: 99_999,
+            max_records: 1_000_000,
+        }
+    }
+}
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct PdbSelectionError {
+    pub line: usize,
+    pub detail: String,
+}
+impl core::fmt::Display for PdbSelectionError {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        write!(f, "PDB selection line {}: {}", self.line, self.detail)
+    }
+}
+impl std::error::Error for PdbSelectionError {}
+fn error(line: usize, detail: impl Into<String>) -> PdbSelectionError {
+    PdbSelectionError {
+        line,
+        detail: detail.into(),
+    }
+}
+fn reserve<T>(v: &mut Vec<T>, n: usize) -> Result<(), PdbSelectionError> {
+    v.try_reserve(n)
+        .map_err(|e| error(0, format!("selection allocation failed: {e}")))
+}
+
+#[derive(Debug, Clone, PartialEq)]
+pub struct PdbSelectedAtom {
+    pub source_index: usize,
+    pub serial: u32,
+    pub record_type: String,
+    pub atom_name: String,
+    pub alt_loc: char,
+    pub residue_name: String,
+    pub chain_id: char,
+    pub residue_number: i32,
+    pub insertion_code: char,
+    pub position_angstrom: [f64; 3],
+}
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct PdbSelectionLoss {
+    pub line: usize,
+    pub record_name: String,
+}
+#[derive(Debug, Clone, PartialEq)]
+pub struct PdbSelectionReport {
+    pub pdb: String,
+    pub source_text: String,
+    pub source_atom_count: usize,
+    pub selected_source_indices: Vec<usize>,
+    pub old_to_new: Vec<Option<usize>>,
+    pub atoms: Vec<PdbSelectedAtom>,
+    pub losses: Vec<PdbSelectionLoss>,
+    pub retargeted_ter_lines: Vec<usize>,
+    pub filtered_conect_lines: Vec<usize>,
+    pub model_num: Option<u32>,
+}
+enum Kind {
+    Atom(usize),
+    Anisou(usize),
+    Ter(u32),
+    Conect(Vec<u32>),
+    Model,
+    EndModel,
+    End,
+}
+struct Row<'a> {
+    line: usize,
+    text: &'a str,
+    kind: Kind,
+}
+struct Document<'a> {
+    rows: Vec<Row<'a>>,
+    atom_lines: Vec<&'a str>,
+    atoms: Vec<chematic_3d::pdb::PdbAtom>,
+    by_serial: HashMap<u32, usize>,
+    losses: Vec<PdbSelectionLoss>,
+    model_num: Option<u32>,
+}
+
+/// Select zero-based source ATOM/HETATM rows. None keeps all, [] keeps none.
+/// Output stays in source order regardless of index-list order; duplicates fail.
+/// Atom/ANISOU line contents and serials are retained without inference. Unknown
+/// records require explicit metadata-loss consent and remain in source_text.
+pub fn select_pdb_atoms(
+    text: &str,
+    indices: Option<&[usize]>,
+    allow_metadata_loss: bool,
+) -> Result<PdbSelectionReport, PdbSelectionError> {
+    select_pdb_atoms_with_limits(
+        text,
+        indices,
+        allow_metadata_loss,
+        &PdbSelectionLimits::default(),
+    )
+}
+pub fn select_pdb_atoms_with_limits(
+    text: &str,
+    indices: Option<&[usize]>,
+    allow_metadata_loss: bool,
+    limits: &PdbSelectionLimits,
+) -> Result<PdbSelectionReport, PdbSelectionError> {
+    if indices.is_some_and(|v| {
+        v.len()
+            > limits
+                .max_atoms
+                .min(PdbSelectionLimits::default().max_atoms)
+    }) {
+        return Err(error(0, "selection count exceeds atom limit"));
+    }
+    let doc = reader::read(text, allow_metadata_loss, limits)?;
+    let mut selected = Vec::new();
+    reserve(&mut selected, doc.atoms.len())?;
+    selected.resize(doc.atoms.len(), indices.is_none());
+    if let Some(indices) = indices {
+        for &i in indices {
+            let entry = selected
+                .get_mut(i)
+                .ok_or_else(|| error(0, format!("atom index {i} outside source atom range")))?;
+            if *entry {
+                return Err(error(0, "duplicate selected atom index"));
+            }
+            *entry = true;
+        }
+    }
+    writer::select(text, &doc, &selected)
+}
diff --git a/crates/chematic-mol/src/pdb_selection/reader.rs b/crates/chematic-mol/src/pdb_selection/reader.rs
new file mode 100644
index 0000000..92c7ec9
--- /dev/null
+++ b/crates/chematic-mol/src/pdb_selection/reader.rs
@@ -0,0 +1,333 @@
+use super::*;
+use std::collections::HashSet;
+
+struct State {
+    model: bool,
+    closed: bool,
+    ended: bool,
+    connect: bool,
+    last: Option<usize>,
+    anisou: HashSet<u32>,
+}
+
+pub(super) fn read<'a>(
+    text: &'a str,
+    allow_loss: bool,
+    limits: &PdbSelectionLimits,
+) -> Result<Document<'a>, PdbSelectionError> {
+    check_limits(text, limits)?;
+    let hard = PdbSelectionLimits::default();
+    let atoms = chematic_3d::pdb::parse_pdb_atoms_strict(
+        text,
+        &chematic_3d::pdb::PdbParseLimits {
+            max_input_bytes: limits.max_input_bytes.min(hard.max_input_bytes),
+            max_line_bytes: limits.max_line_len.min(hard.max_line_len),
+            max_atoms: limits.max_atoms.min(hard.max_atoms),
+            max_models: 1,
+        },
+    )
+    .map_err(|e| match e {
+        chematic_3d::pdb::PdbStrictError::Parse(ref p) => error(p.line, e.to_string()),
+        _ => error(0, e.to_string()),
+    })?;
+    let mut doc = Document {
+        rows: Vec::new(),
+        atom_lines: Vec::new(),
+        atoms,
+        by_serial: HashMap::new(),
+        losses: Vec::new(),
+        model_num: None,
+    };
+    let mut state = State {
+        model: false,
+        closed: false,
+        ended: false,
+        connect: false,
+        last: None,
+        anisou: HashSet::new(),
+    };
+    for (i, line) in text.lines().enumerate() {
+        if line.trim().is_empty() {
+            continue;
+        }
+        let number = i + 1;
+        if state.ended {
+            return Err(error(number, "records after END are unsupported"));
+        }
+        let name = line.get(..6).unwrap_or(line).trim_end();
+        let kind = match name {
+            "ATOM" | "HETATM" => Kind::Atom(atom(&mut doc, &mut state, line, number)?),
+            "ANISOU" => Kind::Anisou(anisou(&doc, &mut state, line, number)?),
+            "TER" => Kind::Ter(ter(&doc, &mut state, line, number)?),
+            "CONECT" => {
+                if state.model {
+                    return Err(error(number, "CONECT must follow ENDMDL"));
+                }
+                state.connect = true;
+                Kind::Conect(conect(line, number)?)
+            }
+            "MODEL" => {
+                model(&mut doc, &mut state, line, number)?;
+                Kind::Model
+            }
+            "ENDMDL" => {
+                if !state.model {
+                    return Err(error(number, "unmatched ENDMDL"));
+                }
+                state.model = false;
+                state.closed = true;
+                state.last = None;
+                Kind::EndModel
+            }
+            "END" => {
+                if state.model {
+                    return Err(error(number, "MODEL lacks ENDMDL"));
+                }
+                state.ended = true;
+                Kind::End
+            }
+            _ => {
+                if !allow_loss {
+                    return Err(error(
+                        number,
+                        format!(
+                            "record {name:?} outside coordinate selection contract; metadata-loss consent required"
+                        ),
+                    ));
+                }
+                reserve(&mut doc.losses, 1)?;
+                doc.losses.push(PdbSelectionLoss {
+                    line: number,
+                    record_name: name.to_string(),
+                });
+                continue;
+            }
+        };
+        reserve(&mut doc.rows, 1)?;
+        doc.rows.push(Row {
+            line: number,
+            text: line,
+            kind,
+        });
+    }
+    if state.model {
+        return Err(error(0, "MODEL lacks ENDMDL"));
+    }
+    check_references(&doc)?;
+    Ok(doc)
+}
+
+fn check_limits(text: &str, limits: &PdbSelectionLimits) -> Result<(), PdbSelectionError> {
+    let hard = PdbSelectionLimits::default();
+    if text.len() > limits.max_input_bytes.min(hard.max_input_bytes) {
+        return Err(error(0, "input byte limit exceeded"));
+    }
+    for (i, line) in text.lines().enumerate() {
+        if i >= limits.max_records.min(hard.max_records) {
+            return Err(error(i + 1, "record count limit exceeded"));
+        }
+        if line.len() > limits.max_line_len.min(hard.max_line_len) {
+            return Err(error(i + 1, "line length limit exceeded"));
+        }
+        if line.bytes().any(|b| !(b' '..=b'~').contains(&b)) {
+            return Err(error(
+                i + 1,
+                "PDB records must use printable ASCII and spaces",
+            ));
+        }
+    }
+    Ok(())
+}
+fn serial(line: &str, number: usize) -> Result<u32, PdbSelectionError> {
+    line.get(6..11)
+        .and_then(|s| s.trim().parse::<u32>().ok())
+        .filter(|v| *v > 0 && *v <= 99_999)
+        .ok_or_else(|| error(number, "invalid positive decimal serial"))
+}
+fn coordinate_phase(state: &State, number: usize) -> Result<(), PdbSelectionError> {
+    if state.closed || state.connect {
+        return Err(error(
+            number,
+            "coordinate record outside single-model coordinate block",
+        ));
+    }
+    Ok(())
+}
+fn atom<'a>(
+    doc: &mut Document<'a>,
+    state: &mut State,
+    line: &'a str,
+    number: usize,
+) -> Result<usize, PdbSelectionError> {
+    coordinate_phase(state, number)?;
+    if line.len() > 80 && !line[80..].trim().is_empty() {
+        return Err(error(number, "extra atom fields after column 80"));
+    }
+    if line.get(12..16).is_none_or(|s| s.trim().is_empty())
+        || line.get(17..20).is_none_or(|s| s.trim().is_empty())
+    {
+        return Err(error(number, "atom and residue names are required"));
+    }
+    for (start, end) in [(54, 60), (60, 66)] {
+        if let Some(s) = line.get(start..end) {
+            if !s.trim().is_empty() && !s.trim().parse::<f64>().is_ok_and(f64::is_finite) {
+                return Err(error(number, "invalid occupancy or temperature factor"));
+            }
+        } else if line.get(start..).is_some_and(|s| !s.trim().is_empty()) {
+            return Err(error(
+                number,
+                "incomplete occupancy or temperature factor field",
+            ));
+        }
+    }
+    let serial = serial(line, number)?;
+    let index = doc.atom_lines.len();
+    doc.by_serial
+        .try_reserve(1)
+        .map_err(|e| error(number, format!("serial allocation failed: {e}")))?;
+    if doc.by_serial.insert(serial, index).is_some() {
+        return Err(error(number, "duplicate atom serial"));
+    }
+    reserve(&mut doc.atom_lines, 1)?;
+    doc.atom_lines.push(line);
+    state.last = Some(index);
+    Ok(index)
+}
+fn anisou(
+    doc: &Document<'_>,
+    state: &mut State,
+    line: &str,
+    number: usize,
+) -> Result<usize, PdbSelectionError> {
+    coordinate_phase(state, number)?;
+    let serial = serial(line, number)?;
+    let index = *doc
+        .by_serial
+        .get(&serial)
+        .ok_or_else(|| error(number, "ANISOU must follow its atom record"))?;
+    if line.get(6..27) != doc.atom_lines[index].get(6..27) {
+        return Err(error(number, "ANISOU identity disagrees with atom"));
+    }
+    for start in (28..70).step_by(7) {
+        if line
+            .get(start..start + 7)
+            .and_then(|s| s.trim().parse::<i32>().ok())
+            .is_none()
+        {
+            return Err(error(number, "invalid ANISOU tensor field"));
+        }
+    }
+    if line.len() > 80 && !line[80..].trim().is_empty() {
+        return Err(error(number, "extra ANISOU fields"));
+    }
+    state
+        .anisou
+        .try_reserve(1)
+        .map_err(|e| error(number, format!("ANISOU allocation failed: {e}")))?;
+    if !state.anisou.insert(serial) {
+        return Err(error(number, "duplicate ANISOU record"));
+    }
+    Ok(index)
+}
+fn ter(
+    doc: &Document<'_>,
+    state: &mut State,
+    line: &str,
+    number: usize,
+) -> Result<u32, PdbSelectionError> {
+    coordinate_phase(state, number)?;
+    let serial = serial(line, number)?;
+    let index = state
+        .last
+        .ok_or_else(|| error(number, "TER has no preceding segment"))?;
+    if line.get(17..27).is_none() || line.get(17..27) != doc.atom_lines[index].get(17..27) {
+        return Err(error(number, "TER residue disagrees with preceding atom"));
+    }
+    if doc.atoms[index].serial.checked_add(1) != Some(serial) {
+        return Err(error(
+            number,
+            "TER serial must follow the terminal atom serial",
+        ));
+    }
+    state.last = None;
+    Ok(serial)
+}
+fn model(
+    doc: &mut Document<'_>,
+    state: &mut State,
+    line: &str,
+    number: usize,
+) -> Result<(), PdbSelectionError> {
+    if doc.model_num.is_some() || !doc.atom_lines.is_empty() || state.connect {
+        return Err(error(
+            number,
+            "only one complete explicit model or one implicit model is supported",
+        ));
+    }
+    let id = line
+        .get(10..14)
+        .and_then(|s| s.trim().parse::<u32>().ok())
+        .filter(|v| *v > 0)
+        .ok_or_else(|| error(number, "invalid MODEL number"))?;
+    doc.model_num = Some(id);
+    state.model = true;
+    Ok(())
+}
+fn conect(line: &str, number: usize) -> Result<Vec<u32>, PdbSelectionError> {
+    if line.len() > 31 && !line[31..].trim().is_empty() {
+        return Err(error(
+            number,
+            "legacy CONECT fields beyond four covalent neighbors are unsupported",
+        ));
+    }
+    let mut values = Vec::new();
+    for start in (6..31).step_by(5) {
+        let field = line.get(start..line.len().min(start + 5)).unwrap_or("");
+        if field.trim().is_empty() {
+            continue;
+        }
+        let value = field
+            .trim()
+            .parse::<u32>()
+            .ok()
+            .filter(|v| *v > 0 && *v <= 99_999)
+            .ok_or_else(|| error(number, "invalid CONECT serial"))?;
+        reserve(&mut values, 1)?;
+        values.push(value);
+    }
+    if values.is_empty() {
+        return Err(error(number, "CONECT source is required"));
+    }
+    // Source must occupy its fixed field even if later fields are populated.
+    if serial(line, number)? != values[0] {
+        return Err(error(number, "invalid CONECT source"));
+    }
+    Ok(values)
+}
+fn check_references(doc: &Document<'_>) -> Result<(), PdbSelectionError> {
+    let mut ter_serials = HashSet::new();
+    for row in &doc.rows {
+        if let Kind::Ter(serial) = row.kind {
+            ter_serials
+                .try_reserve(1)
+                .map_err(|e| error(row.line, format!("TER allocation failed: {e}")))?;
+            if doc.by_serial.contains_key(&serial) || !ter_serials.insert(serial) {
+                return Err(error(
+                    row.line,
+                    "TER serial collides with another coordinate record",
+                ));
+            }
+        }
+        if let Kind::Conect(values) = &row.kind {
+            for &serial in values {
+                if !doc.by_serial.contains_key(&serial) {
+                    return Err(error(row.line, "CONECT refers to an unknown atom serial"));
+                }
+            }
+            if values[1..].contains(&values[0]) {
+                return Err(error(row.line, "self CONECT reference"));
+            }
+        }
+    }
+    Ok(())
+}
diff --git a/crates/chematic-mol/src/pdb_selection/writer.rs b/crates/chematic-mol/src/pdb_selection/writer.rs
new file mode 100644
index 0000000..e14b0a9
--- /dev/null
+++ b/crates/chematic-mol/src/pdb_selection/writer.rs
@@ -0,0 +1,170 @@
+use super::*;
+use std::collections::HashSet;
+
+pub(super) fn select(
+    text: &str,
+    doc: &Document<'_>,
+    keep: &[bool],
+) -> Result<PdbSelectionReport, PdbSelectionError> {
+    let mut report = PdbSelectionReport {
+        pdb: String::new(),
+        source_text: String::new(),
+        source_atom_count: keep.len(),
+        selected_source_indices: Vec::new(),
+        old_to_new: Vec::new(),
+        atoms: Vec::new(),
+        losses: doc.losses.clone(),
+        retargeted_ter_lines: Vec::new(),
+        filtered_conect_lines: Vec::new(),
+        model_num: doc.model_num,
+    };
+    reserve(&mut report.old_to_new, keep.len())?;
+    report.old_to_new.resize(keep.len(), None);
+    for (i, &selected) in keep.iter().enumerate() {
+        if selected {
+            report.old_to_new[i] = Some(report.atoms.len());
+            reserve(&mut report.atoms, 1)?;
+            report.atoms.push(identity(doc, i));
+            reserve(&mut report.selected_source_indices, 1)?;
+            report.selected_source_indices.push(i);
+        }
+    }
+    let mut last = None;
+    let mut ter_serials = HashSet::new();
+    for row in &doc.rows {
+        match &row.kind {
+            Kind::Atom(i) => {
+                if keep[*i] {
+                    append(&mut report.pdb, row.text)?;
+                    last = Some(*i);
+                }
+            }
+            Kind::Anisou(i) => {
+                if keep[*i] {
+                    append(&mut report.pdb, row.text)?;
+                }
+            }
+            Kind::Ter(_) => {
+                if let Some(i) = last {
+                    write_ter(&mut report, row, doc, i, &mut ter_serials)?;
+                }
+                last = None;
+            }
+            Kind::Conect(values) => write_conect(&mut report, row, values, doc, keep)?,
+            Kind::Model | Kind::EndModel => {
+                if !report.atoms.is_empty() {
+                    append(&mut report.pdb, row.text)?;
+                }
+                last = None;
+            }
+            Kind::End => {}
+        }
+    }
+    append(&mut report.pdb, "END")?;
+    report.source_text = text.to_string();
+    Ok(report)
+}
+fn append(out: &mut String, line: &str) -> Result<(), PdbSelectionError> {
+    let n = out
+        .len()
+        .checked_add(line.len())
+        .and_then(|n| n.checked_add(1))
+        .ok_or_else(|| error(0, "output size overflow"))?;
+    if n > PdbSelectionLimits::default().max_input_bytes {
+        return Err(error(0, "output byte limit exceeded"));
+    }
+    out.try_reserve(line.len() + 1)
+        .map_err(|e| error(0, format!("output allocation failed: {e}")))?;
+    out.push_str(line);
+    out.push('\n');
+    Ok(())
+}
+fn identity(doc: &Document<'_>, i: usize) -> PdbSelectedAtom {
+    let a = &doc.atoms[i];
+    let line = doc.atom_lines[i];
+    PdbSelectedAtom {
+        source_index: i,
+        serial: a.serial,
+        record_type: line[..6].trim_end().into(),
+        atom_name: a.name.clone(),
+        alt_loc: line.as_bytes()[16] as char,
+        residue_name: a.res_name.clone(),
+        chain_id: a.chain_id,
+        residue_number: a.res_seq,
+        insertion_code: line.as_bytes()[26] as char,
+        position_angstrom: [a.x, a.y, a.z],
+    }
+}
+fn write_ter(
+    report: &mut PdbSelectionReport,
+    row: &Row<'_>,
+    doc: &Document<'_>,
+    index: usize,
+    used: &mut HashSet<u32>,
+) -> Result<(), PdbSelectionError> {
+    let atom = doc.atom_lines[index];
+    let serial = doc.atoms[index]
+        .serial
+        .checked_add(1)
+        .filter(|v| *v <= 99_999)
+        .ok_or_else(|| error(row.line, "selected TER serial overflows PDB width"))?;
+    if doc
+        .by_serial
+        .get(&serial)
+        .is_some_and(|&i| report.old_to_new[i].is_some())
+    {
+        return Err(error(
+            row.line,
+            "selected TER serial collides with a retained atom",
+        ));
+    }
+    used.try_reserve(1)
+        .map_err(|e| error(row.line, format!("TER allocation failed: {e}")))?;
+    if !used.insert(serial) {
+        return Err(error(row.line, "selected TER serial collision"));
+    }
+    let original = match row.kind {
+        Kind::Ter(v) => v,
+        _ => return Err(error(row.line, "expected TER record")),
+    };
+    if original == serial && row.text.get(17..27) == atom.get(17..27) {
+        return append(&mut report.pdb, row.text);
+    }
+    let line = format!(
+        "TER   {serial:5}{}{}{}",
+        &row.text[11..17],
+        &atom[17..27],
+        &row.text[27..]
+    );
+    reserve(&mut report.retargeted_ter_lines, 1)?;
+    report.retargeted_ter_lines.push(row.line);
+    append(&mut report.pdb, &line)
+}
+fn write_conect(
+    report: &mut PdbSelectionReport,
+    row: &Row<'_>,
+    values: &[u32],
+    doc: &Document<'_>,
+    keep: &[bool],
+) -> Result<(), PdbSelectionError> {
+    // Reader verified every serial exists; use checked lookup to keep failure explicit.
+    let selected = |serial: &u32| doc.by_serial.get(serial).is_some_and(|&i| keep[i]);
+    let targets: Vec<_> = values[1..]
+        .iter()
+        .filter(|s| selected(s))
+        .copied()
+        .collect();
+    if selected(&values[0]) && targets.len() == values.len() - 1 {
+        return append(&mut report.pdb, row.text);
+    }
+    reserve(&mut report.filtered_conect_lines, 1)?;
+    report.filtered_conect_lines.push(row.line);
+    if !selected(&values[0]) || targets.is_empty() {
+        return Ok(());
+    }
+    let mut line = format!("CONECT{:5}", values[0]);
+    for target in targets {
+        line.push_str(&format!("{target:5}"));
+    }
+    append(&mut report.pdb, &line)
+}
diff --git a/crates/chematic-mol/tests/pdb_selection_contract.rs b/crates/chematic-mol/tests/pdb_selection_contract.rs
