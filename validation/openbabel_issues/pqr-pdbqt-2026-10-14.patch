index 0000000..770a835
--- /dev/null
+++ b/crates/chematic-mol/src/pqr_pdbqt.rs
@@ -0,0 +1,238 @@
+//! Checked PQR to rigid PDBQT adaptation without bond or charge perception.
+//!
+//! Independently implemented from APBS PQR and AutoDock 4.2 field layouts.
+//! Callers supply validated AutoDock types in source atom order. PQR has no
+//! bond table, so this adapter cannot assign chemically reliable docking types.
+use crate::pqr::PqrResult;
+use chematic_core::Element;
+
+/// Conversion failures use zero-based source atom indices.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum PqrPdbqtError {
+    EmptyInput,
+    AtomTypeCount {
+        atoms: usize,
+        types: usize,
+    },
+    /// PDBQT has no per-atom radius field; explicit consent is required.
+    RadiusLossRequiresConsent,
+    InvalidField {
+        atom: usize,
+        field: &'static str,
+    },
+    InvalidAtomType {
+        atom: usize,
+        atom_type: String,
+    },
+    ElementMismatch {
+        atom: usize,
+        atom_type: String,
+    },
+}
+
+impl core::fmt::Display for PqrPdbqtError {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        match self {
+            Self::EmptyInput => write!(f, "PQR to PDBQT requires at least one atom"),
+            Self::AtomTypeCount { atoms, types } => write!(
+                f,
+                "PQR has {atoms} atoms but {types} AutoDock types were supplied"
+            ),
+            Self::RadiusLossRequiresConsent => write!(
+                f,
+                "PDBQT cannot store PQR radii; set allow_radius_loss=true to retain radii in the sidecar report"
+            ),
+            Self::InvalidField { atom, field } => write!(
+                f,
+                "PQR atom {atom}: {field} is invalid or cannot fit its PDBQT field"
+            ),
+            Self::InvalidAtomType { atom, atom_type } => write!(
+                f,
+                "PQR atom {atom}: unsupported AutoDock type '{atom_type}'"
+            ),
+            Self::ElementMismatch { atom, atom_type } => write!(
+                f,
+                "PQR atom {atom}: AutoDock type '{atom_type}' does not match the source element"
+            ),
+        }
+    }
+}
+impl std::error::Error for PqrPdbqtError {}
+
+/// Source-order sidecar. PDBQT retains charges to three decimal places and
+/// coordinates to three decimal places in Å. Original values remain here.
+#[derive(Debug, Clone, PartialEq)]
+pub struct PqrPdbqtReport {
+    pub pdbqt: String,
+    pub source_charges: Vec<f64>,
+    pub source_radii: Vec<f64>,
+    pub source_coords: Vec<(f64, f64, f64)>,
+    /// Always true: the PDBQT payload has no radius field.
+    pub radii_omitted: bool,
+    pub max_charge_rounding_error: f64,
+    pub max_coordinate_rounding_error: f64,
+}
+
+fn type_element(atom_type: &str) -> Option<Element> {
+    let symbol = match atom_type {
+        "A" | "C" => "C",
+        "N" | "NA" => "N",
+        "O" | "OA" | "OS" => "O",
+        "S" | "SA" => "S",
+        "H" | "HD" => "H",
+        "P" | "F" | "Cl" | "Br" | "I" | "Mg" | "Mn" | "Zn" | "Ca" | "Fe" => atom_type,
+        _ => return None,
+    };
+    Element::from_symbol(symbol)
+}
+
+fn text_fits(s: &str, width: usize) -> bool {
+    !s.is_empty() && s.len() <= width && s.bytes().all(|b| b.is_ascii_graphic())
+}
+
+fn rounded_field(
+    value: f64,
+    width: usize,
+    atom: usize,
+    field: &'static str,
+) -> Result<(String, f64), PqrPdbqtError> {
+    let invalid = || PqrPdbqtError::InvalidField { atom, field };
+    if !value.is_finite() {
+        return Err(invalid());
+    }
+    let text = format!("{value:>width$.3}");
+    if text.len() != width {
+        return Err(invalid());
+    }
+    let rounded: f64 = text.trim().parse().map_err(|_| invalid())?;
+    Ok((text, (rounded - value).abs()))
+}
+
+/// Convert source records to rigid receptor PDBQT, preserving source order,
+/// serials, names, residue identity and partial charges without recalculation.
+///
+/// Explicit `atom_types` avoid guessing chemistry from a bondless PQR graph.
+/// Their element compatibility is checked; acceptor/aromaticity assignments
+/// remain the caller's responsibility. No hydrogens are merged or removed.
+/// `allow_radius_loss` acknowledges that radii survive only in the report.
+/// Unrepresentable metadata/numeric fields always fail, even with consent.
+/// This does not prepare a flexible ligand or calculate a torsion tree.
+pub fn pqr_to_pdbqt(
+    source: &PqrResult,
+    atom_types: &[&str],
+    allow_radius_loss: bool,
+) -> Result<PqrPdbqtReport, PqrPdbqtError> {
+    if source.atoms.is_empty() {
+        return Err(PqrPdbqtError::EmptyInput);
+    }
+    if source.atoms.len() != atom_types.len() {
+        return Err(PqrPdbqtError::AtomTypeCount {
+            atoms: source.atoms.len(),
+            types: atom_types.len(),
+        });
+    }
+    if !allow_radius_loss {
+        return Err(PqrPdbqtError::RadiusLossRequiresConsent);
+    }
+    // PDB serials have five columns; keep the output bounded even for records
+    // constructed directly rather than obtained from the limited PQR parser.
+    if source.atoms.len() > 99_999 {
+        return Err(PqrPdbqtError::InvalidField {
+            atom: 99_999,
+            field: "atom count",
+        });
+    }
+    let mut result = PqrPdbqtReport {
+        pdbqt: String::from("REMARK  PQR charges retained; radii omitted (see sidecar)\n"),
+        source_charges: Vec::with_capacity(source.atoms.len()),
+        source_radii: Vec::with_capacity(source.atoms.len()),
+        source_coords: Vec::with_capacity(source.atoms.len()),
+        radii_omitted: true,
+        max_charge_rounding_error: 0.0,
+        max_coordinate_rounding_error: 0.0,
+    };
+    let mut serials = std::collections::HashSet::new();
+    for (i, (a, atom_type)) in source.atoms.iter().zip(atom_types).enumerate() {
+        validate_identity(a, i, &mut serials)?;
+        let element = type_element(atom_type).ok_or_else(|| PqrPdbqtError::InvalidAtomType {
+            atom: i,
+            atom_type: (*atom_type).into(),
+        })?;
+        if element != a.element {
+            return Err(PqrPdbqtError::ElementMismatch {
+                atom: i,
+                atom_type: (*atom_type).into(),
+            });
+        }
+        if !a.radius.is_finite() || a.radius < 0.0 {
+            return Err(PqrPdbqtError::InvalidField {
+                atom: i,
+                field: "radius",
+            });
+        }
+        let (x, dx) = rounded_field(a.x, 8, i, "x")?;
+        let (y, dy) = rounded_field(a.y, 8, i, "y")?;
+        let (z, dz) = rounded_field(a.z, 8, i, "z")?;
+        let (q, dq) = rounded_field(a.charge, 6, i, "charge")?;
+        result.max_charge_rounding_error = result.max_charge_rounding_error.max(dq);
+        result.max_coordinate_rounding_error =
+            result.max_coordinate_rounding_error.max(dx.max(dy).max(dz));
+        let name = if a.atom_name.len() < 4 && a.element.symbol().len() == 1 {
+            format!(" {:<3}", a.atom_name)
+        } else {
+            format!("{:<4}", a.atom_name)
+        };
+        result.pdbqt.push_str(&format!(
+            "{:<6}{:>5} {} {:>3} {}{:>4}{}   {}{}{}{:>6.2}{:>6.2}    {} {:<2}\n",
+            a.group_pdb,
+            a.serial,
+            name,
+            a.res_name,
+            a.chain_id.as_deref().unwrap_or(" "),
+            a.res_seq,
+            a.icode.unwrap_or(' '),
+            x,
+            y,
+            z,
+            1.0,
+            0.0,
+            q,
+            atom_type,
+        ));
+        result.source_charges.push(a.charge);
+        result.source_radii.push(a.radius);
+        result.source_coords.push((a.x, a.y, a.z));
+    }
+    result.pdbqt.push_str("END\n");
+    Ok(result)
+}
+
+fn validate_identity(
+    a: &crate::pqr::PqrAtomRecord,
+    i: usize,
+    serials: &mut std::collections::HashSet<i64>,
+) -> Result<(), PqrPdbqtError> {
+    for (valid, field) in [
+        (matches!(a.group_pdb.as_str(), "ATOM" | "HETATM"), "record"),
+        (
+            (1..=99_999).contains(&a.serial) && serials.insert(a.serial),
+            "serial",
+        ),
+        (text_fits(&a.atom_name, 4), "atom name"),
+        (text_fits(&a.res_name, 3), "residue name"),
+        (
+            a.chain_id.as_deref().is_none_or(|s| text_fits(s, 1)),
+            "chain",
+        ),
+        ((-999..=9999).contains(&a.res_seq), "residue number"),
+        (
+            a.icode.is_none_or(|c| c.is_ascii_alphabetic()),
+            "insertion code",
+        ),
+    ] {
+        if !valid {
+            return Err(PqrPdbqtError::InvalidField { atom: i, field });
+        }
+    }
+    Ok(())
+}
diff --git a/crates/chematic-mol/tests/pqr_pdbqt_contract.rs b/crates/chematic-mol/tests/pqr_pdbqt_contract.rs
new file mode 100644
index 0000000..946cb23
--- /dev/null
+++ b/crates/chematic-mol/tests/pqr_pdbqt_contract.rs
@@ -0,0 +1,253 @@
+use chematic_mol::{PqrPdbqtError, parse_pdbqt, parse_pqr, pqr_to_pdbqt};
+
+const FIXTURE: &str = include_str!("../../../validation/openbabel_issues/pqr/charged-records.pqr");
+const TYPES: &[&str] = &["N", "C", "HD", "Zn", "Cl"];
+
+#[test]
+fn charges_coords_and_identity_survive_in_source_order() {
+    let source = parse_pqr(FIXTURE).unwrap();
+    let before = source.clone();
+    let report = pqr_to_pdbqt(&source, TYPES, true).unwrap();
+    assert_eq!(source, before);
+    let (mol, coords, charges) = parse_pdbqt(&report.pdbqt).unwrap();
+    assert_eq!(mol.atom_count(), 5);
+    for (i, a) in source.atoms.iter().enumerate() {
+        assert!((charges[i] - a.charge).abs() <= 0.0005);
+        let c = coords[i];
+        for (actual, expected) in [(c.0, a.x), (c.1, a.y), (c.2, a.z)] {
+            assert!((actual - expected).abs() <= 0.0005);
+        }
+    }
+    let rows: Vec<_> = report
+        .pdbqt
+        .lines()
+        .filter(|s| s.starts_with("ATOM") || s.starts_with("HETATM"))
+        .collect();
+    for (i, (row, a)) in rows.iter().zip(&source.atoms).enumerate() {
+        assert_eq!(row.len(), 79);
+        assert_eq!(row[0..6].trim(), a.group_pdb);
+        assert_eq!(row[6..11].trim().parse::<i64>().unwrap(), a.serial);
+        assert_eq!(row[12..16].trim(), a.atom_name);
+        assert_eq!(row[17..20].trim(), a.res_name);
+        assert_eq!(row[21..22].trim(), a.chain_id.as_deref().unwrap_or(""));
+        assert_eq!(row[22..26].trim().parse::<i64>().unwrap(), a.res_seq);
+        assert_eq!(
+            row[26..27].trim(),
+            a.icode.map(|c| c.to_string()).unwrap_or_default()
+        );
+        assert_eq!(row[77..79].trim(), TYPES[i]);
+    }
+}
+
+#[test]
+fn sidecar_reports_original_values_and_measured_rounding() {
+    let source = parse_pqr(FIXTURE).unwrap();
+    let report = pqr_to_pdbqt(&source, TYPES, true).unwrap();
+    assert!(report.radii_omitted);
+    assert_eq!(
+        report.source_charges,
+        source.atoms.iter().map(|a| a.charge).collect::<Vec<_>>()
+    );
+    assert_eq!(
+        report.source_radii,
+        source.atoms.iter().map(|a| a.radius).collect::<Vec<_>>()
+    );
+    assert_eq!(report.source_coords[0], (-0.966123, 1.523, 1.412));
+    assert!((report.max_charge_rounding_error - 0.00045).abs() < 1e-12);
+    assert!((report.max_coordinate_rounding_error - 0.000123).abs() < 1e-12);
+    assert!(!report.pdbqt.contains("ROOT"));
+    assert!(!report.pdbqt.contains("TORSDOF"));
+}
+
+#[test]
+fn radius_loss_requires_explicit_consent() {
+    assert_eq!(
+        pqr_to_pdbqt(&parse_pqr(FIXTURE).unwrap(), TYPES, false).unwrap_err(),
+        PqrPdbqtError::RadiusLossRequiresConsent
+    );
+}
+
+#[test]
+fn empty_source_and_type_count_are_errors() {
+    let mut source = parse_pqr(FIXTURE).unwrap();
+    assert!(matches!(
+        pqr_to_pdbqt(&source, &["N"], true),
+        Err(PqrPdbqtError::AtomTypeCount { .. })
+    ));
+    source.atoms.clear();
+    assert_eq!(
+        pqr_to_pdbqt(&source, &[], true).unwrap_err(),
+        PqrPdbqtError::EmptyInput
+    );
+}
+
+#[test]
+fn types_must_be_known_and_match_source_elements() {
+    let source = parse_pqr(FIXTURE).unwrap();
+    for invalid in ["X", "C\n", "HD ", "NAA", "H D", "Na"] {
+        let types = [invalid, "C", "HD", "Zn", "Cl"];
+        assert!(matches!(
+            pqr_to_pdbqt(&source, &types, true),
+            Err(PqrPdbqtError::InvalidAtomType { atom: 0, .. })
+        ));
+    }
+    assert!(matches!(
+        pqr_to_pdbqt(&source, &["C", "C", "HD", "Zn", "Cl"], true),
+        Err(PqrPdbqtError::ElementMismatch { atom: 0, .. })
+    ));
+}
+
+#[test]
+fn rejects_silent_metadata_truncation_and_record_injection() {
+    let source = parse_pqr(FIXTURE).unwrap();
+    for (field, value) in [
+        ("atom name", "ABCDE"),
+        ("atom name", "C\n"),
+        ("residue name", "A1AJ1"),
+        ("chain", "AB"),
+        ("chain", ""),
+        ("record", "MODEL"),
+    ] {
+        let mut s = source.clone();
+        match field {
+            "atom name" => s.atoms[0].atom_name = value.into(),
+            "residue name" => s.atoms[0].res_name = value.into(),
+            "chain" => s.atoms[0].chain_id = Some(value.into()),
+            _ => s.atoms[0].group_pdb = value.into(),
+        }
+        assert_eq!(
+            pqr_to_pdbqt(&s, TYPES, true).unwrap_err(),
+            PqrPdbqtError::InvalidField { atom: 0, field }
+        );
+    }
+}
+
+#[test]
+fn serial_and_residue_boundaries_are_checked() {
+    let source = parse_pqr(FIXTURE).unwrap();
+    for serial in [0, -1, 100_000] {
+        let mut s = source.clone();
+        s.atoms[0].serial = serial;
+        assert!(matches!(
+            pqr_to_pdbqt(&s, TYPES, true),
+            Err(PqrPdbqtError::InvalidField {
+                field: "serial",
+                ..
+            })
+        ));
+    }
+    let mut duplicate = source.clone();
+    duplicate.atoms[1].serial = 7;
+    assert!(matches!(
+        pqr_to_pdbqt(&duplicate, TYPES, true),
+        Err(PqrPdbqtError::InvalidField {
+            atom: 1,
+            field: "serial"
+        })
+    ));
+    for seq in [-1000, 10000] {
+        let mut s = source.clone();
+        s.atoms[0].res_seq = seq;
+        assert!(matches!(
+            pqr_to_pdbqt(&s, TYPES, true),
+            Err(PqrPdbqtError::InvalidField {
+                field: "residue number",
+                ..
+            })
+        ));
+    }
+    let mut s = source;
+    s.atoms[0].serial = 99_999;
+    s.atoms[0].res_seq = -999;
+    s.atoms[0].atom_name = "ABCD".into();
+    s.atoms[0].icode = None;
+    assert!(pqr_to_pdbqt(&s, TYPES, true).is_ok());
+}
+
+#[test]
+fn rejects_numeric_overflow_including_rounding_across_field_edge() {
+    let source = parse_pqr(FIXTURE).unwrap();
+    for (field, value) in [
+        ("x", 10000.0),
+        ("x", 9999.9996),
+        ("x", -1000.0),
+        ("charge", 100.0),
+        ("charge", -10.0),
+        ("charge", 99.9996),
+    ] {
+        let mut s = source.clone();
+        if field == "x" {
+            s.atoms[0].x = value;
+        } else {
+            s.atoms[0].charge = value;
+        }
+        assert_eq!(
+            pqr_to_pdbqt(&s, TYPES, true).unwrap_err(),
+            PqrPdbqtError::InvalidField { atom: 0, field }
+        );
+    }
+}
+
+#[test]
+fn rejects_directly_constructed_nonfinite_values_and_negative_radii() {
+    let source = parse_pqr(FIXTURE).unwrap();
+    for field in ["x", "y", "z", "charge", "radius"] {
+        for value in [f64::NAN, f64::INFINITY, f64::NEG_INFINITY] {
+            let mut s = source.clone();
+            match field {
+                "x" => s.atoms[0].x = value,
+                "y" => s.atoms[0].y = value,
+                "z" => s.atoms[0].z = value,
+                "charge" => s.atoms[0].charge = value,
+                _ => s.atoms[0].radius = value,
+            }
+            assert_eq!(
+                pqr_to_pdbqt(&s, TYPES, true).unwrap_err(),
+                PqrPdbqtError::InvalidField { atom: 0, field }
+            );
+        }
+    }
+    let mut s = source;
+    s.atoms[0].radius = -1.0;
+    assert!(matches!(
+        pqr_to_pdbqt(&s, TYPES, true),
+        Err(PqrPdbqtError::InvalidField {
+            field: "radius",
+            ..
+        })
+    ));
+}
+
+#[test]
+fn all_supported_types_roundtrip_with_matching_element() {
+    let groups: &[(&str, &[&str])] = &[
+        ("C", &["C", "A"]),
+        ("N", &["N", "NA"]),
+        ("O", &["O", "OA", "OS"]),
+        ("S", &["S", "SA"]),
+        ("H", &["H", "HD"]),
+        ("P", &["P"]),
+        ("F", &["F"]),
+        ("Cl", &["Cl"]),
+        ("Br", &["Br"]),
+        ("I", &["I"]),
+        ("Mg", &["Mg"]),
+        ("Mn", &["Mn"]),
+        ("Zn", &["Zn"]),
+        ("Ca", &["Ca"]),
+        ("Fe", &["Fe"]),
+    ];
+    let mut source = parse_pqr(FIXTURE).unwrap();
+    source.atoms.truncate(1);
+    for (element, types) in groups {
+        source.atoms[0].element = chematic_core::Element::from_symbol(element).unwrap();
+        for t in *types {
+            let report = pqr_to_pdbqt(&source, &[t], true).unwrap();
+            let (mol, _, _) = parse_pdbqt(&report.pdbqt).unwrap();
+            assert_eq!(
+                mol.atoms().next().unwrap().1.element,
+                source.atoms[0].element
+            );
+        }
+    }
+}
