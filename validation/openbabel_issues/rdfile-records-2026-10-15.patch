diff --git a/crates/chematic-mol/src/rdfile.rs b/crates/chematic-mol/src/rdfile.rs
new file mode 100644
index 0000000..d31dd27
--- /dev/null
+++ b/crates/chematic-mol/src/rdfile.rs
@@ -0,0 +1,117 @@
+//! Typed RDFile v1 records, independently implemented from CTfile 2026 Ch. 11.
+//! Embedded V2000 RXN and V2000/V3000 MOL structures reuse existing parsers.
+use serde::{Deserialize, Serialize};
+mod reader;
+mod writer;
+pub use reader::{parse_rdfile, parse_rdfile_with_limits};
+pub use writer::{write_rdfile, write_rdfile_with_options};
+
+/// Select spec folding or the explicit unwrapped-data interchange profile.
+#[derive(Debug, Clone, Copy)]
+pub struct RdfileWriteOptions {
+    pub wrap_data: bool,
+}
+impl Default for RdfileWriteOptions {
+    fn default() -> Self {
+        Self { wrap_data: true }
+    }
+}
+
+#[derive(Debug, Clone, Copy)]
+pub struct RdfileParseLimits {
+    pub max_input_bytes: usize,
+    pub max_line_len: usize,
+    pub max_records: usize,
+    pub max_fields_per_record: usize,
+    pub max_reaction_components: usize,
+}
+impl Default for RdfileParseLimits {
+    fn default() -> Self {
+        Self {
+            max_input_bytes: 64 << 20,
+            max_line_len: 1 << 20,
+            max_records: 10_000,
+            max_fields_per_record: 1_000,
+            max_reaction_components: 1_000,
+        }
+    }
+}
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct RdfileError {
+    /// One-based source line, or zero for document/write validation.
+    pub line: usize,
+    pub detail: String,
+}
+impl core::fmt::Display for RdfileError {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        write!(f, "RDFile line {}: {}", self.line, self.detail)
+    }
+}
+impl std::error::Error for RdfileError {}
+fn error(line: usize, detail: impl Into<String>) -> RdfileError {
+    RdfileError {
+        line,
+        detail: detail.into(),
+    }
+}
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum RdfileKind {
+    Molecule,
+    Reaction,
+}
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct RdfileData {
+    pub name: String,
+    /// Literal text, including significant spaces, blank lines and duplicates.
+    /// Database field types are unavailable; numbers/references remain strings.
+    pub value: String,
+}
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct RdfileRecord {
+    pub kind: RdfileKind,
+    /// Decimal text, preserving leading zeros; no registry lookup is performed.
+    pub internal_registry: Option<String>,
+    pub external_registry: Option<String>,
+    /// Exact embedded MOL/RXN bytes as UTF-8, or None for reference-only records.
+    pub structure: Option<String>,
+    /// Ordered fields; duplicate names are never collapsed into a map.
+    pub data: Vec<RdfileData>,
+}
+impl RdfileRecord {
+    /// Explicit graph projection. Returns None for unresolved registry references.
+    /// Coordinates and fields remain in this record; they are not in SMILES.
+    pub fn smiles(&self) -> Result<Option<String>, RdfileError> {
+        let Some(block) = &self.structure else {
+            return Ok(None);
+        };
+        let smiles = match self.kind {
+            RdfileKind::Molecule => {
+                let v3000 = block.lines().nth(3).is_some_and(|s| s.contains("V3000"));
+                let parsed = if v3000 {
+                    crate::mol3000::parse_mol_v3000(block)
+                } else {
+                    crate::mol2000::parse_mol(block)
+                };
+                let (mol, _) = parsed.map_err(|e| error(0, e.to_string()))?;
+                chematic_smiles::canonical_smiles(&mol)
+            }
+            RdfileKind::Reaction => {
+                let reaction = crate::parse_rxn_file(block).map_err(|e| error(0, e.to_string()))?;
+                chematic_rxn::write_reaction(&reaction)
+            }
+        };
+        Ok(Some(smiles))
+    }
+}
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct RdfileDocument {
+    pub date_comment: String,
+    pub records: Vec<RdfileRecord>,
+    /// Original complete input. Canonical writing uses current fields instead.
+    #[serde(default)]
+    pub source_text: String,
+}
diff --git a/crates/chematic-mol/src/rdfile/reader.rs b/crates/chematic-mol/src/rdfile/reader.rs
new file mode 100644
index 0000000..ebe3d2a
--- /dev/null
+++ b/crates/chematic-mol/src/rdfile/reader.rs
@@ -0,0 +1,314 @@
+use super::*;
+
+struct Cursor<'a> {
+    text: &'a str,
+    offset: usize,
+    line: usize,
+}
+impl<'a> Cursor<'a> {
+    fn peek(&self) -> Option<&'a str> {
+        if self.offset == self.text.len() {
+            return None;
+        }
+        Some(
+            self.text[self.offset..]
+                .split('\n')
+                .next()
+                .unwrap()
+                .trim_end_matches('\r'),
+        )
+    }
+    fn take(&mut self) -> Result<&'a str, RdfileError> {
+        let row = self
+            .peek()
+            .ok_or_else(|| error(self.line, "unexpected end of input"))?;
+        self.offset += self.text[self.offset..]
+            .find('\n')
+            .map_or(self.text.len() - self.offset, |i| i + 1);
+        self.line += 1;
+        Ok(row)
+    }
+}
+fn argument<'a>(row: &'a str, keyword: &str) -> Option<&'a str> {
+    let rest = row.strip_prefix(keyword)?;
+    if rest.is_empty() {
+        Some("")
+    } else if rest.starts_with([' ', '\t']) {
+        Some(rest.trim_start_matches([' ', '\t']))
+    } else {
+        None
+    }
+}
+fn record_start(row: &str) -> bool {
+    ["$MFMT", "$RFMT", "$MIREG", "$MEREG", "$RIREG", "$REREG"]
+        .iter()
+        .any(|k| argument(row, k).is_some())
+}
+fn short_header(row: &str, line: usize) -> Result<(), RdfileError> {
+    if row.len() > 80 || !row.is_ascii() || row.contains(['\r', '\n', '\0']) {
+        return Err(error(
+            line,
+            "identifier/date/field header must be ASCII within 80 columns",
+        ));
+    }
+    Ok(())
+}
+fn identifier(row: &str, line: usize) -> Result<RdfileRecord, RdfileError> {
+    short_header(row, line)?;
+    for (keyword, kind, embedded, internal) in [
+        ("$MFMT", RdfileKind::Molecule, true, false),
+        ("$RFMT", RdfileKind::Reaction, true, false),
+        ("$MIREG", RdfileKind::Molecule, false, true),
+        ("$MEREG", RdfileKind::Molecule, false, false),
+        ("$RIREG", RdfileKind::Reaction, false, true),
+        ("$REREG", RdfileKind::Reaction, false, false),
+    ] {
+        let Some(mut value) = argument(row, keyword) else {
+            continue;
+        };
+        let mut is_internal = internal;
+        let mut registry_present = !embedded;
+        if embedded && !value.is_empty() {
+            registry_present = true;
+            let (i, e) = match kind {
+                RdfileKind::Molecule => ("$MIREG", "$MEREG"),
+                RdfileKind::Reaction => ("$RIREG", "$REREG"),
+            };
+            if let Some(v) = argument(value, i) {
+                is_internal = true;
+                value = v;
+            } else if let Some(v) = argument(value, e) {
+                value = v;
+            } else {
+                return Err(error(line, "unsupported embedded registry identifier"));
+            }
+            if value.contains('$') {
+                return Err(error(
+                    line,
+                    "only one registry identifier per record is supported",
+                ));
+            }
+        }
+        if registry_present
+            && (value.is_empty() || is_internal && !value.bytes().all(|b| b.is_ascii_digit()))
+        {
+            return Err(error(
+                line,
+                "registry reference requires a nonempty external or decimal internal number",
+            ));
+        }
+        let mut record = RdfileRecord {
+            kind,
+            internal_registry: None,
+            external_registry: None,
+            structure: None,
+            data: Vec::new(),
+        };
+        if !value.is_empty() {
+            if is_internal {
+                record.internal_registry = Some(value.to_owned());
+            } else {
+                record.external_registry = Some(value.to_owned());
+            }
+        }
+        return Ok(record);
+    }
+    Err(error(
+        line,
+        "expected a molecule or reaction record identifier",
+    ))
+}
+fn mol_block<'a>(cursor: &mut Cursor<'a>) -> Result<&'a str, RdfileError> {
+    let start = cursor.offset;
+    for _ in 0..4 {
+        cursor.take()?;
+    }
+    loop {
+        let row = cursor.take()?;
+        if row.trim_end() == "M  END" {
+            break;
+        }
+        if row.starts_with('$') {
+            return Err(error(
+                cursor.line - 1,
+                "missing MOL terminator before RDFile keyword",
+            ));
+        }
+    }
+    Ok(&cursor.text[start..cursor.offset])
+}
+fn rxn_block<'a>(
+    cursor: &mut Cursor<'a>,
+    limits: &RdfileParseLimits,
+) -> Result<&'a str, RdfileError> {
+    let start = cursor.offset;
+    if cursor.take()? != "$RXN" {
+        return Err(error(
+            cursor.line - 1,
+            "only embedded RXN V2000 is supported",
+        ));
+    }
+    for _ in 0..3 {
+        cursor.take()?;
+    }
+    let counts = cursor.take()?;
+    let fields: Vec<_> = counts.split_whitespace().collect();
+    if !(fields.len() == 2 || fields.len() == 3 && fields[2] == "0") {
+        return Err(error(
+            cursor.line - 1,
+            "RXN requires exactly reactant and product counts; agents are unsupported",
+        ));
+    }
+    let n = fields[..2]
+        .iter()
+        .try_fold(0usize, |n, s| {
+            s.parse::<usize>().ok().and_then(|v| n.checked_add(v))
+        })
+        .ok_or_else(|| error(cursor.line - 1, "invalid RXN component count"))?;
+    if n > limits.max_reaction_components {
+        return Err(error(cursor.line - 1, "reaction component limit exceeded"));
+    }
+    for _ in 0..n {
+        if cursor.take()? != "$MOL" {
+            return Err(error(cursor.line - 1, "expected RXN $MOL component marker"));
+        }
+        let block = mol_block(cursor)?;
+        if block.lines().nth(3).is_some_and(|s| s.contains("V3000")) {
+            return Err(error(
+                cursor.line - 1,
+                "RXN V2000 components must be V2000 MOL blocks",
+            ));
+        }
+    }
+    Ok(&cursor.text[start..cursor.offset])
+}
+fn datum_line(row: &str, line: usize) -> Result<(&str, bool), RdfileError> {
+    if !row.is_ascii() {
+        return Err(error(line, "data rows must be ASCII"));
+    }
+    // Exact 81-column '+' rows use CTfile folding. Longer plain rows are a
+    // common unwrapped-data extension (including Indigo output), kept verbatim.
+    let join = row.len() == 81 && row.as_bytes()[80] == b'+';
+    Ok((if join { &row[..80] } else { row }, join))
+}
+fn data(cursor: &mut Cursor<'_>) -> Result<RdfileData, RdfileError> {
+    let line = cursor.line;
+    let header = cursor.take()?;
+    short_header(header, line)?;
+    let name = argument(header, "$DTYPE")
+        .filter(|s| !s.is_empty())
+        .ok_or_else(|| error(line, "empty data field name"))?
+        .to_owned();
+    let first = cursor.take()?;
+    let (first, mut join) = datum_line(first, cursor.line - 1)?;
+    let value = argument(first, "$DATUM")
+        .ok_or_else(|| error(cursor.line - 1, "$DTYPE must be followed by $DATUM"))?;
+    if value.starts_with("$MFMT") {
+        return Err(error(
+            cursor.line - 1,
+            "embedded molecules inside $DATUM are unsupported",
+        ));
+    }
+    let mut value = value.to_owned();
+    while let Some(row) = cursor.peek() {
+        if row.starts_with('$') {
+            if join {
+                return Err(error(
+                    cursor.line,
+                    "missing data continuation before keyword",
+                ));
+            }
+            if argument(row, "$DTYPE").is_none() && !record_start(row) {
+                return Err(error(cursor.line, "unsupported keyword in data"));
+            }
+            break;
+        }
+        let (row, next_join) = datum_line(row, cursor.line)?;
+        if !join {
+            value.push('\n');
+        }
+        value.push_str(row);
+        join = next_join;
+        cursor.take()?;
+    }
+    if join {
+        return Err(error(cursor.line, "missing final data continuation"));
+    }
+    Ok(RdfileData { name, value })
+}
+
+pub fn parse_rdfile(text: &str) -> Result<RdfileDocument, RdfileError> {
+    parse_rdfile_with_limits(text, &RdfileParseLimits::default())
+}
+/// Checked in-memory RDFile v1. Source text and embedded blocks retain their
+/// original bytes; ASCII data fields join documented column-81 continuations.
+pub fn parse_rdfile_with_limits(
+    text: &str,
+    limits: &RdfileParseLimits,
+) -> Result<RdfileDocument, RdfileError> {
+    if text.len() > limits.max_input_bytes {
+        return Err(error(0, "input byte limit exceeded"));
+    }
+    if text.contains('\0') {
+        return Err(error(0, "NUL bytes are unsupported"));
+    }
+    for (i, line) in text.lines().enumerate() {
+        if line.len() > limits.max_line_len {
+            return Err(error(i + 1, "physical line length limit exceeded"));
+        }
+    }
+    let mut cursor = Cursor {
+        text,
+        offset: 0,
+        line: 1,
+    };
+    if cursor.take()? != "$RDFILE 1" {
+        return Err(error(1, "expected $RDFILE 1"));
+    }
+    let date = cursor.take()?;
+    short_header(date, 2)?;
+    let date_comment = argument(date, "$DATM")
+        .ok_or_else(|| error(2, "missing $DATM"))?
+        .to_owned();
+    let mut records = Vec::new();
+    while let Some(row) = cursor.peek() {
+        if records.len() >= limits.max_records {
+            return Err(error(cursor.line, "record count limit exceeded"));
+        }
+        let line = cursor.line;
+        let embedded = argument(row, "$MFMT").is_some() || argument(row, "$RFMT").is_some();
+        let mut record = identifier(cursor.take()?, line)?;
+        if embedded {
+            let block = match record.kind {
+                RdfileKind::Molecule => mol_block(&mut cursor)?,
+                RdfileKind::Reaction => rxn_block(&mut cursor, limits)?,
+            };
+            record.structure = Some(block.to_owned());
+            record
+                .smiles()
+                .map_err(|e| error(line, format!("invalid embedded structure: {e}")))?;
+        }
+        while cursor
+            .peek()
+            .is_some_and(|s| argument(s, "$DTYPE").is_some())
+        {
+            if record.data.len() >= limits.max_fields_per_record {
+                return Err(error(cursor.line, "data-field count limit exceeded"));
+            }
+            record
+                .data
+                .try_reserve(1)
+                .map_err(|_| error(cursor.line, "allocation failed"))?;
+            record.data.push(data(&mut cursor)?);
+        }
+        records
+            .try_reserve(1)
+            .map_err(|_| error(line, "allocation failed"))?;
+        records.push(record);
+    }
+    Ok(RdfileDocument {
+        date_comment,
+        records,
+        source_text: text.to_owned(),
+    })
+}
diff --git a/crates/chematic-mol/src/rdfile/writer.rs b/crates/chematic-mol/src/rdfile/writer.rs
new file mode 100644
index 0000000..fee4790
--- /dev/null
+++ b/crates/chematic-mol/src/rdfile/writer.rs
@@ -0,0 +1,187 @@
+use super::*;
+
+fn scalar(s: &str, nonempty: bool) -> Result<(), RdfileError> {
+    if !s.is_ascii() || s.contains(['\n', '\r', '\0']) || nonempty && s.is_empty() {
+        return Err(error(
+            0,
+            "header fields must be single-line ASCII with a nonempty identifier",
+        ));
+    }
+    Ok(())
+}
+fn header(out: &mut String, keyword: &str, value: &str) -> Result<(), RdfileError> {
+    scalar(value, false)?;
+    let line = if value.is_empty() {
+        keyword.to_owned()
+    } else {
+        format!("{keyword} {value}")
+    };
+    if line.len() > 80 {
+        return Err(error(0, "header exceeds supported 80-column layout"));
+    }
+    out.push_str(&line);
+    out.push('\n');
+    Ok(())
+}
+fn datum(out: &mut String, value: &str, wrap_data: bool) -> Result<(), RdfileError> {
+    if !value.is_ascii() || value.contains(['\r', '\0']) {
+        return Err(error(0, "data values must be ASCII text with LF newlines"));
+    }
+    for (i, line) in value.split('\n').enumerate() {
+        if i > 0 && line.starts_with('$') {
+            return Err(error(
+                0,
+                "data continuation cannot begin with a reserved '$' keyword",
+            ));
+        }
+        let physical = if i == 0 {
+            format!("$DATUM {line}")
+        } else {
+            line.to_owned()
+        };
+        let mut remaining = physical.as_str();
+        while wrap_data && remaining.len() > 80 {
+            out.push_str(&remaining[..80]);
+            out.push_str("+\n");
+            remaining = &remaining[80..];
+            if remaining.starts_with('$') {
+                return Err(error(
+                    0,
+                    "wrapped data would collide with an RDFile keyword",
+                ));
+            }
+        }
+        out.push_str(remaining);
+        out.push('\n');
+    }
+    Ok(())
+}
+fn output_size(
+    document: &RdfileDocument,
+    limits: &RdfileParseLimits,
+) -> Result<usize, RdfileError> {
+    let mut estimate = 32usize.saturating_add(document.date_comment.len());
+    for record in &document.records {
+        if record.data.len() > limits.max_fields_per_record {
+            return Err(error(0, "data-field count limit exceeded"));
+        }
+        for size in [
+            record.structure.as_ref().map_or(0, String::len),
+            record.internal_registry.as_ref().map_or(0, String::len),
+            record.external_registry.as_ref().map_or(0, String::len),
+            64,
+        ] {
+            estimate = estimate.saturating_add(size);
+        }
+        for field in &record.data {
+            estimate = estimate
+                .saturating_add(field.name.len())
+                .saturating_add(field.value.len())
+                .saturating_add(field.value.len() / 80 * 2)
+                .saturating_add(24);
+        }
+        if estimate > limits.max_input_bytes {
+            return Err(error(0, "output byte limit exceeded"));
+        }
+    }
+    if estimate > limits.max_input_bytes {
+        return Err(error(0, "output byte limit exceeded"));
+    }
+    Ok(estimate)
+}
+
+fn write_record(
+    out: &mut String,
+    record: &RdfileRecord,
+    options: RdfileWriteOptions,
+) -> Result<(), RdfileError> {
+    if record.internal_registry.is_some() && record.external_registry.is_some() {
+        return Err(error(
+            0,
+            "only one registry identifier per record is supported",
+        ));
+    }
+    let (fmt, ireg, ereg) = match record.kind {
+        RdfileKind::Molecule => ("$MFMT", "$MIREG", "$MEREG"),
+        RdfileKind::Reaction => ("$RFMT", "$RIREG", "$REREG"),
+    };
+    let registry = if let Some(value) = &record.internal_registry {
+        scalar(value, true)?;
+        if !value.bytes().all(|b| b.is_ascii_digit()) {
+            return Err(error(0, "internal registry number must be decimal"));
+        }
+        Some((ireg, value))
+    } else if let Some(value) = &record.external_registry {
+        scalar(value, true)?;
+        Some((ereg, value))
+    } else {
+        None
+    };
+    if let Some(block) = &record.structure {
+        let identifier = registry
+            .map(|(k, v)| format!("{k} {v}"))
+            .unwrap_or_default();
+        header(out, fmt, &identifier)?;
+        out.push_str(block);
+        if !block.ends_with('\n') {
+            out.push('\n');
+        }
+    } else if let Some((keyword, value)) = registry {
+        header(out, keyword, value)?;
+    } else {
+        return Err(error(
+            0,
+            "reference-only record requires a registry identifier",
+        ));
+    }
+    for field in &record.data {
+        scalar(&field.name, true)?;
+        header(out, "$DTYPE", &field.name)?;
+        datum(out, &field.value, options.wrap_data)?;
+    }
+    Ok(())
+}
+
+/// Canonical LF RDFile serialization of current records, never stale source
+/// replay. Embedded structure bytes remain intact. Refuses unsupported fields,
+/// delimiter injection, invalid structures and output beyond default limits.
+pub fn write_rdfile(document: &RdfileDocument) -> Result<String, RdfileError> {
+    write_rdfile_with_options(document, RdfileWriteOptions::default())
+}
+/// Explicit unwrapped-data profile for consumers that do not implement '+'
+/// folding. Round parsing still refuses ambiguous keyword/continuation data.
+pub fn write_rdfile_with_options(
+    document: &RdfileDocument,
+    options: RdfileWriteOptions,
+) -> Result<String, RdfileError> {
+    let limits = RdfileParseLimits::default();
+    if document.records.len() > limits.max_records {
+        return Err(error(0, "record count limit exceeded"));
+    }
+    let estimate = output_size(document, &limits)?;
+    let mut out = String::new();
+    out.try_reserve(estimate)
+        .map_err(|_| error(0, "output allocation failed"))?;
+    out.push_str("$RDFILE 1\n");
+    header(&mut out, "$DATM", &document.date_comment)?;
+    for record in &document.records {
+        write_record(&mut out, record, options)?;
+    }
+    // Round parsing catches injected record boundaries and verifies chemistry.
+    let reparsed = parse_rdfile(&out)?;
+    let mut expected = document.records.clone();
+    for record in &mut expected {
+        if let Some(block) = &mut record.structure
+            && !block.ends_with('\n')
+        {
+            block.push('\n');
+        }
+    }
+    if reparsed.date_comment != document.date_comment || reparsed.records != expected {
+        return Err(error(
+            0,
+            "output would change record boundaries, fields or structure payloads",
+        ));
+    }
+    Ok(out)
+}
