{
  "schema": "chematic.interchange-development-protocol.v1",
  "scope": "Exposed hand-authored development fixtures; not an independent holdout or a superiority gate.",
  "oracle": "Expected atoms, charges, coordinates, connectivity and metadata are explicitly declared; neither engine is the oracle. Formal charges use the declared N.4 +1 / other listed atom types neutral projection only.",
  "profiles": {
    "common": "Contiguous atom IDs, supported local MOL2 subset; common label describes this fixture lane, not universal dialect agreement.",
    "stress": "Nonsequential IDs or opaque vendor sections; dialect expectations may differ.",
    "negative": "Invalid in the declared bounded local profile; acceptance is reported as accepted_outside_profile, not asserted to be an Open Babel bug."
  },
  "routes": [
    {
      "id": "mol2-self",
      "target": "mol2",
      "chematic_policy": "strict"
    },
    {
      "id": "mol2-cjson",
      "target": "cjson",
      "chematic_policy": "allow_loss"
    }
  ],
  "coordinate_abs_tolerance": {
    "mol2": 5e-05,
    "cjson": 1e-12
  },
  "partial_charge_abs_tolerance": {
    "mol2": 5e-05,
    "cjson": 1e-12
  },
  "coordinate_bits": "Diagnostic only; the declared absolute tolerance determines required coordinate preservation.",
  "limits": {
    "max_input_bytes": 65536,
    "max_output_bytes": 1048576,
    "timeout_seconds": 10,
    "max_atoms": 64,
    "mapping_search_nodes": 10000
  },
