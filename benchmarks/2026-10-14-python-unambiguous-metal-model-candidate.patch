+type MetalBondChanges = smallvec::SmallVec<[(usize, usize, usize); 8]>;
+
+fn unambiguous_metal_changes(mol: &mut Mol) -> Result<Option<MetalBondChanges>, RdkitSmilesError> {
+    let mut changes = MetalBondChanges::new();
+    for donor in 0..mol.atoms.len() {
+        if !is_hypervalent_non_metal(mol, donor)? || no_dative(mol, donor) {
+            continue;
+        }
+        let mut eligible = None;
+        for &bond_index in &mol.atom_bonds[donor] {
+            let bond = &mol.bonds[bond_index];
+            let metal = bond.other(donor);
+            if bond.bt != BondType::Single || !periodic::is_metal(mol.atoms[metal].anum) {
+                continue;
+            }
+            if eligible.replace((bond_index, metal)).is_some() {
+                // Nothing has been rewritten: the ranked fallback sees the
+                // original graph, even after earlier unambiguous donors.
+                return Ok(None);
+            }
+        }
+        if let Some((bond_index, metal)) = eligible {
+            // The ranked path rewrites `bond_between`, which can select an
+            // earlier parallel bond in an internally constructed graph.
+            if mol.bond_between(donor, metal) != Some(bond_index) {
+                return Ok(None);
+            }
+            changes.push((donor, bond_index, metal));
+        }
+    }
+    // A rewrite touches only its donor and a metal. It cannot alter another
+    // nonmetal donor's valence; ranking/order therefore cannot affect these
+    // unique choices, including when several donors share the same metal.
+    Ok(Some(changes))
 }
 
