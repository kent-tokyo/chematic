--- /dev/null
+++ b/scripts/bench_python_scalar_reuse.py
@@ -0,0 +1,170 @@
+#!/usr/bin/env python3
+"""Long prepared scalar-call batches, separate from the original frontier protocol.
+
+Every native float is retained during timing and checked afterward. This
+measures repeated property calls, not initial calculation or parse-inclusive work.
+"""
+import argparse
+from datetime import datetime, timezone
+import json
+import math
+import os
+from pathlib import Path
+import platform
+import resource
+import subprocess
+import sys
+import time
+import zipfile
+
+from bench_python_speed_frontier import agreement, comparable, corpus_rows, sha, table, paired_median_ratio_ci
+
+OPS = ("tpsa", "labute_asa")
+
+
+def validate_values(reference, values, repeats):
+    if len(values) != len(reference) * repeats:
+        raise ValueError("scalar call accounting differs")
+    if not reference or any(type(v) is not float or not math.isfinite(v) for v in reference):
+        raise ValueError("invalid scalar reference")
+    for index, value in enumerate(values):
+        if type(value) is not float or not math.isfinite(value) or value != reference[index % len(reference)]:
+            raise ValueError("a retained scalar differs from its reference")
+
+
+def worker(args):
+    engine = "chematic" if args.worker in ("baseline", "candidate") else args.worker
+    parse, functions = table(engine)
+    data = args.corpus.read_bytes()
+    rows = corpus_rows(data, args.offset, args.limit)
+    result = {"corpus_sha256": sha(data), "operations": {}}
+    for op in OPS:
+        molecules = [parse(row) for row in rows]
+        if any(m is None for m in molecules):
+            raise ValueError("input parse failure")
+        function = functions[op]
+        reference = [function(m) for m in molecules]  # one preparation call per molecule
+        started = time.perf_counter_ns()
+        values = [function(m) for _ in range(args.repeats) for m in molecules]
+        elapsed = time.perf_counter_ns() - started
+        validate_values(reference, values, args.repeats)
+        result["operations"][op] = {"elapsed_ns": elapsed, "calls": len(values), "values": reference}
+        del values, molecules
+    module = __import__(engine)
+    result.update(version=module.__version__, module_path=module.__file__,
+                  extension_sha256={p.name: sha(p.read_bytes()) for p in Path(module.__file__).parent.glob("*.so")},
+                  peak_process_rss_bytes=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss *
+                  (1 if sys.platform == "darwin" else 1024))
+    return result
+
+
+def parent(args):
+    names = ("baseline", "candidate", "rdkit", "cosmolkit")
+    source_payload = args.source_manifest.read_bytes()
+    corpus_payload = args.corpus.read_bytes()
+    wheels = {name: getattr(args, name + "_wheel") for name in names[:2]}
+    extensions = {}
+    for name, path in wheels.items():
+        with zipfile.ZipFile(path) as archive:
+            extensions[name] = {Path(p).name: sha(archive.read(p)) for p in archive.namelist() if p.endswith(".so")}
+    report = {"schema": "python-scalar-reuse/v1", "created_utc": datetime.now(timezone.utc).isoformat(),
+              "source_manifest": json.loads(source_payload), "source_manifest_sha256": sha(source_payload),
+              "corpus": {"path": str(args.corpus), "sha256": sha(corpus_payload), "offset": args.offset, "rows": args.limit},
+              "wheels": {name: {"path": str(path), "sha256": sha(path.read_bytes())} for name, path in wheels.items()},
+              "host": {"platform": platform.platform(), "python": sys.version, "cpus": os.cpu_count()},
+              "protocol": {"blocks": args.blocks, "repeats": args.repeats, "calls_per_operation": args.limit * args.repeats,
+                           "order": "four rotating fresh-process arms, sequential", "prepared": "one untimed call per molecule",
+                           "timing": "all native float objects retained; all calls validated outside timing",
+                           "rss": "whole-process peak including imports, parsing, preparation and retained floats"},
+              "blocks": [], "agreement": {}, "summary": {}, "complete": False}
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+
+    def save():
+        temp = args.output.with_suffix(".partial")
+        temp.write_text(json.dumps(report, indent=2) + "\n")
+        temp.replace(args.output)
+
+    expected = {}
+    save()
+    for block in range(args.blocks):
+        order = names[block % 4:] + names[:block % 4]
+        record = {"order": order, "load_average_start": list(os.getloadavg())}
+        for name in order:
+            env = os.environ.copy()
+            if name in wheels:
+                env["PYTHONPATH"] = str(getattr(args, name + "_path"))
+            else:
+                env.pop("PYTHONPATH", None)
+            command = [sys.executable, __file__, "--worker", name, "--corpus", str(args.corpus),
+                       "--offset", str(args.offset), "--limit", str(args.limit), "--repeats", str(args.repeats)]
+            process = subprocess.run(command, env=env, capture_output=True, text=True, timeout=300)
+            if process.returncode:
+                raise RuntimeError(f"{name} failed; no completed speed claim: {process.stderr[-1600:]}")
+            sample = json.loads(process.stdout)
+            if sample["corpus_sha256"] != report["corpus"]["sha256"]:
+                raise ValueError("corpus changed")
+            if name in wheels and sample["extension_sha256"] != extensions[name]:
+                raise ValueError("loaded extension differs from wheel")
+            outputs = {}
+            for op in OPS:
+                row = sample["operations"][op]
+                if type(row["elapsed_ns"]) is not int or row["elapsed_ns"] <= 0 or row["calls"] != args.limit * args.repeats:
+                    raise ValueError("invalid scalar timing/accounting")
+                outputs[op] = row.pop("values")
+            if name not in expected:
+                expected[name] = outputs
+            if outputs != expected[name]:
+                raise ValueError("outputs changed across blocks")
+            sample["output_sha256"] = sha(json.dumps(outputs, sort_keys=True).encode())
+            record[name] = sample
+        report["blocks"].append(record)
+        save()
+        print(f"block {block + 1}/{args.blocks}", flush=True)
+    for index, op in enumerate(OPS):
+        checks = {"candidate_vs_baseline": agreement(expected["baseline"][op], expected["candidate"][op], exact=True)}
+        checks.update({name + "_vs_rdkit": agreement(expected["rdkit"][op], expected[name][op], exact=False)
+                       for name in ("baseline", "candidate", "cosmolkit")})
+        report["agreement"][op] = checks
+        report["summary"][op] = {}
+        for name in ("baseline", "rdkit", "cosmolkit"):
+            speed = paired_median_ratio_ci([b[name]["operations"][op]["elapsed_ns"] for b in report["blocks"]],
+                                           [b["candidate"]["operations"][op]["elapsed_ns"] for b in report["blocks"]],
+                                           seed=index) if comparable(checks, name) else None
+            report["summary"][op][name] = {"speedup": speed, "demonstrated_win": bool(
+                speed and speed["ci95"][0] > 1 and speed["winning_blocks"] == args.blocks)}
+    if sha(args.corpus.read_bytes()) != sha(corpus_payload) or sha(args.source_manifest.read_bytes()) != sha(source_payload):
+        raise ValueError("input or manifest changed")
+    for name, path in wheels.items():
+        if sha(path.read_bytes()) != report["wheels"][name]["sha256"]:
+            raise ValueError("wheel changed")
+    report["complete"] = True
+    save()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--worker", choices=("baseline", "candidate", "rdkit", "cosmolkit"))
+    parser.add_argument("--corpus", type=Path, required=True)
+    parser.add_argument("--limit", type=int, default=1000)
+    parser.add_argument("--offset", type=int, default=0)
+    parser.add_argument("--repeats", type=int, default=1000)
+    parser.add_argument("--blocks", type=int, default=20)
+    parser.add_argument("--source-manifest", type=Path)
+    parser.add_argument("--output", type=Path)
+    for name in ("baseline", "candidate"):
+        parser.add_argument("--" + name + "-wheel", type=Path)
+        parser.add_argument("--" + name + "-path", type=Path)
+    args = parser.parse_args()
+    if args.limit < 1 or args.offset < 0 or args.repeats < 1000 or args.blocks < 20:
+        parser.error("positive rows, nonnegative offset, at least 1000 repeats and 20 blocks required")
+    if args.worker:
+        print(json.dumps(worker(args)))
+    else:
+        if any(getattr(args, key) is None for key in ("baseline_wheel", "candidate_wheel", "baseline_path",
+                                                     "candidate_path", "source_manifest", "output")):
+            parser.error("source wheels, installed paths, source manifest and output required")
+        parent(args)
+
+
+if __name__ == "__main__":
+    main()
