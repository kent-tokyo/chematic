+//! Frozen reader oracle; provenance and recipe in v3000-ascii-whitespace-v1.manifest.json.
+use super::*;
+
+fn reference_read(input: &str) -> Result<MolReadReport, MolParseError> {
+    let lines = validate_v3000_physical_lines(input)?;
+    let (metadata, line2) = v3000_metadata(&lines)?;
+    let logical_lines = collect_v30_lines(&lines);
+    let mut parser = V3000Parser::new();
+    parser.allocation_limit = logical_lines.len();
+    // Logical payloads live until the entire parse ends, including owned
+    // continuation text. Reuse only the token vector's storage; clear every
+    // row before borrowing that row's exact Unicode-whitespace tokens.
+    let mut tokens = Vec::new();
+    for line in &logical_lines {
+        tokens.clear();
+        tokens.extend(line.payload.split_whitespace());
+        parser.consume(line, &tokens)?;
+    }
+    finish_v3000_report(parser, metadata, line2)
+}
+
+fn compare(input: &str) {
+    let expected = reference_read(input);
+    let actual = read_mol_v3000_with_diagnostics(input);
+    match (expected, actual) {
+        (Err(left), Err(right)) => assert_eq!(format!("{left:?}"), format!("{right:?}")),
+        (Ok(left), Ok(right)) => {
+            assert_eq!(left.metadata, right.metadata);
+            assert_eq!(
+                left.mol
+                    .atoms()
+                    .map(|(idx, atom)| format!(
+                        "{idx:?}:{atom:?}:{:?}:{:?}:{:?}:{:?}",
+                        left.mol.stereo_neighbor_order(idx),
+                        left.mol.r_group_label(idx),
+                        left.mol.neighbors(idx).collect::<Vec<_>>(),
+                        left.mol.atom_tag(idx)
+                    ))
+                    .collect::<Vec<_>>(),
+                right
+                    .mol
+                    .atoms()
+                    .map(|(idx, atom)| format!(
+                        "{idx:?}:{atom:?}:{:?}:{:?}:{:?}:{:?}",
+                        right.mol.stereo_neighbor_order(idx),
+                        right.mol.r_group_label(idx),
+                        right.mol.neighbors(idx).collect::<Vec<_>>(),
+                        right.mol.atom_tag(idx)
+                    ))
+                    .collect::<Vec<_>>()
+            );
+            assert_eq!(
+                left.mol
+                    .bonds()
+                    .map(|pair| format!("{pair:?}"))
+                    .collect::<Vec<_>>(),
+                right
+                    .mol
+                    .bonds()
+                    .map(|pair| format!("{pair:?}"))
+                    .collect::<Vec<_>>()
+            );
+            assert_eq!(
+                left.coords
+                    .iter()
+                    .map(|(x, y)| [x.to_bits(), y.to_bits()])
+                    .collect::<Vec<_>>(),
+                right
+                    .coords
+                    .iter()
+                    .map(|(x, y)| [x.to_bits(), y.to_bits()])
+                    .collect::<Vec<_>>()
+            );
+            assert_eq!(
+                format!(
+                    "{:?}:{:?}:{:?}:{:?}:{:?}:{:?}:{:?}:{:?}",
+                    left.stereo_diagnostics,
+                    left.ez_diagnostics,
+                    left.conformer,
+                    left.coordinate_dimension,
+                    left.geometry_rank,
+                    left.stereo3d_diagnostics,
+                    left.square_planar_diagnostics,
+                    left.mol.stereo_groups()
+                ),
+                format!(
+                    "{:?}:{:?}:{:?}:{:?}:{:?}:{:?}:{:?}:{:?}",
+                    right.stereo_diagnostics,
+                    right.ez_diagnostics,
+                    right.conformer,
+                    right.coordinate_dimension,
+                    right.geometry_rank,
+                    right.stereo3d_diagnostics,
+                    right.square_planar_diagnostics,
+                    right.mol.stereo_groups()
+                )
+            );
+            assert_eq!(
+                write_mol_v3000(&left.mol, &left.metadata, &left.coords),
+                write_mol_v3000(&right.mol, &right.metadata, &right.coords)
+            );
+        }
+        _ => panic!("reader result changed"),
+    }
+}
+
+#[test]
+fn ascii_unicode_and_continued_reader_match_original() {
+    let original = include_str!(concat!(
+        env!("CARGO_MANIFEST_DIR"),
+        "/../../benchmarks/fixtures/ethanol.v3000"
+    ));
+    let recipe: serde_json::Value = serde_json::from_str(include_str!(concat!(
+        env!("CARGO_MANIFEST_DIR"),
+        "/../../validation/benchmark_corpora/v3000-ascii-whitespace-v1.recipe.json"
+    )))
+    .unwrap();
+    for codepoint in 0..=0x10ffff {
+        if let Some(character) = char::from_u32(codepoint)
+            && character.is_whitespace()
+        {
+            assert!(
+                recipe["separator_codepoints"]
+                    .as_array()
+                    .unwrap()
+                    .iter()
+                    .any(|v| v.as_u64() == Some(codepoint as u64))
+            );
+        }
+    }
+    let mut cases = 0;
+    let mut documents = vec![original.to_string()];
+    for bad in ["bad", "not-a-float"] {
+        let mut in_atoms = false;
+        let mut changed = false;
+        let mut document = String::new();
+        for line in original.lines() {
+            if line == "M  V30 BEGIN ATOM" {
+                in_atoms = true;
+            }
+            if in_atoms
+                && !changed
+                && line
+                    .strip_prefix(V30_PREFIX)
+                    .is_some_and(|p| p.as_bytes()[0].is_ascii_digit())
+            {
+                let mut fields: Vec<_> = line[V30_PREFIX.len()..].split_whitespace().collect();
+                fields[if bad == "bad" { 0 } else { 2 }] = bad;
+                document.push_str(V30_PREFIX);
+                document.push_str(&fields.join(" "));
+                changed = true;
+            } else {
+                document.push_str(line);
+            }
+            document.push('\n');
+        }
+        assert!(changed);
+        documents.push(document);
+    }
+    for document in documents {
+        for codepoint in recipe["separator_codepoints"].as_array().unwrap() {
+            let separator = char::from_u32(codepoint.as_u64().unwrap() as u32)
+                .unwrap()
+                .to_string();
+            for continued in [false, true] {
+                let mut input = String::new();
+                for line in document.lines() {
+                    if let Some(payload) = line.strip_prefix(V30_PREFIX) {
+                        input.push_str(V30_PREFIX);
+                        if continued && let Some((first, rest)) = payload.split_once(' ') {
+                            input.push_str(first);
+                            input.push_str("-\n");
+                            input.push_str(V30_PREFIX);
+                            input.push_str(&rest.replace(' ', &separator));
+                        } else {
+                            input.push_str(&payload.replace(' ', &separator));
+                        }
+                    } else {
+                        input.push_str(line);
+                    }
+                    input.push('\n');
+                }
+                compare(&input);
+                cases += 1;
+            }
+        }
+    }
+    assert_eq!(cases, recipe["expected_cases"].as_u64().unwrap());
+}
