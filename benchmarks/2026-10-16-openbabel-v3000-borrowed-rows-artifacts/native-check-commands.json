{
  "commands": {
    "native-tests": [
      "cargo",
      "test",
      "--offline",
      "--locked",
      "--release",
      "-p",
      "chematic-mol"
    ],
    "clippy": [
      "cargo",
      "clippy",
      "--offline",
      "--locked",
      "--release",
      "-p",
      "chematic-mol",
      "--all-targets",
      "--",
      "-D",
      "warnings"
    ],
    "format": [
      "cargo",
      "fmt",
      "--all",
      "--",
      "--check"
    ],
    "refactor": [
      "python3",
      "scripts/check_refactor_budget.py"
    ],
    "runner-tests": [
      "/private/tmp/chematic-ring-frontier-env-20261016/bin/python",
      "-m",
      "pytest",
      "-q",
      "-p",
      "no:cacheprovider",
      "scripts/tests/test_bench_openbabel_sdf_throughput.py",
      "scripts/tests/test_bench_openbabel_v3000_throughput.py"
    ]
  },
  "env": {
    "CARGO_TARGET_DIR": "/private/tmp/chematic-v3000-record-stream-test-target-20261016",
    "CARGO_BUILD_JOBS": "1",
    "CARGO_INCREMENTAL": "0",
    "CARGO_PROFILE_RELEASE_LTO": "false",
    "CARGO_PROFILE_RELEASE_CODEGEN_UNITS": "16",
    "CARGO_PROFILE_RELEASE_STRIP": "none"
  }
}
