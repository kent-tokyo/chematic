+            for bit in 0..size {
+                if bit % 7 == 0 || bit == size - 1 {
+                    bits.set(bit);
+                }
+            }
+            let packed = bits.to_le_bytes();
+            assert_eq!(packed.len(), size.div_ceil(8));
+            for bit in 0..packed.len() * 8 {
+                assert_eq!(
+                    (packed[bit / 8] >> (bit % 8)) & 1 != 0,
+                    bit < size && bits.get(bit),
+                    "size={size}, bit={bit}",
+                );
+            }
+        }
