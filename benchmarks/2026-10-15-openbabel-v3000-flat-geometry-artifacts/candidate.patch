+//! Exact differential oracle and recipe provenance: see the flat-geometry
+//! manifest under validation/benchmark_corpora.
+use super::*;
+
+const Z_EPS: f64 = 1e-4;
+const COPLANAR_EPS: f64 = 1e-2;
+const COLLINEAR_EPS: f64 = 1e-6;
+
+fn reference_geometry_rank(points: &[Point3]) -> GeometryRank {
+    if points.is_empty() {
+        return GeometryRank::Indeterminate;
+    }
+    if points.iter().all(|p| p.z.abs() < Z_EPS) {
+        return GeometryRank::FlatZero;
+    }
+    if points.len() < 3 {
+        return GeometryRank::Coplanar;
+    }
+    // Find a non-degenerate plane-defining pair of vectors from point 0.
+    // ponytail: fixing the origin at point 0 makes this O(n) instead of
+    // O(n^3); it misses only the vanishingly rare pathological case where
+    // point 0 is collinear with every other point yet some other, unrelated
+    // triple isn't -- not worth a full O(n^3) search for real molecular
+    // input up to `MAX_ATOMS`.
+    let origin = points[0];
+    let mut normal: Option<Point3> = None;
+    'outer: for (j, pj) in points.iter().enumerate().skip(1) {
+        let v1 = pj.sub(&origin);
+        for pk in points.iter().skip(j + 1) {
+            let v2 = pk.sub(&origin);
+            let n = v1.cross(&v2);
+            if n.norm() > COLLINEAR_EPS {
+                normal = Some(n);
+                break 'outer;
+            }
+        }
+    }
+    let Some(n) = normal else {
+        // Every point is collinear with point 0 -- trivially coplanar.
+        return GeometryRank::Coplanar;
+    };
+    let n = n.normalize();
+    let max_dev = points
+        .iter()
+        .map(|p| p.sub(&origin).dot(&n).abs())
+        .fold(0.0_f64, f64::max);
+    if max_dev < COPLANAR_EPS {
+        GeometryRank::Coplanar
+    } else {
+        GeometryRank::ThreeD
+    }
+}
+
+fn reference_v3000_geometry(
+    mol: &mut Molecule,
+    coords: &[(f64, f64)],
+    raw_z: &[f64],
+    dimension: CoordinateDimension,
+) -> (
+    Option<Coords3D>,
+    GeometryRank,
+    Vec<Stereo3DDiagnostic>,
+    Vec<crate::mol2000::SquarePlanarPerceptionDiagnostic>,
+) {
+    let points = coords
+        .iter()
+        .zip(raw_z)
+        .map(|(&(x, y), &z)| Point3::new(x, y, z))
+        .collect::<Vec<_>>();
+    let rank = reference_geometry_rank(&points);
+    let conformer = matches!(rank, GeometryRank::Coplanar | GeometryRank::ThreeD)
+        .then_some(Coords3D { points });
+    let mut diagnostics = match (dimension, rank) {
+        (CoordinateDimension::TwoD, GeometryRank::Coplanar | GeometryRank::ThreeD) => {
+            vec![Stereo3DDiagnostic::DeclaredTwoDButNonzeroZ { observed: rank }]
+        }
+        (CoordinateDimension::ThreeD, GeometryRank::FlatZero | GeometryRank::Coplanar) => {
+            vec![Stereo3DDiagnostic::DeclaredThreeDButFlat { observed: rank }]
+        }
+        _ => Vec::new(),
+    };
+    let square_planar = conformer.as_ref().map_or_else(Vec::new, |coords| {
+        let perceived = crate::mol2000::perceive_square_planar_from_3d(mol, coords);
+        diagnostics.extend(crate::mol2000::wedge_vs_3d_conflicts(mol, coords));
+        perceived
+    });
+    (conformer, rank, diagnostics, square_planar)
+}
+
+fn z_values() -> Vec<f64> {
+    let recipe: serde_json::Value = serde_json::from_str(include_str!(concat!(
+        env!("CARGO_MANIFEST_DIR"),
+        "/../../validation/benchmark_corpora/flat-geometry-speed-v1.recipe.json"
+    )))
+    .unwrap();
+    recipe["z_f64_bits_hex"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .map(|value| f64::from_bits(u64::from_str_radix(value.as_str().unwrap(), 16).unwrap()))
+        .collect()
+}
+
+fn compare(input: &Molecule, coords: &[(f64, f64)], z: &[f64], dimension: CoordinateDimension) {
+    let mut expected_mol = input.clone();
+    let mut actual_mol = input.clone();
+    let expected = reference_v3000_geometry(&mut expected_mol, coords, z, dimension);
+    let actual = v3000_geometry(&mut actual_mol, coords, z, dimension);
+    assert_eq!(format!("{expected:?}"), format!("{actual:?}"));
+    let bits = |conformer: &Option<Coords3D>| {
+        conformer.as_ref().map(|c| {
+            c.points
+                .iter()
+                .map(|p| [p.x.to_bits(), p.y.to_bits(), p.z.to_bits()])
+                .collect::<Vec<_>>()
+        })
+    };
+    assert_eq!(bits(&expected.0), bits(&actual.0));
+    assert_eq!(
+        expected_mol.atoms().collect::<Vec<_>>(),
+        actual_mol.atoms().collect::<Vec<_>>()
+    );
+    assert_eq!(
+        expected_mol.bonds().collect::<Vec<_>>(),
+        actual_mol.bonds().collect::<Vec<_>>()
+    );
+    let points: Vec<_> = coords
+        .iter()
+        .zip(z)
+        .map(|(&(x, y), &z)| Point3::new(x, y, z))
+        .collect();
+    assert_eq!(
+        reference_geometry_rank(&points),
+        crate::mol2000::classify_geometry_rank(&points)
+    );
+}
+
+#[test]
+fn empty_truncated_threshold_and_nonfinite_channels_match_original() {
+    let empty = MoleculeBuilder::new().build();
+    let values = z_values();
+    for xy_count in 0..=6 {
+        let coords: Vec<_> = (0..xy_count).map(|i| (i as f64, (i % 2) as f64)).collect();
+        for z_count in 0..=6 {
+            for offset in 0..values.len() {
+                let z: Vec<_> = (0..z_count)
+                    .map(|i| values[(i + offset) % values.len()])
+                    .collect();
+                for dimension in [
+                    CoordinateDimension::Unknown,
+                    CoordinateDimension::TwoD,
+                    CoordinateDimension::ThreeD,
+                ] {
+                    compare(&empty, &coords, &z, dimension);
+                }
+            }
+        }
+    }
+}
+
+#[test]
+fn fixed_ten_thousand_graph_annotations_and_geometry_match_original() {
+    let corpus = include_str!(concat!(
+        env!("CARGO_MANIFEST_DIR"),
+        "/../../validation/benchmark_corpora/rdkit-js-browser-10k-v1.smi"
+    ));
+    let values = z_values();
+    let mut rows = 0;
+    for line in corpus.lines().filter(|line| !line.trim().is_empty()) {
+        let mol = chematic_smiles::parse_template(line.split_whitespace().next().unwrap()).unwrap();
+        let coords: Vec<_> = (0..mol.atom_count())
+            .map(|i| (i as f64, (i % 2) as f64))
+            .collect();
+        for value in &values[..10] {
+            let z = vec![*value; mol.atom_count()];
+            for dimension in [
+                CoordinateDimension::Unknown,
+                CoordinateDimension::TwoD,
+                CoordinateDimension::ThreeD,
+            ] {
+                compare(&mol, &coords, &z, dimension);
+            }
+        }
+        rows += 1;
+    }
+    assert_eq!(rows, 10000);
+}
